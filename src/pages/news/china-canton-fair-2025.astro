---
/*
  PAGE  : /news/china-canton-fair-2025
  FILE  : src/pages/news/china-canton-fair-2025.astro
  ROLE  : 新闻详情页 — china Canton Fair 2025
*/
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import {
  getRelatedNews,
  formatNewsDate,
  toNewsISO,
  newsList,
} from "../../data/news-list";

import expoPhoto from "../../assets/news/china-canton-fair-2025.jpg";

/* 从列表数据取当前文章元数据 */
