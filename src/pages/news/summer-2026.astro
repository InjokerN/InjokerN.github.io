---
/*
  PAGE  : /news/summer-2026
  FILE  : src/pages/news/summer-2026.astro
  ROLE  : 新闻详情页 — Summer of 2026 Fan Badge Program
*/
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import {
  getRelatedNews,
  formatNewsDate,
  toNewsISO,
  newsList,
} from "../../data/news-list";

import summerPhoto2 from "../../assets/news/summer-2026-02.jpg";

/* 从列表数据取当前文章元数据 */
const meta = newsList.find((item) => item.slug === "summer-2026")!;

const relatedNews = getRelatedNews("summer-2026", 2);
---

<BaseLayout
  title={`${meta.title} — MetalCrafts`}
  description={meta.excerpt}
  ogImage={meta.cover.src}
>
  <main class="news-detail">

    <!-- Hero -->
    <section class="news-detail__hero">
      <div class="news-detail__container">
        <div class="news-detail__hero-grid">

          <div class="news-detail__hero-copy">
            <p class="news-detail__hero-kicker">NEWS / PRODUCTION STORY</p>

            <h1 class="news-detail__title">{meta.title}</h1>

            <p class="news-detail__excerpt">{meta.excerpt}</p>

            <div class="news-detail__meta">
              <time datetime={toNewsISO(meta.date)}>
                {formatNewsDate(meta.date)}
              </time>

              <span aria-hidden="true">/</span>

              <span>CM CRAFTS</span>
            </div>
          </div>

          <div class="news-detail__hero-media">
            <Image
              src={meta.cover}
              alt={meta.alt}
              loading="eager"
              widths={[900, 1200, 1600, 2000]}
              sizes="(max-width: 900px) 100vw, 55vw"
            />
          </div>

        </div>
      </div>
    </section>


    <!-- Article -->
    <section class="news-detail__body">
      <div class="news-detail__container">

        <div class="news-detail__reading-layout">

          <!-- TOC 侧栏 -->
          <aside class="article-toc" aria-label="Article contents">
            <div class="article-toc__inner">

              <div class="article-toc__label">IN THIS STORY</div>

              <nav class="article-toc__nav">
                <a
                  href="#custom-pieces"
                  class="article-toc__link"
                  data-toc-link="custom-pieces"
                >
                  <span class="article-toc__number">01</span>
                  <span class="article-toc__text">A summer of custom pieces</span>
                </a>

                <a
                  href="#more-than-a-badge"
                  class="article-toc__link"
                  data-toc-link="more-than-a-badge"
                >
                  <span class="article-toc__number">02</span>
                  <span class="article-toc__text">More than just a badge</span>
                </a>

                <a
                  href="#color-challenge"
                  class="article-toc__link"
                  data-toc-link="color-challenge"
                >
                  <span class="article-toc__number">03</span>
                  <span class="article-toc__text">The color challenge</span>
                </a>

                <a
                  href="#quality-delivery"
                  class="article-toc__link"
                  data-toc-link="quality-delivery"
                >
                  <span class="article-toc__number">04</span>
                  <span class="article-toc__text">Quality and delivery</span>
                </a>

                <a
                  href="#whats-next"
                  class="article-toc__link"
                  data-toc-link="whats-next"
                >
                  <span class="article-toc__number">05</span>
                  <span class="article-toc__text">What's next</span>
                </a>
              </nav>

            </div>
          </aside>


          <!-- 正文 -->
          <article class="news-detail__content">

            <!-- Lead -->
            <p class="article-lead">
              In the summer of 2026, football belonged to North America —
              and to the entire world.
            </p>

            <p>
              For the first time, three nations co-hosted the tournament:
              48 teams, 104 matches, stretching from Mexico City to New York,
              Vancouver to Miami. But for our workshop, that unforgettable
              summer began quietly — arriving one inquiry at a time in our
              inbox.
            </p>


            <!-- 客户原声 -->
            <blockquote class="article-quote">
              "Can you match the exact sky-blue and white for an Argentina
              enamel pin? Our supporters' club wants to hand them out in
              the stands."
            </blockquote>

            <blockquote class="article-quote">
              "We need 3,000 vintage-finish commemorative coins. The team
              colors must be spot-on — can we make the group stage kickoff?"
            </blockquote>

            <blockquote class="article-quote">
              "Our sports bar is opening right as the knockout rounds start.
              How fast can we rush an order of soft PVC keychains for
              giveaways?"
            </blockquote>


            <!-- 01 -->
            <section
              id="custom-pieces"
              class="article-section"
              data-article-section="custom-pieces"
            >
              <h2>A summer of custom pieces</h2>

              <p>
                Between June and August, more than
                <strong>50,000</strong> custom lapel pins, commemorative
                coins, and rubber keychains left our benches, heading to
                supporters across North America, Europe, and Latin America.
              </p>

              <p>
                Our clients included official fan clubs, sports lounges,
                streetwear brands, and local watch-party organizers. Their
                projects were completely different, but at their core, they
                were all chasing the same thing: giving people a way to
                remember this summer, and a tangible badge of where they
                belong.
              </p>
            </section>


            <!-- 02 -->
            <section
              id="more-than-a-badge"
              class="article-section"
              data-article-section="more-than-a-badge"
            >
              <h2>More than just a badge</h2>

              <p>
                That is the real magic of a tournament like this. On the
                pitch, it's 90 minutes of athletic competition. In the
                stands and in front of television screens, it's about
                identity. A jersey, a scarf, or a small stamped metal badge
                all declare the exact same thing:
                "I stand with them."
              </p>

              <p>
                Across those three months, we brought over
                <strong>100 distinct designs</strong> to life. Some were
                minimalist and restrained — just a crisp team color and a
                year on polished enamel. Others were bold and intricate,
                featuring deep antique 3D relief on heavy cast zinc alloy.
                Then came thousands of soft PVC keychains: lightweight and
                cost-effective for packed bar venues, yet crafted without
                compromising on color fidelity.
              </p>
            </section>


            <!-- Panorama image -->
            <figure class="article-panorama">
              <Image
                src={summerPhoto2}
                alt="Close-up details of custom fan badges and metal pieces"
                widths={[1200, 1600, 2000]}
                sizes="(max-width: 900px) 100vw, 900px"
              />

              <figcaption>
                Summer 2026 · Custom pieces in production
              </figcaption>
            </figure>


            <!-- 03 -->
            <section
              id="color-challenge"
              class="article-section"
              data-article-section="color-challenge"
            >
              <h2>The color challenge</h2>

              <p>
                Which points to the single most underestimated technical
                challenge in custom memorabilia: color.
              </p>

              <p>
                A team's color isn't just "blue" or "red." It is a specific
                Pantone code. It is an immediate visual identity that fans
                recognize in half a second. Much of our summer was spent
                mixing enamels, proofing swatches, checking under calibrated
                light, and re-sampling until it was undeniably right.
              </p>
            </section>


            <!-- 04 -->
            <section
              id="quality-delivery"
              class="article-section"
              data-article-section="quality-delivery"
            >
              <h2>Quality and delivery</h2>

              <p>
                Before packaging, every single item underwent individual
                hand inspection. Not random batch sampling — every single
                piece. Not one shipment missed a match kickoff. Not a single
                order was returned for a color mismatch.
              </p>
            </section>


            <!-- 05 -->
            <section
              id="whats-next"
              class="article-section"
              data-article-section="whats-next"
            >
              <h2>What's next</h2>

              <p>
                The final whistle has blown on the tournament, but our
                workshop hasn't slowed down. Marathon season has arrived,
                corporate anniversary projects are filling the queue, and
                holiday gift production is already in motion. The tooling is
                ready, our team is warmed up, and just like this past summer,
                we are ready to build.
              </p>

              <p>
                If you are planning your next custom project — whether for a
                global tournament or a local milestone — you don't have to
                wait for the next kickoff. Even if you only have a rough
                napkin sketch, a Pantone reference, or just a loose concept,
                send it over to
                <a href="mailto:daniel.imaginef@gmail.com">
                  daniel.imaginef@gmail.com
                </a>.
              </p>

              <p>
                We will reply within 24 hours with transparent factory
                pricing and honest production advice. Flexible MOQs for
                small test runs, dependable lead times, and rush
                accommodation whenever physically possible. No aggressive
                sales pressure, and no empty promises.
              </p>

              <p>
                We craft items people genuinely want to keep. This summer,
                they were pinned to jerseys in crowded stadiums, handed out
                at pub entrances, and carried home in suitcases across
                different time zones.
              </p>

              <p class="article-ending">
                In our next production story, there might just be one of
                yours.
              </p>
            </section>

          </article>

        </div>
      </div>
    </section>


    <!-- Related -->
    {relatedNews.length > 0 && (
      <section class="news-detail__related">
        <div class="news-detail__container">

          <div class="news-detail__related-header">
            <p class="news-detail__related-eyebrow">MORE FROM METALCRAFTS</p>

            <a href="/news" class="news-detail__related-all">
              All News <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="news-detail__related-list">
            {relatedNews.map((item, index) => (
              <a
                href={`/news/${item.slug}`}
                class="news-detail__related-item"
              >
                <span class="news-detail__related-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div class="news-detail__related-media">
                  <Image
                    src={item.cover}
                    alt={item.alt}
                    loading="lazy"
                    widths={[300, 450, 600]}
                    sizes="180px"
                  />
                </div>

                <div class="news-detail__related-body">
                  <div class="news-detail__related-meta">
                    <time datetime={toNewsISO(item.date)}>
                      {formatNewsDate(item.date)}
                    </time>

                    <span aria-hidden="true">/</span>

                    <span>CM CRAFTS</span>
                  </div>

                  <h2 class="news-detail__related-title">{item.title}</h2>
                </div>

                <span class="news-detail__related-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))}
          </div>

        </div>
      </section>
    )}

  </main>
</BaseLayout>


<!-- TOC 交互 -->
<script>
  type NewsWindow = Window & {
    __metalNewsDetailCleanup?: () => void;
  };

  function initNewsDetail() {
    const root = document.querySelector<HTMLElement>(".news-detail");
    const nav = document.querySelector<HTMLElement>(".nav");
    const toc = document.querySelector<HTMLElement>(".article-toc");

    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    );

    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("[data-article-section]")
    );

    if (!root || !nav || !toc || !tocLinks.length || !sections.length) return;

    const win = window as NewsWindow;
    win.__metalNewsDetailCleanup?.();

    const syncNavHeight = () => {
      root.style.setProperty(
        "--nav-height",
        `${nav.getBoundingClientRect().height}px`
      );
    };

    const setActive = (id: string) => {
      tocLinks.forEach((link) => {
        const isActive = link.dataset.tocLink === id;
        link.classList.toggle("is-active", isActive);

        if (isActive) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const handleLinkClick = (event: MouseEvent) => {
      const link = event.currentTarget as HTMLAnchorElement;
      const id = link.dataset.tocLink;
      if (!id) return;

      const target = document.getElementById(id);
      if (!target) return;

      event.preventDefault();

      const navHeight = nav.getBoundingClientRect().height;
      const targetTop =
        target.getBoundingClientRect().top + window.scrollY - navHeight - 28;

      window.scrollTo({ top: targetTop, behavior: "smooth" });

      history.replaceState(null, "", `#${id}`);
      setActive(id);
    };

    tocLinks.forEach((link) => {
      link.addEventListener("click", handleLinkClick);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (a, b) => a.boundingClientRect.top - b.boundingClientRect.top
          );

        if (!visible.length) return;

        const activeId = (visible[0].target as HTMLElement).dataset
          .articleSection;

        if (activeId) setActive(activeId);
      },
      {
        root: null,
        rootMargin: `-${nav.getBoundingClientRect().height + 48}px 0px -62% 0px`,
        threshold: 0,
      }
    );

    sections.forEach((section) => observer.observe(section));

    syncNavHeight();

    const resizeObserver = new ResizeObserver(() => syncNavHeight());
    resizeObserver.observe(nav);

    const handleResize = () => syncNavHeight();
    window.addEventListener("resize", handleResize);

    const hash = window.location.hash.replace("#", "");
    if (hash && sections.some((section) => section.id === hash)) {
      setActive(hash);
    } else {
      setActive(sections[0]?.id ?? "");
    }

    win.__metalNewsDetailCleanup = () => {
      tocLinks.forEach((link) => {
        link.removeEventListener("click", handleLinkClick);
      });
      observer.disconnect();
      resizeObserver.disconnect();
      window.removeEventListener("resize", handleResize);
      win.__metalNewsDetailCleanup = undefined;
    };
  }

  initNewsDetail();
  document.addEventListener("astro:page-load", initNewsDetail);
</script>


<style>
/* ============================================================
   FONT — 试装阶段，确定后改自托管
   ============================================================ */
@import url(
  "https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,400italic;8..60,500;8..60,500italic;8..60,600&display=swap"
);


/* ============================================================
   PAGE TOKENS
   ============================================================ */
.news-detail {
  --paper: #f6f3ec;
  --paper-soft: #fbfaf7;

  --ink: #1b1a18;
  --muted: #706b63;
  --muted-soft: #8b8479;

  --line: #ded9cf;
  --line-soft: #e8e3da;

  --gold: #ae8d5a;

  --font-serif: "Source Serif 4", Georgia, "Times New Roman", serif;

  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

.news-detail *,
.news-detail *::before,
.news-detail *::after {
  box-sizing: border-box;
}

.news-detail__container {
  width: min(1380px, 94vw);
  margin: 0 auto;
}


/* ============================================================
   HERO
   ============================================================ */
.news-detail__hero {
  padding: calc(var(--nav-height, 72px) + 76px) 0 96px;
}

.news-detail__hero-grid {
  display: grid;
  grid-template-columns: minmax(300px, 0.8fr) minmax(0, 1fr);
  gap: clamp(56px, 6vw, 82px);
  align-items: center;
  width: min(1240px, 100%);
  margin: 0 auto;
}

.news-detail__hero-copy {
  max-width: 670px;
}

.news-detail__hero-kicker {
  margin: 0 0 22px;
  color: var(--gold);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.news-detail__title {
  margin: 0;
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: clamp(40px, 4.6vw, 66px);
  font-weight: 500;
  line-height: 1.02;
  letter-spacing: -0.03em;
}

.news-detail__excerpt {
  max-width: 610px;
  margin: 28px 0 0;
  color: var(--muted);
  font-family: var(--font-serif);
  font-size: 19px;
  line-height: 1.62;
}

.news-detail__meta {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 30px;
  color: var(--muted-soft);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.news-detail__hero-media {
  position: relative;
  overflow: hidden;
  width: 100%;
  aspect-ratio: 3 / 2;
  background: var(--paper-soft);
}

.news-detail__hero-media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.news-detail__hero-media:hover img {
  transform: scale(1.012);
}


/* ============================================================
   ARTICLE LAYOUT — 200 TOC + 900 正文，整体居中
   ============================================================ */
.news-detail__body {
  padding: 76px 0 112px;
}

.news-detail__reading-layout {
  display: grid;
  /* 原来是 200px 900px —— 现在 TOC 在 200~260px 之间自适应 */
  grid-template-columns: minmax(200px, 260px) 900px;
  justify-content: center;
  gap: clamp(56px, 6vw, 82px);
  width: min(1240px, 100%);
  margin: 0 auto;
  align-items: start;
}


/* ============================================================
   TOC
   ============================================================ */
.article-toc {
  position: sticky;
  top: calc(var(--nav-height, 72px) + 36px);
  align-self: start;
  padding-top: 4px;
}

.article-toc__label {
  margin-bottom: 22px;
  color: var(--ink);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.article-toc__nav {
  position: relative;
  display: grid;
  gap: 1px;
}

.article-toc__nav::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 1px;
  background: var(--line-soft);
}

.article-toc__link {
  position: relative;
  display: grid;
  grid-template-columns: 30px minmax(0, 1fr);
  gap: 12px;
  padding: 12px 0 12px 18px;
  color: var(--muted);
  font-family: var(--font-serif);
  font-size: 17px;
  line-height: 1.45;
  text-decoration: none;
  transition: color 0.25s ease, padding-left 0.25s ease;
}

.article-toc__number {
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  opacity: 0.85;
  transition: color 0.25s ease, opacity 0.25s ease;
}

.article-toc__text {
  min-width: 0;
}

.article-toc__link:hover {
  color: var(--ink);
  padding-left: 18px;
}

.article-toc__link.is-active {
  color: var(--ink);
  padding-left: 18px;
}

.article-toc__link.is-active::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 2px;
  background: var(--gold);
}

.article-toc__link.is-active .article-toc__number {
  color: var(--gold);
  opacity: 1;
}


/* ============================================================
   CONTENT — 正文
   ============================================================ */
.news-detail__content {
  min-width: 0;
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: 19px;
  line-height: 1.72;
  font-weight: 400;
}

.news-detail__content p {
  margin: 0 0 26px;
}

.news-detail__content h2 {
  scroll-margin-top: calc(var(--nav-height, 72px) + 32px);
}


/* Lead */
.article-lead {
  margin-bottom: 30px !important;
  color: var(--ink);
  font-size: 25px;
  font-style: italic;
  line-height: 1.5;
  letter-spacing: -0.005em;
}


/* Quotes */
.article-quote {
  margin: 40px 0;
  padding: 0 0 0 24px;
  border-left: 1px solid var(--gold);
  color: var(--muted);
  font-size: 18px;
  font-style: italic;
  line-height: 1.65;
}

.article-quote + .article-quote {
  margin-top: 30px;
}


/* Sections */
.article-section {
  scroll-margin-top: calc(var(--nav-height, 72px) + 34px);
}

.article-section + .article-section {
  margin-top: 76px;
}

.article-section h2 {
  margin: 0 0 25px;
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: clamp(28px, 3vw, 36px);
  font-weight: 500;
  line-height: 1.15;
  letter-spacing: -0.022em;
}

.article-section h2::after {
  content: "";
  display: block;
  width: 34px;
  height: 1px;
  margin-top: 18px;
  background: var(--gold);
}


/* Panorama */
.article-panorama {
  width: 100%;
  max-width: 900px;
  margin: 68px 0 76px;
}

.article-panorama img {
  display: block;
  width: 100%;
  height: auto;
}

.article-panorama figcaption {
  margin-top: 12px;
  color: var(--muted-soft);
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}


/* Inline */
.news-detail__content strong {
  color: var(--ink);
  font-weight: 600;
}

.news-detail__content a {
  color: var(--gold);
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
  transition: color 0.2s ease;
}

.news-detail__content a:hover {
  color: var(--ink);
}


/* Ending */
.article-ending {
  margin-top: 48px !important;
  padding-top: 30px;
  border-top: 1px solid var(--line);
  font-size: 22px;
  font-style: italic;
  line-height: 1.55;
}


/* ============================================================
   RELATED
   ============================================================ */
.news-detail__related {
  padding: 70px 0 88px;
  border-top: 1px solid var(--line);
}

.news-detail__related-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 26px;
  width: min(1240px, 100%);
  margin-left: auto;
  margin-right: auto;
}

.news-detail__related-eyebrow {
  margin: 0;
  color: var(--gold);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.news-detail__related-all {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: var(--ink);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.11em;
  text-decoration: none;
  text-transform: uppercase;
  transition: color 0.25s ease, gap 0.25s ease;
}

.news-detail__related-all:hover {
  gap: 14px;
  color: var(--gold);
}

.news-detail__related-all span {
  color: var(--gold);
  font-size: 15px;
}

.news-detail__related-list {
  width: min(1240px, 100%);
  margin: 0 auto;
  border-top: 1px solid var(--line);
}

.news-detail__related-item {
  display: grid;
  grid-template-columns: 42px 180px minmax(0, 1fr) 32px;
  gap: 24px;
  align-items: center;
  min-height: 154px;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
  color: inherit;
  text-decoration: none;
  transition: padding 0.25s ease;
}

.news-detail__related-item:hover {
  padding-left: 8px;
}

.news-detail__related-index {
