---
/*
  PAGE  : /news
  FILE  : src/pages/news/index.astro
  ROLE  : 新闻列表页 — 主推故事、最新动态、全部更新与 CTA
*/
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import {
  sortedNewsList,
  formatNewsDate,
  toNewsISO,
} from "../../data/news-list";

const featuredNews = sortedNewsList[0];
const latestNews = sortedNewsList.slice(1, 5);
const archiveNews = sortedNewsList.slice(5);
---

<BaseLayout
  title="News & Updates — CM Crafts & Gifts"
  description="Project stories, exhibitions and workshop updates from CM Crafts & Gifts — from community commissions to the Canton Fair."
>
  <main class="news-page">
    <section class="news-hero">
      <div class="news-container">
        <div class="news-hero__inner">
          <p class="news-hero__eyebrow">NEWSROOM</p>

          <h1 class="news-hero__title">
            What's happening
            <br />
            <em>at CM Crafts &amp; Gifts.</em>
          </h1>

          <p class="news-hero__subtitle">
            Company news, exhibitions, manufacturing updates and stories from
            our workshop.
          </p>
        </div>
      </div>
    </section>

    {featuredNews && (
      <section class="news-section">
        <div class="news-container">
          <p class="news-eyebrow">FEATURED STORY</p>

          <a href={`/news/${featuredNews.slug}`} class="featured-story">
            <div class="featured-story__media">
              <Image
                src={featuredNews.cover}
                alt={featuredNews.alt}
                loading="eager"
                widths={[800, 1200, 1600]}
                sizes="(max-width: 1024px) 100vw, 55vw"
              />
            </div>

            <div class="featured-story__body">
              <div class="news-meta">
                <time datetime={toNewsISO(featuredNews.date)}>
                  {formatNewsDate(featuredNews.date)}
                </time>
              </div>

              <h2 class="featured-story__title">{featuredNews.title}</h2>

              <p class="featured-story__excerpt">{featuredNews.excerpt}</p>

              <span class="news-cta-link">
                Read story
                <span aria-hidden="true">↗</span>
              </span>
            </div>
          </a>
        </div>
      </section>
    )}

    {latestNews.length > 0 && (
      <section class="news-section">
        <div class="news-container">
          <p class="news-eyebrow">LATEST UPDATES</p>

          <h2 class="news-section-title">
            Recent from
            <br />
            the workshop.
          </h2>

          <div class="news-grid">
            {latestNews.map((entry) => (
              <a href={`/news/${entry.slug}`} class="news-card">
                <div class="news-card__media">
                  <Image
                    src={entry.cover}
                    alt={entry.alt}
                    loading="lazy"
                    widths={[600, 900, 1200]}
                    sizes="(max-width: 1024px) 100vw, 45vw"
                  />
                </div>

                <div class="news-card__body">
                  <div class="news-meta">
                    <time datetime={toNewsISO(entry.date)}>
                      {formatNewsDate(entry.date)}
                    </time>
                  </div>

                  <h3 class="news-card__title">{entry.title}</h3>
                  <p class="news-card__excerpt">{entry.excerpt}</p>

                  <span class="news-cta-link">
                    Read story
                    <span aria-hidden="true">↗</span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {archiveNews.length > 0 && (
      <section class="news-section">
        <div class="news-container">
          <p class="news-eyebrow">ALL UPDATES</p>

          <h2 class="news-section-title">Archive.</h2>

          <div class="news-archive">
            {archiveNews.map((entry) => (
              <a href={`/news/${entry.slug}`} class="news-archive__item">
                <time datetime={toNewsISO(entry.date)}>
                  {formatNewsDate(entry.date)}
                </time>

                <h3>{entry.title}</h3>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="site-cta">
      <div class="site-cta__circle" aria-hidden="true"></div>

      <div class="site-cta__inner">
        <p class="site-cta__eyebrow">PLANNING SOMETHING SIMILAR?</p>

        <h2>
          Let's build
          <br />
          the next one together.
        </h2>

        <p class="site-cta__desc">
          If a recent project looks close to what you need, tell us. We'll share
          what's possible for your timeline, budget and quantity.
        </p>

        <a
          href="#contact"
          class="cta-button"
          data-modal-open
          data-modal-product="News page"
        >
          Start a Similar Project
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .news-page {
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }

  .news-page *,
  .news-page *::before,
  .news-page *::after {
    box-sizing: border-box;
  }

  .news-container {
    width: var(--container-width);
    margin: 0 auto;
  }

  .news-eyebrow {
    margin: 0 0 10px;
    color: var(--color-gold-dark);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .news-section-title {
    margin: 0 0 40px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .news-section {
    padding: 54px 0;
    border-top: 1px solid var(--color-line);
  }

  .news-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .news-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      color var(--ease-out),
      gap var(--ease-out);
  }

  .news-cta-link span {
    color: var(--color-gold);
    font-size: 15px;
  }

  a:hover .news-cta-link {
    color: var(--color-gold);
    gap: 16px;
  }

  /* ---------- HERO ---------- */
  .news-hero {
    padding: calc(var(--nav-h) + var(--hero-gap)) 0 96px;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-paper);
    text-align: center;
  }

  .news-hero__inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .news-hero__eyebrow {
    margin: 0 0 24px;
    color: var(--color-gold);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .news-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(44px, 5vw, 72px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }

  .news-hero__title em {
    color: var(--color-gold);
    font-style: normal;
  }

  .news-hero__subtitle {
    max-width: 620px;
    margin: 30px auto 0;
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  /* ---------- FEATURED STORY ---------- */
  .featured-story {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 48px;
    align-items: stretch;
    text-decoration: none;
    color: inherit;
  }

  .featured-story__media {
    position: relative;
    aspect-ratio: 1.25 / 1;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }

  .featured-story__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--ease-slow);
  }

  .featured-story:hover .featured-story__media img {
    transform: scale(1.03);
  }

  .featured-story__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 15px 0;
  }

  .featured-story__title {
    margin: 20px 0 18px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(26px, 2.4vw, 32px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .featured-story__excerpt {
    max-width: 440px;
    margin: 0 0 26px;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  /* ---------- LATEST UPDATES ---------- */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px 32px;
  }

  .news-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform var(--ease-out);
  }

  .news-card:hover {
    transform: translateY(-4px);
  }

  .news-card__media {
    position: relative;
    aspect-ratio: 1.45 / 1;
    overflow: hidden;
    margin-bottom: 20px;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }

  .news-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--ease-slow);
  }

  .news-card:hover .news-card__media img {
    transform: scale(1.03);
  }

  .news-card__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .news-card__title {
    margin: 14px 0 9px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .news-card__excerpt {
    max-width: 500px;
    margin: 0 0 18px;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---------- ARCHIVE ---------- */
  .news-archive {
    border-top: 1px solid var(--color-line);
  }

  .news-archive__item {
    display: grid;
    grid-template-columns: 150px 1fr 40px;
    gap: 35px;
    align-items: center;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
    transition: padding var(--ease-out);
  }

  .news-archive__item time {
    color: var(--color-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .news-archive__item h3 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .news-archive__item > span {
    justify-self: end;
    color: var(--color-muted);
    font-size: 18px;
    transition:
      transform var(--ease-out),
      color var(--ease-out);
  }

  .news-archive__item:hover {
    padding-left: 10px;
    padding-right: 10px;
  }

  .news-archive__item:hover > span {
    color: var(--color-gold);
    transform: translate(3px, -3px);
  }

  /* ---------- CTA ---------- */
  .site-cta {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 78px 6%;
    min-height: 500px;
    background: var(--color-ink-deep);
    color: var(--color-cream);
    overflow: hidden;
  }

  .site-cta::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 42px;
    height: 1px;
    background: var(--color-gold);
    transform: translateX(-50%);
  }

  .site-cta__circle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 480px;
    height: 480px;
    border: 1px solid rgba(174, 141, 90, 0.18);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .site-cta__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    text-align: center;
  }

  .site-cta__eyebrow {
    margin: 0 0 20px;
    color: var(--color-gold-soft);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .site-cta h2 {
    margin: 0 0 22px;
    color: var(--color-cream);
    font-family: var(--font-display);
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .site-cta__desc {
    max-width: 570px;
    margin: 0 auto 30px;
    color: var(--color-cream-muted);
    font-size: 15px;
    line-height: 1.75;
  }

  .site-cta .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-width: 180px;
    padding: 15px 24px;
    background: var(--color-gold);
    color: var(--color-white);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 999px;
    transition:
      background var(--ease-out),
      color var(--ease-out),
      transform var(--ease-out);
  }

  .site-cta .cta-button:hover {
    background: var(--color-white);
    color: var(--color-ink);
    transform: translateY(-2px);
  }

  .site-cta .cta-button span {
    font-size: 17px;
    font-weight: 400;
  }

  /* ---------- 平板适配 ---------- */
  @media (max-width: 1024px) {
    .news-hero {
      padding-bottom: 80px;
      min-height: 440px;
    }

    .news-section {
      padding: 44px 0;
    }

    .featured-story {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .featured-story__media {
      aspect-ratio: 16 / 10;
    }

    .featured-story__body {
      padding-top: 0;
    }
  }

  /* ---------- 手机适配 ---------- */
  @media (max-width: 640px) {
    .news-container {
      width: calc(100% - 36px);
    }

    .news-hero {
      padding-bottom: 56px;
      min-height: 0;
    }

    .news-hero__title {
      font-size: clamp(36px, 10vw, 48px);
    }

    .news-hero__subtitle {
      margin-top: 22px;
      font-size: 15px;
    }

    .news-section {
      padding: 34px 0;
    }

    .news-section-title {
      margin-bottom: 28px;
      font-size: 32px;
    }

    .featured-story__media {
      aspect-ratio: 1.15 / 1;
    }

    .featured-story__title {
      font-size: 24px;
      margin: 16px 0 14px;
    }

    .news-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .news-card__title {
      font-size: 20px;
    }

    .news-archive__item {
      grid-template-columns: 100px 1fr 24px;
      gap: 16px;
      padding: 18px 0;
    }

    .news-archive__item h3 {
      font-size: 17px;
    }

    .site-cta {
      padding: 60px 20px;
    }

    .site-cta::after {
      width: 36px;
    }

    .site-cta__circle {
      width: 380px;
      height: 380px;
    }

    .site-cta h2 {
      font-size: 34px;
    }

    .site-cta__desc {
      font-size: 14px;
    }
  }
</style>
