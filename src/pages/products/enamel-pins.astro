<script>
  type EpinWindow = Window & {
    __epinSurfaceCleanup?: () => void;
    __epinFinishCleanup?: () => void;
  };

  /* ------------------------------------------------------------
     HERO SURFACE — 珐琅工艺互动带（截面切换）
     ------------------------------------------------------------ */

  function initEpinSurface() {
    const root = document.querySelector<HTMLElement>("[data-epin-surface]");
    if (!root) return;

    const win = window as EpinWindow;
    win.__epinSurfaceCleanup?.();

    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-epin-surface-tab]"),
    );
    const profiles = Array.from(
      root.querySelectorAll<HTMLElement>("[data-epin-surface-profile]"),
    );
    const noteEl = root.querySelector<HTMLElement>(
      "[data-epin-surface-note]",
    );
    const levelEl = root.querySelector<HTMLElement>(
      "[data-epin-surface-level]",
    );
    const titleEl = root.querySelector<HTMLElement>(
      "[data-epin-surface-title]",
    );
    const textEl = root.querySelector<HTMLElement>(
      "[data-epin-surface-text]",
    );

    if (!tabs.length || !profiles.length) return;

    let methods: {
      id: string;
      level: string;
      title: string;
      text: string;
      note: string;
    }[] = [];

    try {
      methods = JSON.parse(root.dataset.epinSurfaceViews ?? "[]");
    } catch {
      return;
    }

    if (!Array.isArray(methods) || methods.length === 0) return;

    const listeners: { el: HTMLButtonElement; handler: EventListener }[] = [];

    function activate(id: string) {
      const method = methods.find((item) => item.id === id);
      if (!method) return;

      tabs.forEach((tab) => {
        const active = tab.dataset.epinSurfaceTab === id;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-pressed", String(active));
      });

      profiles.forEach((profile) => {
        profile.classList.toggle(
          "is-active",
          profile.dataset.epinSurfaceProfile === id,
        );
      });

      if (noteEl) noteEl.textContent = method.note;
      if (levelEl) levelEl.textContent = method.level;
      if (titleEl) titleEl.textContent = method.title;
      if (textEl) textEl.textContent = method.text;
    }

    tabs.forEach((tab) => {
      const handler: EventListener = () => {
        const id = tab.dataset.epinSurfaceTab;
        if (id) activate(id);
      };

      tab.addEventListener("click", handler);
      listeners.push({ el: tab, handler });
    });

    win.__epinSurfaceCleanup = () => {
      listeners.forEach(({ el, handler }) =>
        el.removeEventListener("click", handler),
      );
      win.__epinSurfaceCleanup = undefined;
    };
  }

  /* ------------------------------------------------------------
     FINISH LIBRARY — 8 项特殊工艺切换
     ------------------------------------------------------------ */

  function initEpinFinish() {
    const root = document.querySelector<HTMLElement>("[data-epin-finish]");
    if (!root) return;

    const win = window as EpinWindow;
    win.__epinFinishCleanup?.();

    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-epin-finish-tab]"),
    );
    const images = Array.from(
      root.querySelectorAll<HTMLElement>("[data-epin-finish-img]"),
    );
    const badge = root.querySelector<HTMLElement>("[data-epin-finish-badge]");
    const nameEl = root.querySelector<HTMLElement>("[data-epin-finish-name]");
    const tagEl = root.querySelector<HTMLElement>("[data-epin-finish-tag]");
    const textEl = root.querySelector<HTMLElement>("[data-epin-finish-text]");

    if (!tabs.length || !images.length) return;

    let views: { key: string; name: string; tag: string; text: string }[] = [];

    try {
      views = JSON.parse(root.dataset.epinFinishViews ?? "[]");
    } catch {
      return;
    }

    if (!Array.isArray(views) || views.length === 0) return;

    const listeners: { el: HTMLButtonElement; handler: EventListener }[] = [];

    function activate(key: string) {
      const view = views.find((item) => item.key === key);
      if (!view) return;

      tabs.forEach((tab) => {
        const active = tab.dataset.epinFinishTab === key;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-pressed", String(active));
      });

      images.forEach((image) => {
        image.classList.toggle("is-active", image.dataset.epinFinishImg === key);
      });

      if (badge) badge.textContent = view.tag;
      if (nameEl) nameEl.textContent = view.name;
      if (tagEl) tagEl.textContent = view.tag;
      if (textEl) textEl.textContent = view.text;
    }

    tabs.forEach((tab) => {
      const handler: EventListener = () => {
        const key = tab.dataset.epinFinishTab;
        if (key) activate(key);
      };

      tab.addEventListener("click", handler);
      listeners.push({ el: tab, handler });
    });

    win.__epinFinishCleanup = () => {
      listeners.forEach(({ el, handler }) =>
        el.removeEventListener("click", handler),
      );
      win.__epinFinishCleanup = undefined;
    };
  }

  function initEpinPage() {
    initEpinSurface();
    initEpinFinish();
  }

  initEpinPage();

  document.addEventListener("astro:page-load", initEpinPage);
</script>
