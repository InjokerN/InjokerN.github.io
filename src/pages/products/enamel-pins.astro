---
import { Image } from "astro:assets";
import ProductDetailLayout from "../../components/ProductDetailLayout.astro";

import { manufacturingProcess } from "../../data/manufacturing-process";

/*
  ENAMEL PINS — PRODUCT DETAIL PAGE

  设计主线：Color, held in metal.
  珐琅徽章是 8 个品类里「收藏品属性」最强的——表面工艺、特殊效果、
  背部配件、零售背卡四个轴共同决定一枚徽章是被随手送掉还是被收藏。
  全页围绕买家四个问题展开：

  - 我的图能变成徽章吗？→ II 三列截面对比（软 / 硬 / 印刷）
  - 怎么做得值得收藏？→ III 特殊工艺切换廊（8 项）
  - 怎么佩戴？→ IV 背部配件对比表
  - 能直接零售吗？→ V 节目方案 + 背卡

  合规：全部使用全局 Token，无硬编码色值、无自定义 CSS 变量。
  图片说明：现用 crafts 目录与徽章目录实拍图占位，确认效果后替换。
*/
import epinHero from "../../assets/home/cases/enamelpins-hero.jpg";

/* II · 工艺面对比（实拍占位） */
import softEnamel from "../../assets/crafts/soft-enamel.jpg";
import hardEnamel from "../../assets/crafts/hard-enamel.jpg";
import uvPrinting from "../../assets/crafts/uv-printing.jpg";

/* III · 特殊工艺廊（实拍占位） */
import glitter from "../../assets/crafts/glitter.jpg";
import glowInTheDark from "../../assets/crafts/glow-in-the-dark.jpg";
import expoyDome from "../../assets/crafts/exposy.jpg";
import rhinestone from "../../assets/crafts/rhinestone.jpg";
import dieStruck from "../../assets/crafts/die-struck.jpg";
import interactivePin from "../../assets/crafts/interactive-pin.jpg";
import backCard from "../../assets/crafts/back-card.jpg";

/* IV · 背部配件小图（占位图，待替换为配件实物图） */
import platingColor from "../../assets/crafts/plating-color.jpg";
import coinCapsule from "../../assets/crafts/coin-capsule.jpg";

/* ============================================================
   SECTIONS — TOC 锚点（Overview 无编号，其后从 I 顺延）
   ============================================================ */

const sections = [
  { id: "hero", number: "", label: "Overview" },
  { id: "specifications", number: "I", label: "Specifications" },
  { id: "enamel", number: "II", label: "Enamel & Surface" },
  { id: "finishes", number: "III", label: "Special Finishes" },
  { id: "backs", number: "IV", label: "Back Attachments" },
  { id: "applications", number: "V", label: "Use Cases" },
  { id: "production", number: "VI", label: "Production & Quality" },
  { id: "faq", number: "VII", label: "FAQ" },
  { id: "inquiry", number: "VIII", label: "Inquiry" },
];

/* ============================================================
   ENAMEL PINS — PAGE CONTENT
   ============================================================ */

const product = {
  slug: "enamel-pins",
  title: "Enamel Pins",

  image: epinHero,
  alt: "Custom enamel pin with detailed colorful finish",

  desc: "Custom enamel pins built around your artwork — soft or hard enamel, special finishes, and the backing that fits how it will be worn and collected. From merch drops to retail-ready sets.",

  heroTitle: "Color, held in metal.",

  heroIntro:
    "A small surface with room for a full illustration. Build a custom enamel pin around the surface, the finishes, and the backing that fit how it will be worn and collected.",

  statement: [
    "Art, held in metal.",
    "Finished to be collected.",
    "Retail-ready from the box.",
  ],

  quickFacts: [
    "MOQ 500 pcs per design",
    "Sample 5–8 working days",
    "Soft or hard enamel",
  ],

  /* II · 三种表面工艺：hero 截面带 + II 实拍对比卡共用数据 */
  enamelMethods: [
    {
      id: "soft",
      number: "01",
      name: "Soft Enamel",
      level: "Recessed surface",
      title: "Raised metal lines, recessed color.",
      note: "Color sits below the metal line",
      image: softEnamel,
      alt: "Soft enamel surface detail on a custom pin",
      text: "Soft enamel is filled slightly below the raised metal lines. The color sits in shallow wells, so the metal outline stays visible and the surface has a tactile, slightly uneven feel. Usually the lower-cost method, and a good fit for bold line art and flat color fields.",
    },
    {
      id: "hard",
      number: "02",
      name: "Hard Enamel",
      level: "Flush, polished surface",
      title: "Sanded flush. Polished smooth.",
      note: "Color polished flush with the metal line",
      image: hardEnamel,
      alt: "Hard enamel polished surface detail on a custom pin",
      text: "Hard enamel is filled, then sanded and polished until the color is flush with the metal lines. The result is a flat, glass-like surface that is typically more durable and more refined — and reads as premium on collector pieces.",
    },
    {
      id: "print",
      number: "03",
      name: "Print & Mixed",
      level: "UV / screen print",
      title: "For gradients and fine detail.",
      note: "A printed layer sits over the metal body",
      image: uvPrinting,
      alt: "UV printed detail on a custom pin",
      text: "When the artwork needs gradients, photographs, or very fine lines, UV or screen printing sits on top of the metal body — with or without enamel fill. Printing and enamel can also be combined on the same pin: a printed gradient inside an enameled field.",
    },
  ],

  /* III · 特殊工艺切换廊 */
  finishes: [
    {
      key: "glitter",
      number: "01",
      name: "Glitter Enamel",
      tag: "Enamel effect",
      image: glitter,
      alt: "Glitter enamel finish on a custom pin",
      text: "Glitter mixed into the enamel fill catches light and reads as a limited edition from across a room. Best on larger color fields — fine detail turns muddy.",
    },
    {
      key: "glow",
      number: "02",
      name: "Glow-in-the-Dark",
      tag: "Enamel effect",
      image: glowInTheDark,
      alt: "Glow-in-the-dark enamel finish on a custom pin",
      text: "A luminous fill that charges in daylight and glows after dark. Best for character designs and night-themed drops — a test shot is recommended before the run.",
    },
    {
      key: "epoxy",
      number: "03",
      name: "Epoxy Doming",
      tag: "Additive",
      image: expoyDome,
      alt: "Epoxy dome finish on a custom pin",
      text: "A resin dome over the printed surface — wipe-clean and scratch-resistant. It softens very fine type, so pair it with illustration work rather than copy.",
    },
    {
      key: "rhinestone",
      number: "04",
      name: "Rhinestone",
      tag: "Additive",
      image: rhinestone,
      alt: "Rhinestone stones set into a custom pin",
      text: "Crystal or colored stones set into the metal body. Best for fashion and anniversary pieces; placement and stone size are confirmed at sample stage.",
    },
    {
      key: "cutout",
      number: "05",
      name: "Cut-Outs",
      tag: "Construction",
      image: dieStruck,
      alt: "Laser cut-out detail on a custom pin body",
      text: "Laser-cut openings through the body — for keys, wings, tools, and any shape that needs to read as an outline. Adds process steps and unit cost.",
    },
    {
      key: "spinner",
      number: "06",
      name: "Spinners & Movable Parts",
      tag: "Construction",
      image: interactivePin,
      alt: "Spinner pin with a movable element",
      text: "A rotating or dangling element fixed behind the front plate. The most collectible format in the range — it needs a thicker body and careful balance, so it is quoted separately.",
    },
    {
      key: "double",
      number: "07",
      name: "Double-Sided",
      tag: "Print",
      image: hardEnamel,
      alt: "Double-sided custom enamel pin",
      text: "Enamel front with an enameled, engraved, or printed reverse — designed as one object, not an afterthought. Alignment across both faces is checked at sample stage.",
    },
    {
      key: "card",
      number: "08",
      name: "Backing Card Retail",
      tag: "Packaging",
      image: backCard,
      alt: "Custom backing card for retail packaging of enamel pins",
      text: "Custom backing cards with brand artwork, a barcode or QR code, and a die-cut window — so the pin can go straight onto a retail fixture without repacking.",
    },
  ],

  /* IV · 背部配件（开放对比表；小图为占位图，替换为配件实物图） */
  backs: [
    {
      id: "butterfly",
      name: "Butterfly Clutch",
      tag: "Standard",
      image: platingColor,
      alt: "Butterfly clutch back attachment",
      holds: "A metal butterfly clutch pressed onto the post — the default for bulk merchandise and the lowest-cost option.",
      bestFor: "Merch drops, events, high-volume runs",
    },
    {
      id: "rubber",
      name: "Rubber Clutch",
      tag: "Stronger grip",
      image: expoyDome,
      alt: "Rubber clutch back attachment",
      holds: "A flexible rubber cap that grips the post by friction — more secure than a butterfly clutch on thick fabric.",
      bestFor: "Backpacks, uniforms, outdoor events",
    },
    {
      id: "magnetic",
      name: "Magnetic Back",
      tag: "No pinholes",
      image: coinCapsule,
      alt: "Magnetic back attachment",
      holds: "A magnet set into the pin reverse, paired with a plate on the other side of the fabric — nothing is pierced.",
      bestFor: "Blazers, knitwear, corporate apparel",
    },
    {
      id: "safety",
      name: "Safety Pin",
      tag: "Classic mechanism",
      image: dieStruck,
      alt: "Safety pin back attachment",
      holds: "A wire pin and catch built into the reverse — secure, familiar, and removable without a separate clutch.",
      bestFor: "Heritage styles, uniform and hat pins",
    },
    {
      id: "ring",
      name: "Keychain Ring",
      tag: "Dual purpose",
      image: interactivePin,
      alt: "Keychain ring back attachment",
      holds: "A split ring or swivel clasp riveted to the reverse — the same pin works as a bag charm or keychain.",
      bestFor: "Gift sets, event bundles, retail multipacks",
    },
  ],

  /* V · 节目方案 */
  applications: [
    {
      number: "01",
      title: "Brand Merchandise",
      text: "Turn a logo, mascot, or campaign graphic into a wearable item. Soft enamel suits bold line art; hard enamel suits a smoother, premium look.",
      chip: "Soft enamel · butterfly clutch",
    },
    {
      number: "02",
      title: "Events & Conferences",
      text: "Design a pin around a launch, milestone, or attendee identity. A compact format works well for lanyard distribution, badges, and welcome kits.",
      chip: "Compact 25–32 mm · rubber clutch",
    },
    {
      number: "03",
      title: "Causes & Fundraising",
      text: "Use a clear, readable design to support awareness campaigns and fundraising programs, with quantities that suit a defined audience.",
      chip: "Bold line art · lowest unit cost",
    },
    {
      number: "04",
      title: "Collector Editions",
      text: "Build limited editions, series, and character designs with consistent plating and packaging so a set reads as one collection.",
      chip: "Hard enamel · numbered backing card",
    },
    {
      number: "05",
      title: "Retail & Souvenirs",
      text: "Pair the pin with a custom backing card or retail display so it fits an existing shop, museum, or destination merchandise fixture.",
      chip: "Custom backing card · retail box",
    },
  ],

  specs: [
    {
      label: "Typical Pin Size",
      value: "Around 25–40 mm; custom dimensions available up to 60 mm+",
    },
    {
      label: "Body Thickness",
      value: "Often around 1.5–3 mm, depending on construction and enamel method",
    },
    {
      label: "Materials",
      value: "Zinc alloy, brass, iron, stainless steel, and selected combinations",
    },
    {
      label: "MOQ",
      value: "500 pcs per design; final MOQ confirmed with your quotation",
    },
    {
      label: "Body Construction",
      value: "Die-cast, stamped, etched, or laser-cut, depending on design",
    },
    {
      label: "Metal Plating",
      value: "Gold, silver, nickel, black nickel, antique bronze, rose gold, and matte options",
    },
    {
      label: "Enamel Method",
      value: "Soft enamel, hard enamel, UV print, screen print, engraving, or mixed techniques",
    },
    {
      label: "Special Finishes",
      value: "Glitter, glow-in-the-dark, epoxy dome, rhinestone, cut-outs, spinners",
    },
    {
      label: "Back Attachments",
      value: "Butterfly clutch, rubber clutch, magnetic back, safety pin, or keychain conversion",
    },
    {
      label: "Sides",
      value: "Single-sided, double-sided enamel, or enamel front with engraved or printed reverse",
    },
    {
      label: "Packaging",
      value: "Poly bag, backing card, velvet pouch, retail box, or gift set",
    },
  ],

  qualityChecks: [
    "Approved outline, metal lines, and colors",
    "Enamel method and surface level",
    "Plating, back attachment, and assembly",
    "Packaging and quantity specification",
  ],

  faq: [
    {
      q: "What is the minimum order quantity?",
      a: "The current standard planning MOQ is 500 pieces per design. The final MOQ can depend on the pin size, material, plating, enamel method, back attachment, and packaging. Please confirm the applicable quantity with your quotation.",
    },
    {
      q: "What is the difference between soft enamel and hard enamel?",
      a: "Soft enamel is filled slightly below the raised metal lines, leaving a visible texture and a slightly recessed surface — it is usually the lower-cost option. Hard enamel is sanded and polished until the enamel sits flush with the metal lines, creating a smooth, flat finish that is typically more durable and more refined in appearance.",
    },
    {
      q: "What special finishes are available?",
      a: "Glitter enamel, glow-in-the-dark fill, epoxy doming, rhinestones, laser cut-outs, and spinners or other movable parts are all available. Each adds process steps and unit cost, and some are suited to particular sizes or designs — availability is confirmed at sample stage.",
    },
    {
      q: "How long do sampling and production take?",
      a: "A typical sample lead time is around 5–8 working days after artwork and specifications are confirmed. Bulk production timing depends on quantity, plating, enamel method, attachments, packaging, and the production schedule. The confirmed timeline should be agreed before the order proceeds.",
    },
    {
      q: "Can the pin be made double-sided?",
      a: "Yes. Double-sided enamel, double-sided printing, or an enamel front with an engraved reverse are all common. The available method depends on the design on each side and whether the artwork needs to align across both faces.",
    },
    {
      q: "Can gradients or photographic details be reproduced?",
      a: "Enamel fill uses solid colors, one per recessed area. For gradients, photographs, or very fine line work, UV printing or screen printing is usually a better fit than enamel fill. Printing and enamel can also be combined on the same pin.",
    },
    {
      q: "Which back attachment should I choose?",
      a: "Butterfly clutches are the standard for most merchandise and the lowest-cost option. Magnetic backs avoid pinholes and suit uniforms, blazers, and knitwear. Rubber clutches hold more firmly and are harder to remove. Safety pins suit traditional and uniform styles. Keychain conversion adds a second use case.",
    },
    {
      q: "Can the pin be mounted on a backing card?",
      a: "Custom backing cards can be planned with brand artwork, product information, a barcode or QR code, and a suitable mounting hole. Card material, printing, die-cutting, and mounting should be confirmed for each project.",
    },
    {
      q: "Can the design be reordered for future campaigns?",
      a: "Repeat production is usually possible when the design, tooling, material, and specifications remain suitable. Confirm tooling retention, storage arrangements, and repeat-order charges with your supplier rather than assuming these are included.",
    },
  ],
};

const hasProcess = manufacturingProcess.length > 0;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: product.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---
<ProductDetailLayout
  title={product.title}
  description={product.desc}
  ogImage={product.image.src}
  sections={sections}
>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- ============================================================
       HERO — 产品展台（成品 / 釉面细节）
       ============================================================ -->

  <section id="hero" class="product-hero">
    <div class="product-hero__grid">
      <div class="product-hero__copy">
        <p class="product-hero__eyebrow">
          CUSTOM {product.title.toUpperCase()}
        </p>

        <h1 class="product-hero__title">{product.heroTitle}</h1>

        <p class="product-hero__desc">{product.heroIntro}</p>

        {product.statement.length > 0 && (
          <div class="product-hero__statement">
            {product.statement.map((line) => (
              <span>{line}</span>
            ))}
          </div>
        )}

        {product.quickFacts.length > 0 && (
          <ul class="product-hero__facts">
            {product.quickFacts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
        )}
      </div>

      <figure class="epin-hero__shot">
        <Image
          src={product.image}
          alt={product.alt}
          loading="eager"
          widths={[640, 960, 1280]}
          sizes="(min-width: 1000px) 42vw, 92vw"
        />
        <figcaption class="epin-hero__shot-label">
          Soft enamel · antique plating
        </figcaption>
      </figure>
    </div>

    <!-- 珐琅工艺互动带：截面示意 + 方法切换 -->
    <div
      class="epin-surface"
      data-epin-surface
      data-epin-surface-views={JSON.stringify(
        product.enamelMethods.map(({ id, level, title, text, note }) => ({
          id,
          level,
          title,
          text,
          note,
        })),
      )}
    >
      <div class="epin-surface__head">
        <span>Enamel Method</span>
        <span>Select a Surface</span>
      </div>

      <div class="epin-surface__body">
        <div class="epin-surface__figure">
          {product.enamelMethods.map((method, index) => (
            <div
              class:list={[
                "epin-profile",
                `epin-profile--${method.id}`,
                { "is-active": index === 0 },
              ]}
              data-epin-surface-profile={method.id}
              aria-hidden="true"
            >
              <span class="epin-profile__metal"></span>
              <span class="epin-profile__fill"></span>
              <span class="epin-profile__metal"></span>
            </div>
          ))}

          <p class="epin-surface__note" data-epin-surface-note>
            {product.enamelMethods[0]?.note ?? ""}
          </p>
        </div>

        <div class="epin-surface__copy">
          <span class="epin-surface__level" data-epin-surface-level>
            {product.enamelMethods[0]?.level ?? ""}
          </span>

          <h2 class="epin-surface__title" data-epin-surface-title>
            {product.enamelMethods[0]?.title ?? ""}
          </h2>

          <p class="epin-surface__text" data-epin-surface-text>
            {product.enamelMethods[0]?.text ?? ""}
          </p>
        </div>
      </div>

      <div
        class="epin-surface__tabs"
        role="group"
        aria-label="Choose an enamel method"
      >
        {product.enamelMethods.map((method, index) => (
          <button
            type="button"
            class:list={["epin-surface__tab", { "is-active": index === 0 }]}
            data-epin-surface-tab={method.id}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <span class="epin-surface__tab-num">{method.number}</span>
            <strong>{method.name}</strong>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       I. SPECIFICATIONS — 锁死结构
       ============================================================ -->

  <section id="specifications" class="product-section">
    <div class="product-section__inner">
      <div class="epin-heading">
        <div>
          <p class="product-eyebrow">I · SPECIFICATIONS</p>

          <h2 class="product-section__title">Start with the outline.</h2>
        </div>

        <p class="product-section__lead">
          The shape carries the idea, and the surface method carries the
          color. Size, metal line placement, plating, and back attachment
          set the foundation for everything that follows.
        </p>
      </div>

      <div class="specs-layout">
        <div class="specs-feature">
          <div class="specs-feature__value">500 pcs</div>

          <div class="specs-feature__label">MOQ per design</div>

          <div class="specs-feature__line"></div>

          <div class="specs-feature__mark">
            SOFT
            <br />
            OR HARD
          </div>
        </div>

        <div class="specs-list">
          {product.specs.map((spec, index) => (
            <div class="spec-row">
              <div class="spec-row__number">
                {String(index + 1).padStart(2, "0")}
              </div>

              <div class="spec-row__label">{spec.label}</div>

              <div class="spec-row__value">{spec.value}</div>
            </div>
          ))}
        </div>
      </div>

      <p class="product-section__note">
        Dimensions and available processes depend on the design and selected
        material. Enamel fill uses solid colors per recessed area —
        gradients, photographs, and fine line work may require a different
        process. Final specifications should be confirmed against the
        approved artwork and sample.
      </p>
    </div>
  </section>

  <!-- ============================================================
       II. ENAMEL & SURFACE — 三列截面对比
       ============================================================ -->

  <section id="enamel" class="product-section">
    <div class="product-section__inner">
      <div class="epin-heading">
        <div>
          <p class="product-eyebrow">II · ENAMEL &amp; SURFACE</p>

          <h2 class="product-section__title">
            Where the color sits decides everything.
          </h2>
        </div>

        <p class="product-section__lead">
          The surface method controls cost, durability, and how fine your
          artwork can be. Compare the three cross-sections side by side —
          the difference is a few tenths of a millimetre, and it is visible
          from across a room.
        </p>
      </div>

      <div class="epin-methods">
        {product.enamelMethods.map((method) => (
          <article class="epin-method">
            <div class="epin-method__media">
              <Image
                src={method.image}
                alt={method.alt}
                loading="lazy"
                widths={[480, 720, 960]}
                sizes="(min-width: 1000px) 24vw, 92vw"
              />
              <span class="epin-method__level">{method.level}</span>
            </div>

            <div class="epin-method__body">
              <span class="epin-method__number">{method.number}</span>

              <div class="epin-method__head">
                <h3>{method.name}</h3>
              </div>

              <p class="epin-method__text">{method.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       III. SPECIAL FINISHES — 特殊工艺切换廊
       ============================================================ -->

  <section id="finishes" class="product-section">
    <div class="product-section__inner">
      <div class="epin-heading">
        <div>
          <p class="product-eyebrow">III · SPECIAL FINISHES</p>

          <h2 class="product-section__title">
            Make it worth keeping.
          </h2>
        </div>

        <p class="product-section__lead">
          A flat enamel pin is a starting point. These are the finishes that
          turn a giveaway into something people trade, display, and reorder —
          each one adds process steps and unit cost, so the right one is the
          one your collection actually needs.
        </p>
      </div>

      <div
        class="epin-finish"
        data-epin-finish
        data-epin-finish-views={JSON.stringify(
          product.finishes.map(({ key, name, tag, text }) => ({
            key,
            name,
            tag,
            text,
          })),
        )}
      >
        <div
          class="epin-finish__rail"
          role="group"
          aria-label="Special finish selector"
        >
          {product.finishes.map((finish, index) => (
            <button
              type="button"
              class:list={[
                "epin-finish__tab",
                { "is-active": index === 0 },
              ]}
              data-epin-finish-tab={finish.key}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <span class="epin-finish__tab-num">{finish.number}</span>
              <strong>{finish.name}</strong>
            </button>
          ))}
        </div>

        <div class="epin-finish__detail">
          <div class="epin-finish__media">
            {product.finishes.map((finish, index) => (
              <Image
                src={finish.image}
                alt={finish.alt}
                class:list={[
                  "epin-finish__image",
                  { "is-active": index === 0 },
                ]}
                data-epin-finish-img={finish.key}
                loading={index === 0 ? "eager" : "lazy"}
                widths={[480, 720, 960]}
                sizes="(min-width: 1000px) 30vw, 92vw"
              />
            ))}

            <span class="epin-finish__badge" data-epin-finish-badge>
              {product.finishes[0]?.tag ?? ""}
