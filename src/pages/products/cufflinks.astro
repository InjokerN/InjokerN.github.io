      transform 0.25s ease;
  }

  .closing-card:hover {
    border-color: var(--gold);
    transform: translateY(-3px);
  }

  .closing-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .closing-card__head h4 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .closing-card__tag {
    flex: 0 0 auto;
    color: var(--gold);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: right;
    padding-top: 3px;
  }

  .closing-card__text {
    flex: 1;
    margin: 16px 0 20px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .closing-card__foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-size: 11px;
  }

  .closing-card__foot span {
    color: var(--muted2);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 9px;
    padding-top: 2px;
  }

  .closing-card__foot strong {
    color: var(--ink);
    font-weight: 600;
    text-align: right;
  }

  /* ---- shirt drawings ---- */

  .shirt-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .shirt-case {
    margin: 0;
    padding: 0;
    background: var(--paper2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .shirt-case__drawing {
    position: relative;
    height: 210px;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  /* 衣领 */
  .shirt-case__collar {
    position: absolute;
    top: -18px;
    left: 50%;
    width: 96px;
    height: 44px;
    transform: translateX(-50%);
    background: var(--paper2);
    border: 1px solid var(--line);
    border-radius: 0 0 48px 48px;
  }

  /* 门襟 */
  .shirt-case__placket {
    position: absolute;
    top: 0;
    left: 50%;
    width: 12px;
    height: 100%;
    transform: translateX(-50%);
    background: var(--paper2);
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }

  /* 领带 */
  .shirt-case__tie {
    position: absolute;
    top: 6px;
    left: 50%;
    width: 30px;
    height: 178px;
    transform: translateX(-50%) rotate(-1.6deg);
    transform-origin: top center;
    background: var(--ink);
    opacity: 0.86;
    clip-path: polygon(26% 0, 74% 0, 100% 100%, 0 100%);
  }

  /* 纽扣 */
  .shirt-case__btn {
    position: absolute;
    left: 50%;
    width: 5px;
    height: 5px;
    transform: translateX(-50%);
    background: var(--paper);
    border: 1px solid var(--muted2);
    border-radius: 50%;
  }

  .shirt-case__btn--1 {
    top: 46px;
  }

  .shirt-case__btn--2 {
    top: 88px;
  }

  .shirt-case__btn--3 {
    top: 130px;
  }

  .shirt-case__btn--4 {
    top: 172px;
  }

  /* 领带夹 */
  .shirt-case__clip {
    position: absolute;
    left: 50%;
    width: 46px;
    height: 7px;
    transform: translateX(-50%);
    background: var(--gold);
    border-radius: 2px;
    box-shadow: 0 2px 5px rgba(43, 35, 25, 0.22);
  }

  .shirt-case--correct .shirt-case__clip {
    top: 148px;
  }

  .shirt-case--high .shirt-case__clip {
    top: 66px;
  }

  .shirt-case--low .shirt-case__clip {
    top: 190px;
  }

  /* 无夹：领带飘离门襟 */
  .shirt-case--none .shirt-case__tie {
    transform: translateX(-50%) rotate(-7deg) translateX(-16px);
    opacity: 0.5;
  }

  .shirt-case--none .shirt-case__clip {
    display: none;
  }

  /* 夹得太高：领带在窄处拱起，只夹住一层 */
  .shirt-case--high .shirt-case__tie {
    transform: translateX(-50%) rotate(-3.4deg) translateX(-4px);
    opacity: 0.72;
  }

  /* 夹得太低：宽端被拉平，在腹部绷出褶 */
  .shirt-case--low .shirt-case__tie {
    transform: translateX(-50%) translateX(2px) scaleX(1.08);
    opacity: 0.8;
  }

  .shirt-case figcaption {
    padding: 18px 20px 22px;
  }

  .shirt-case__verdict {
    margin: 0 0 8px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .shirt-case--correct .shirt-case__verdict {
    color: var(--gold);
  }

  .shirt-case--high .shirt-case__verdict,
  .shirt-case--low .shirt-case__verdict {
    color: var(--muted2);
  }

  .shirt-case--none .shirt-case__verdict {
    color: var(--muted);
  }

  .shirt-case figcaption h4 {
    margin: 0 0 8px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .shirt-case figcaption p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.65;
  }

  /* ---- size scale ---- */

  .size-scale {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
    padding: 32px 24px;
    background: var(--paper2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .size-scale__cell {
    display: grid;
    justify-items: center;
    gap: 38px;
    text-align: center;
  }

  .size-scale__disc {
    display: grid;
    place-items: center;
    width: 132px;
    height: 132px;
    max-width: 100%;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--line);
    position: relative;
  }

  /* 按真实比例缩放的实心圆 —— 18 mm 为满盘，其余按比例内缩 */
  .size-scale__dot {
    position: absolute;
    width: var(--d);
    height: var(--d);
    border-radius: 50%;
    background: var(--ink);
    opacity: 0.9;
  }

  .size-scale__cell.is-standard .size-scale__disc {
    border-color: var(--gold);
  }

  .size-scale__cell.is-standard .size-scale__dot {
    background: var(--gold);
  }

  /* 标签放在圆外，避免在最小圆上不可读 */
  .size-scale__mm {
    position: absolute;
    bottom: -26px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .size-scale__cell.is-standard .size-scale__mm {
    color: var(--gold);
  }

  .size-scale__cell p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .size-scale__cell.is-standard p {
    color: var(--ink);
    font-weight: 600;
  }

  /* ============================================================
     IV. CRAFT
     ============================================================ */

  .craft-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .craft-panel {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .craft-panel__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--paper2);
  }

  .craft-panel__media img {
    display: block;
    width: 100%;
