  .craft-panel--light .craft-panel__body {
    background: var(--paper2);
  }

  .craft-panel__body h3 {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .craft-panel--light .craft-panel__body h3 {
    color: var(--ink);
  }

  .craft-panel--dark .craft-panel__body h3 {
    color: var(--gold2);
  }

  .craft-panel__body > p {
    margin: 0;
    font-size: 14px;
    line-height: 1.78;
  }

  .craft-panel--light .craft-panel__body > p {
    color: var(--muted);
  }

  .craft-panel--dark .craft-panel__body > p {
