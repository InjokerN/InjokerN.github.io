    line-height: 1.5;
  }

  .companion-node__arrow {
    margin-left: auto;
    color: var(--muted2);
    font-size: 13px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .companion-node.is-active .companion-node__arrow {
