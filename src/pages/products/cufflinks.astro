    color: var(--gold2) !important;
  }

  .craft-panel--light .craft-panel__note {
    color: var(--muted2) !important;
  }

  /* ---- enamel ---- */

  .enamel-choice {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(24px, 4vw, 56px);
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: clamp(28px, 3.4vw, 40px);
    border-top: 1px solid var(--line);
  }

  .enamel-choice__intro h3 {
    margin: 0 0 14px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .enamel-choice__intro p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.78;
  }

  .enamel-choice__compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .enamel-option {
    padding: 22px;
    background: var(--paper2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .enamel-option__swatch {
    display: flex;
    flex-direction: column;
    gap: 5px;
    height: 56px;
    margin-bottom: 18px;
    padding: 8px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .enamel-option__swatch span {
    display: block;
    height: 8px;
    border-radius: 1px;
    background: var(--gold);
  }

  /* 硬珐琅：所有色块顶面对齐，形成同一平面 */
  .enamel-option__swatch--hard {
    justify-content: center;
  }

  .enamel-option__swatch--hard span {
    background: linear-gradient(
      180deg,
      var(--gold2) 0%,
      var(--gold) 55%,
      var(--gold) 100%
    );
  }

  /* 软珐琅：色块高低不一，中间鼓起 */
  .enamel-option__swatch--soft {
    justify-content: center;
  }

  .enamel-option__swatch--soft span {
    height: 10px;
    background: linear-gradient(
      180deg,
      var(--ink) 0%,
      var(--muted) 70%,
      var(--ink) 100%
    );
    border-radius: 4px;
    opacity: 0.78;
  }

  .enamel-option__swatch--soft span:nth-child(1) {
    transform: scaleX(0.94);
  }

  .enamel-option__swatch--soft span:nth-child(2) {
    transform: scaleX(1);
  }

  .enamel-option__swatch--soft span:nth-child(3) {
    transform: scaleX(0.96);
  }

  .enamel-option h4 {
    margin: 0 0 10px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .enamel-option > p {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }

  .enamel-option ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 7px;
  }

  .enamel-option li {
    position: relative;
    padding-left: 13px;
    color: var(--muted2);
    font-size: 11px;
    line-height: 1.55;
  }

  .enamel-option li::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 0;
    width: 4px;
    height: 4px;
    background: var(--gold);
    border-radius: 50%;
  }

  /* ============================================================
     V. PRESENTATION
     ============================================================ */

  .presentation {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(24px, 4vw, 52px);
    align-items: start;
