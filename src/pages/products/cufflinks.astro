    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .pairing-cell h4 {
    margin: 10px 0 10px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .pairing-cell p {
