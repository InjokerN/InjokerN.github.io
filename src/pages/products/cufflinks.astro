  @media (max-width: 1024px) {
    .section-heading,
    .cl-hero,
    .enamel-choice,
    .presentation,
    .companion {
      grid-template-columns: 1fr;
    }

    .section-heading {
      gap: 18px;
      align-items: start;
    }

    .cl-hero__copy {
      max-width: none;
    }

    .companion__rail {
      flex-direction: row;
      overflow-x: auto;
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .companion-node {
      flex: 0 0 auto;
      min-width: 220px;
      border-bottom: none;
      border-right: 1px solid var(--line);
    }

    .companion-node::before {
      top: auto;
      bottom: 0;
      width: 100%;
      height: 2px;
    }

    .companion__panel {
