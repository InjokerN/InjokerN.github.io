</style>

<script>
  /* ============================================================
     CUFFLINK PAGE INTERACTIONS

     - Hero 画廊（data-cl-gallery）：图 + 随图说明
     - 袖扣 / 领带夹切换（data-companion）
     使用独立 data-* 属性与独立 cleanup 键，
     不与 ProductDetailLayout 的 initProductGallery 冲突。
     ============================================================ */

  type CufflinkWindow = Window & {
    __clGalleryCleanup?: () => void;
    __clCompanionCleanup?: () => void;
  };

  function initClGallery() {
    const root = document.querySelector<HTMLElement>("[data-cl-gallery]");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const thumbs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")
    );
    const stages = Array.from(
      root.querySelectorAll<HTMLElement>("[data-gallery-stage]")
    );
    const captionLabel = root.querySelector<HTMLElement>("[data-caption-label]");
    const captionNote = root.querySelector<HTMLElement>("[data-caption-note]");

    let data: { label: string; note: string }[] = [];

    try {
      data = JSON.parse(root.dataset.galleryData ?? "[]");
    } catch {
      return;
    }

    if (!thumbs.length || !stages.length) return;

    function activate(index: number) {
      thumbs.forEach((thumb, i) => {
        const isActive = i === index;
        thumb.classList.toggle("is-active", isActive);
        thumb.setAttribute("aria-pressed", isActive ? "true" : "false");
      });

      stages.forEach((stage, i) => {
        stage.classList.toggle("is-active", i === index);
      });

      const item = data[index];
      if (!item) return;
      if (captionLabel) captionLabel.textContent = item.label;
      if (captionNote) captionNote.textContent = item.note;
    }

    function onThumbClick(event: Event) {
      const thumb = event.currentTarget as HTMLButtonElement;
      const index = Number(thumb.dataset.galleryThumb);
      if (!Number.isNaN(index)) activate(index);
    }

    thumbs.forEach((thumb) => thumb.addEventListener("click", onThumbClick));

    const cleanup = () => {
      thumbs.forEach((thumb) =>
        thumb.removeEventListener("click", onThumbClick)
      );
    };

    const win = window as CufflinkWindow;
    win.__clGalleryCleanup?.();
    win.__clGalleryCleanup = cleanup;
  }

  function initClCompanion() {
    const root = document.querySelector<HTMLElement>("[data-companion]");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const nodes = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-companion-node]")
    );
    const details = Array.from(
      root.querySelectorAll<HTMLElement>("[data-companion-detail]")
    );

    if (!nodes.length || !details.length) return;

    function activate(id: string) {
      nodes.forEach((node) => {
        const isActive = node.dataset.companionNode === id;
        node.classList.toggle("is-active", isActive);
        node.setAttribute("aria-pressed", isActive ? "true" : "false");
      });

      details.forEach((detail) => {
        detail.classList.toggle(
          "is-active",
          detail.dataset.companionDetail === id
        );
      });
    }

    function onNodeClick(event: Event) {
      const node = event.currentTarget as HTMLButtonElement;
      const id = node.dataset.companionNode;
      if (id) activate(id);
    }

    nodes.forEach((node) => node.addEventListener("click", onNodeClick));

    const cleanup = () => {
      nodes.forEach((node) =>
        node.removeEventListener("click", onNodeClick)
      );
    };

    const win = window as CufflinkWindow;
    win.__clCompanionCleanup?.();
    win.__clCompanionCleanup = cleanup;
  }

  initClGallery();
  initClCompanion();

  document.addEventListener("astro:page-load", initClGallery);
  document.addEventListener("astro:page-load", initClCompanion);
</script>
