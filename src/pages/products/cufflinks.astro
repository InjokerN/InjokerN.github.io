  /* ============================================================
     RESPONSIVE
     ============================================================ */

  @media (max-width: 1180px) {
    .closing-scale,
    .shirt-grid,
    .pairing-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* 2×2 网格：奇数格保留右边框，偶数格去掉；前两格补下边框 */
    .pairing-cell {
      border-right: 1px solid var(--line);
    }

    .pairing-cell:nth-child(2n) {
