  .presentation-row__index {
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.9;
  }

  .presentation-row h4 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 8px;
