  .occasion-row__body h4 {
    margin: 0 0 6px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(17px, 1.8vw, 21px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
