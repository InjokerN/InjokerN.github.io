  @media (max-width: 680px) {
    .cl-gallery__meta {
      grid-template-columns: 1fr;
    }

    .cl-gallery__rail {
      order: -1;
    }

    .cl-gallery__thumb {
      width: 54px;
      height: 54px;
    }

    .closing-scale,
    .shirt-grid,
    .pairing-strip,
    .enamel-choice__compare {
      grid-template-columns: 1fr;
    }

    .pairing-cell {
