  }

  .presentation-row p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  /* ============================================================
     VI. APPLICATIONS
     ============================================================ */

  .occasion-index {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .occasion-row {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) auto;
    gap: clamp(14px, 2.4vw, 32px);
    align-items: start;
    padding: clamp(20px, 2.4vw, 28px) 0;
