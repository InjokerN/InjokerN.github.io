---
import { Image } from "astro:assets";
import ProductDetailLayout from "../../components/ProductDetailLayout.astro";

import { manufacturingProcess } from "../../data/manufacturing-process";

/*
  BOTTLE OPENERS — PRODUCT DETAIL PAGE

  设计主线：A tool first, a gift second.
  开瓶器是 8 个品类里唯一的「功能工具」——钩型几何决定它能不能开盖，
  三种形态决定它适合什么节目。整页围绕两个买家问题展开：

  - 它能开我的瓶子吗？→ Hero 钩型几何 + 开盖测试矩阵
  - 我该选哪种形态？→ 三列形态对比表（并排比较，不玩 tabs）

  图片说明：现用开瓶器目录实拍图占位，确认效果后替换为最终产品图。
*/
import openerOg from "../../assets/home/cases/bottle-openers-hero.jpg";
import openerHero from "../../assets/home/bottle-openers-hero.jpg";
import openerDetail from "../../assets/products/home/home-bottle-opener-01.jpg";
import dieStruck from "../../assets/crafts/die-struck.jpg";

/* ============================================================
   SECTIONS — TOC 锚点（Overview 无编号，其后从 I 顺延）
   ============================================================ */

const sections = [
  { id: "hero", number: "", label: "Overview" },
  { id: "specifications", number: "I", label: "Specifications" },
  { id: "formats", number: "II", label: "Formats & Proof" },
  { id: "applications", number: "III", label: "Applications" },
  { id: "production", number: "IV", label: "Production & Quality" },
  { id: "faq", number: "V", label: "FAQ" },
  { id: "inquiry", number: "VI", label: "Inquiry" },
];

/* ============================================================
   BOTTLE OPENERS — PAGE CONTENT
   ============================================================ */

const product = {
  slug: "bottle-openers",
  title: "Bottle Openers",

  image: openerOg,
  alt: "Custom metal bottle opener with engraved logo",

  desc: "A gift people actually reach for. Custom metal bottle openers pair a working tool with your logo — die-struck for a hard, consistent edge, engraved or enamel-filled, and test-opened on real caps before packing.",

  heroTitle: "Your logo, on the tool they reach for.",

  statement: [
    "Opens the cap, every time.",
    "Carries the mark, for years.",
    "Tested before it ships.",
  ],

  quickFacts: [
    "MOQ 300 pcs per design",
    "Hook 2.0–3.0 mm die-struck",
    "Tested on 26 mm crown caps",
  ],

  /* Hero 展台：成品 + 钩部细节 */
  views: [
    {
      key: "finished",
      name: "Finished piece",
      note: "Die-struck body with an engraved mark — struck from a single piece, so edge hardness stays consistent.",
      image: openerHero,
      alt: "Custom metal bottle opener, finished piece",
    },
    {
      key: "hook",
      name: "Hook detail",
      note: "The opening hook at 2.0–3.0 mm — stiff enough not to roll, sized to seat over a 26 mm crown cap.",
      image: openerDetail,
      alt: "Bottle opener hook detail close-up",
    },
  ],

  /* Hero 底部：开口钩几何三参数 */
  hookGeometry: [
    {
      label: "Hook depth",
      value: "6–8 mm",
      note: "Seats over the crown, not past it",
    },
    {
      label: "Lift angle",
      value: "15–20°",
      note: "Enough lift without slipping",
    },
    {
      label: "Edge thickness",
      value: "2.0–3.0 mm",
      note: "Stiff enough not to roll",
    },
  ],

  /* 三种形态：扁平数据，供对比表渲染 */
  formats: [
    {
      id: "bar-blade",
      label: "Bar Blade",
      tagline: "The professional format",
      text: "Long enough to lever a cap off in one motion, heavy enough to be picked up without looking. The format bartenders actually carry.",
      size: "180 × 40 mm",
      thickness: "3.0–4.0 mm",
      weight: "90–120 g",
      cost: "Highest",
      leverage: "One-motion lever",
      bestFor: "Breweries, bars, hospitality staff",
    },
    {
      id: "keychain",
      label: "Keychain",
      tagline: "The pocket format",
      text: "Small enough to go everywhere. The trade-off is leverage — the hook has to be short, so it takes more force than a bar blade.",
      size: "60–80 mm",
      thickness: "2.0–2.5 mm",
      weight: "15–30 g",
      cost: "Lowest",
      leverage: "Short hook, more force",
      bestFor: "Giveaways, fan clubs, trade shows",
    },
    {
      id: "magnetic",
      label: "Magnetic",
      tagline: "The mounted format",
      text: "Sits on the fridge or a bar mount and is never lost. The flat face gives the largest printable area of the three.",
      size: "70–100 mm",
      thickness: "2.5–3.0 mm",
      weight: "40–60 g",
      cost: "Middle",
      leverage: "One motion, flat face",
      bestFor: "Fridge magnets, bar-mount merchandising",
    },
  ],

  formatRows: [
    { label: "What it is", key: "text" },
    { label: "Size", key: "size" },
    { label: "Thickness", key: "thickness" },
    { label: "Weight", key: "weight" },
    { label: "Unit cost", key: "cost" },
    { label: "Leverage", key: "leverage" },
    { label: "Best for", key: "bestFor" },
  ],

  /* 开盖测试矩阵：形态 × 瓶盖 */
  capMatrix: {
    caps: ["Crown cap 26 mm", "Specialty crown", "Crown cap 29 mm"],
    rows: [
      { format: "Bar Blade", levels: [3, 3, 2] },
      { format: "Keychain", levels: [3, 2, 1] },
      { format: "Magnetic", levels: [3, 2, 1] },
    ],
  },

  /* 实据照片（占位图，待替换为最终产品图） */
  proofPhotos: [
    {
      image: openerOg,
      alt: "Custom bottle openers from a brand program",
      label: "Program view",
    },
    {
      image: dieStruck,
      alt: "Die-struck bottle opener body before finishing",
      label: "Die-struck body",
    },
  ],

  specs: [
    {
      label: "Target cap",
      value: "Standard 26 mm crown cap; 29 mm and specialty on request",
    },
    {
      label: "Typical Size",
      value: "Bar blade 180 × 40 mm; keychain 60–80 mm; opener plate 70–100 mm",
    },
    {
      label: "Thickness",
      value: "2.0–3.0 mm for the opening hook; 3.0–4.0 mm for bar blades",
    },
    {
      label: "MOQ",
      value: "300 pcs per design; mixed handle finishes can share one order",
    },
    {
      label: "Material",
      value: "Zinc alloy, stainless steel, brass; hardwood and leather handles",
    },
    {
      label: "Craft",
      value: "Die-struck, die-cast, laser etching, engraving, enamel fill",
    },
    {
      label: "Plating",
      value:
        "Gold, silver, nickel, black nickel, antique, brushed metal finishes",
    },
    {
      label: "Handle & Fitting",
      value:
        "Key ring, leather loop, magnet backing, bottle-cap catcher, wall mount",
    },
    {
      label: "Packaging",
      value:
        "Printed sleeve, kraft box, gift box, bar-mount display card, wooden box",
    },
    {
      label: "Quality Control",
      value: "Opening tested on standard crown caps; 100% inspected",
    },
  ],

  whereItFits: [
    {
      title: "Breweries & Bars",
      text: "Taproom merchandise, branded bar blades, and giveaway tools for hospitality programs.",
      place: "Bar rail",
    },
    {
      title: "Hospitality & Restaurants",
      text: "Staff tools, welcome kits, and restaurant-branded openers for tables and gift shops.",
      place: "Server apron",
    },
    {
      title: "Corporate Gifting",
      text: "Client gifts, anniversary sets, and premium onboarding kits with real daily utility.",
      place: "Desk drawer",
    },
    {
      title: "Sports & Supporter Clubs",
      text: "Matchday merchandise, fan-club gifts, and team-branded bar tools.",
      place: "Keyring",
    },
    {
      title: "Events & Festivals",
      text: "Vendor gifts, festival merchandise, and trade-show items people keep on the keyring.",
      place: "Vendor table",
    },
    {
      title: "Promotional Campaigns",
      text: "Seasonal giveaways and distributor premiums where unit cost and perceived value both matter.",
      place: "Distributor kit",
    },
  ],

  faq: [
    {
      q: "What is the minimum order quantity for bottle openers?",
      a: "Our standard MOQ is 300 pieces per design. Because bar blades and keychain openers use separate tools, costs are quoted per format — the more pieces per design, the lower the per-unit tooling share.",
    },
    {
      q: "Will the opener work on every cap?",
      a: "The hook is sized for standard 26 mm crown caps used on most glass bottles. For specialty closures or cans, tell us at quoting stage and we will test a sample before production.",
    },
    {
      q: "How is the logo applied?",
      a: "Deep engraving is the most durable and holds up to years of handling; laser etching gives a finer, more modern line; enamel fill adds brand color. Most programs combine engraving on the body with an enamel-filled logo.",
    },
    {
      q: "Can openers be made as keychains or magnets?",
      a: "Yes. The same body can be fitted with a split ring, a leather loop, or a magnetic backing, so one design can serve as a keychain, a fridge magnet, or a bar-mount tool.",
    },
    {
      q: "Do you offer hardwood or leather handles?",
      a: "Yes. Hardwood and leather-wrapped handles are fitted in-house. Handle finish, grain, and engraving depth are confirmed at sample stage.",
    },
    {
      q: "How long does sampling and production take?",
      a: "Sampling takes 5–8 working days after artwork approval. Production of 1,000–5,000 pieces normally runs 12–18 working days, including finishing and packing.",
    },
    {
      q: "Can the hook geometry be customized?",
      a: "The hook is the one part we do not change freely. Depth and angle are set for the standard 26 mm crown cap because that is what most glass bottles use. If you need a different closure — 29 mm crowns, specialty designs, or a can tab — send a sample bottle and we will adjust the tool and test it before production rather than guess.",
    },
    {
      q: "Will it open a can or a twist-off?",
      a: "No. A crown-cap opener lifts a crimped steel cap; it will not open a can, and twist-off caps need to be turned by hand. If a mixed drink program needs both, we can pair the opener with a can-tab tool in the same set.",
    },
  ],
};

const hasProcess = manufacturingProcess.length > 0;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: product.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---
<ProductDetailLayout
  title={product.title}
  description={product.desc}
  ogImage={product.image.src}
  sections={sections}
>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- ============================================================
       HERO — 产品展台 + 开口钩几何图解
       ============================================================ -->

  <section id="hero" class="product-hero">
    <div class="product-hero__grid">
      <div class="product-hero__copy">
        <p class="product-hero__eyebrow">
          CUSTOM {product.title.toUpperCase()}
        </p>

        <h1 class="product-hero__title">{product.heroTitle}</h1>

        <p class="product-hero__desc">{product.desc}</p>

        {product.statement.length > 0 && (
          <div class="product-hero__statement">
            {product.statement.map((line) => (
              <span>{line}</span>
            ))}
          </div>
        )}

        {product.quickFacts.length > 0 && (
          <ul class="product-hero__facts">
            {product.quickFacts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
        )}
      </div>

      <div
        class="opener-stage"
        data-opener-stage
        data-opener-views={JSON.stringify(
          product.views.map(({ key, name, note }) => ({ key, name, note })),
        )}
      >
        <div class="opener-stage__head">
          <span>Product View</span>
          <span>Select a View</span>
        </div>

        <div class="opener-stage__frame">
          {product.views.map((view, index) => (
            <Image
              src={view.image}
              alt={view.alt}
              class:list={["opener-stage__image", { "is-active": index === 0 }]}
              data-opener-stage-img={view.key}
              loading={index === 0 ? "eager" : "lazy"}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1000px) 42vw, 92vw"
            />
          ))}

          <span class="opener-stage__badge">Sized for 26 mm</span>
        </div>

        <div class="opener-stage__tabs">
          {product.views.map((view, index) => (
            <button
              type="button"
              class:list={["opener-stage__tab", { "is-active": index === 0 }]}
              data-opener-stage-tab={view.key}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <strong>{view.name}</strong>
            </button>
          ))}
        </div>

        <div class="opener-stage__caption">
          <p class="opener-stage__caption-head">
            <strong data-opener-stage-name>
              {product.views[0]?.name ?? ""}
            </strong>
          </p>

          <p class="opener-stage__caption-note" data-opener-stage-note>
            {product.views[0]?.note ?? ""}
          </p>
        </div>
      </div>
    </div>

    <!-- 开口钩几何图解 -->
    <div class="hook-geometry">
      <figure class="hook-geometry__figure">
        <svg
          class="hook-geometry__svg"
          viewBox="0 0 320 200"
          role="img"
          aria-label="Hook geometry diagram showing hook depth, lift angle and edge thickness"
        >
          {/* 瓶身 */}
          <rect
            x="16"
            y="66"
            width="196"
            height="28"
            rx="10"
            fill="var(--color-paper)"
            stroke="var(--color-ink)"
            stroke-width="1.5"
          />
          {/* 雕牌位 */}
          <rect
            x="40"
            y="77"
            width="56"
            height="7"
            rx="3.5"
            fill="none"
            stroke="var(--color-gold)"
            stroke-width="1.5"
          />
          {/* 开口钩（J 形） */}
          <path
            d="M212 80 V106 A24 24 0 1 0 236 82"
            fill="none"
            stroke="var(--color-ink)"
            stroke-width="7"
            stroke-linecap="round"
          />
          {/* 皇冠盖 */}
          <circle
            cx="248"
            cy="134"
            r="17"
            fill="var(--color-surface)"
            stroke="var(--color-muted-2)"
            stroke-width="1.5"
          />
          <circle
            cx="248"
            cy="134"
            r="12"
            fill="none"
            stroke="var(--color-muted-2)"
            stroke-width="1"
            stroke-dasharray="3 3"
          />
          {/* 钩深标注 */}
          <path
            d="M268 82 V131"
            stroke="var(--color-gold)"
            stroke-width="1"
            stroke-dasharray="4 4"
          />
          <path
            d="M262 82 H274 M262 131 H274"
            stroke="var(--color-gold)"
            stroke-width="1"
          />
          <text class="hook-geometry__dim" x="272" y="110">
            6–8 mm
          </text>
          {/* 提拉角标注 */}
          <path
            d="M212 98 A20 20 0 0 0 224 84"
            fill="none"
            stroke="var(--color-gold)"
            stroke-width="1"
          />
          <text class="hook-geometry__dim" x="120" y="46">
            15–20° lift angle
          </text>
          {/* 边厚标注 */}
          <path
            d="M16 100 H212"
            stroke="var(--color-gold)"
            stroke-width="1"
            stroke-dasharray="4 4"
          />
          <text class="hook-geometry__dim" x="60" y="118">
            2.0–3.0 mm edge
          </text>
        </svg>
      </figure>

      <ul class="hook-geometry__list">
        {product.hookGeometry.map((item) => (
          <li>
            <span class="hook-geometry__label">{item.label}</span>
            <span class="hook-geometry__value">{item.value}</span>
            <span class="hook-geometry__note">{item.note}</span>
          </li>
        ))}
      </ul>

      <p class="hook-geometry__footnote">
        Sizing is fixed for the standard 26 mm crown cap — every batch is
        test-opened on a real bottle before packing.
      </p>
    </div>
  </section>

  <!-- ============================================================
       I. SPECIFICATIONS — 锁死结构
       ============================================================ -->

  <section id="specifications" class="product-section">
    <div class="product-section__inner">
      <div class="opener-heading">
        <div>
          <p class="product-eyebrow">I · SPECIFICATIONS</p>

          <h2 class="product-section__title">
            A tool first, a gift second.
          </h2>
        </div>

        <p class="product-section__lead">
          The opening hook decides whether the opener works; thickness,
          handle and packaging decide whether anyone keeps it. All of it is
          specified to order.
        </p>
      </div>

      <div class="specs-layout">
        <div class="specs-feature">
          <div class="specs-feature__value">26 mm</div>

          <div class="specs-feature__label">Target Crown Cap</div>

          <div class="specs-feature__line"></div>

          <div class="specs-feature__mark">
            TEST
            <br />
            OPENED
          </div>
        </div>

        <div class="specs-list">
          {product.specs.map((spec, index) => (
            <div class="spec-row">
              <div class="spec-row__number">
                {String(index + 1).padStart(2, "0")}
              </div>

              <div class="spec-row__label">{spec.label}</div>

              <div class="spec-row__value">{spec.value}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       II. FORMATS & PROOF — 三列对比表 + 开盖测试矩阵
       ============================================================ -->

  <section id="formats" class="product-section">
    <div class="product-section__inner">
      <div class="opener-heading">
        <div>
          <p class="product-eyebrow">II · FORMATS &amp; PROOF</p>

          <h2 class="product-section__title">Three formats, one tool.</h2>
        </div>

        <p class="product-section__lead">
          A bar blade, a keychain and a magnetic opener are not variations of
          the same product — they differ in leverage, weight and unit cost.
          Compare them side by side, then check what each one opens.
        </p>
      </div>

      <div class="format-table__scroll">
        <div class="format-table">
          <div class="format-table__head">
            <span class="format-table__corner">Format</span>

            {product.formats.map((format) => (
              <div class="format-table__col">
                <strong>{format.label}</strong>
                <span>{format.tagline}</span>
              </div>
            ))}
          </div>

          {product.formatRows.map((row) => (
            <div
              class:list={[
                "format-table__row",
                { "format-table__row--footer": row.key === "bestFor" },
              ]}
            >
              <span class="format-table__label">{row.label}</span>

              {product.formats.map((format) => (
                <span class="format-table__cell">
                  {(format as Record<string, string>)[row.key]}
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>

      <div class="product-section__subhead">
        <h3>What it opens.</h3>
        <p>
          The hook is sized for the standard 26 mm crown cap. Specialty
          closures are tested before production — never guessed.
        </p>
      </div>

      <div class="opener-proof">
        <div class="cap-matrix">
          <p class="cap-matrix__eyebrow">OPENING TEST · PER FORMAT</p>

          <div class="cap-matrix__grid">
            <span class="cap-matrix__corner" aria-hidden="true"></span>

            {product.capMatrix.caps.map((cap) => (
              <span class="cap-matrix__col-head">{cap}</span>
            ))}

            {product.capMatrix.rows.map((row) => (
              <>
                <span class="cap-matrix__row-head">{row.format}</span>

                {row.levels.map((level) => (
                  <span
                    class:list={["cap-cell", `cap-cell--${level}`]}
                    aria-hidden="true"
                  >
                  </span>
                ))}
              </>
            ))}
          </div>

          <ul class="cap-matrix__key">
            <li>
              <span class="cap-key__swatch cap-key__swatch--3"></span>
              Opens cleanly
            </li>
            <li>
              <span class="cap-key__swatch cap-key__swatch--2"></span>
              Opens with effort
            </li>
            <li>
              <span class="cap-key__swatch cap-key__swatch--1"></span>
              Not suitable
            </li>
          </ul>
        </div>

        <div class="opener-proof__photos">
          {product.proofPhotos.map((photo) => (
            <figure class="opener-proof__photo">
              <Image
                src={photo.image}
                alt={photo.alt}
                loading="lazy"
                widths={[480, 720, 960]}
                sizes="(min-width: 1000px) 26vw, 92vw"
              />
              <figcaption class="opener-proof__photo-label">
                {photo.label}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div class="product-section__note">
        <strong>Crown caps only.</strong>
        A crown-cap opener lifts a crimped steel cap — it will not open a
        can, and twist-offs are turned by hand. Mixed drink programs can pair
        the opener with a can-tab tool in the same set.
      </div>
    </div>
  </section>

  <!-- ============================================================
       III. APPLICATIONS
       ============================================================ -->

  <section id="applications" class="product-section">
    <div class="product-section__inner">
      <div class="opener-heading">
        <div>
          <p class="product-eyebrow">III · APPLICATIONS</p>

          <h2 class="product-section__title">
            Where every gathering needs a pop.
          </h2>
        </div>

        <p class="product-section__lead">
          Openers work best where the brand already has a relationship with
          the occasion — a brewery, a client, a club, a festival. The right
          column is where each one ends up living.
        </p>
      </div>

      <div class="place-list">
        {product.whereItFits.map((item, index) => (
          <article class="place-row">
            <span class="place-row__index">
              {String(index + 1).padStart(2, "0")}
            </span>

            <div class="place-row__body">
              <h3 class="place-row__title">{item.title}</h3>
              <p class="place-row__text">{item.text}</p>
            </div>

            <span class="place-row__tag">{item.place}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       IV. PRODUCTION & QUALITY
       ============================================================ -->

  <section id="production" class="product-section">
    <div class="product-section__inner">
      <div class="opener-heading">
        <div>
          <p class="product-eyebrow">IV · PRODUCTION &amp; QUALITY</p>

          <h2 class="product-section__title">
            From artwork to a tested opener.
          </h2>
        </div>

        <p class="product-section__lead">
          Six controlled steps — and the last one is functional: every batch
          is test-opened on a standard 26 mm crown cap before packing.
        </p>
      </div>

      {hasProcess && (
        <div class="production-strip">
          {manufacturingProcess.map((step) => (
            <article class="production-strip__step">
              <span class="production-strip__dot">{step.step}</span>

              <div class="production-strip__image">
                <Image
                  src={step.image}
                  alt={step.alt}
                  loading="lazy"
                  widths={[360, 540, 720]}
                  sizes="(min-width: 900px) 15vw, 45vw"
                />
              </div>

              <div class="production-strip__body">
                <h3>{step.title}</h3>
                {step.text && <p>{step.text}</p>}
              </div>
            </article>
          ))}
        </div>
      )}

      <div class="product-section__note">
        <strong>Checked before the run starts.</strong>
        100% of pieces are inspected for hook alignment, mark quality and
