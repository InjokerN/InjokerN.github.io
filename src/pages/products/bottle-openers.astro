<script>
  type OpenerWindow = Window & {
    __metalOpenerStageCleanup?: () => void;
  };

  /* ------------------------------------------------------------
     HERO STAGE — Finished piece / Hook detail 切换
     ------------------------------------------------------------ */

  function initOpenerStage() {
    const root = document.querySelector<HTMLElement>("[data-opener-stage]");
    if (!root) return;

    const win = window as OpenerWindow;
    win.__metalOpenerStageCleanup?.();

    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-opener-stage-tab]"),
    );
    const images = Array.from(
      root.querySelectorAll<HTMLElement>("[data-opener-stage-img]"),
    );
    const nameEl = root.querySelector<HTMLElement>(
      "[data-opener-stage-name]",
    );
    const noteEl = root.querySelector<HTMLElement>(
      "[data-opener-stage-note]",
    );

    if (!tabs.length || !images.length) return;

    let views: { key: string; name: string; note: string }[] = [];

    try {
      views = JSON.parse(root.dataset.openerViews ?? "[]");
    } catch {
      return;
    }

    if (!Array.isArray(views) || views.length === 0) return;

    const listeners: { el: HTMLButtonElement; handler: EventListener }[] = [];

    function activate(key: string) {
      const view = views.find((item) => item.key === key);
      if (!view) return;

      tabs.forEach((tab) => {
        const active = tab.dataset.openerStageTab === key;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-pressed", String(active));
      });

      images.forEach((image) => {
        image.classList.toggle("is-active", image.dataset.openerStageImg === key);
      });

      if (nameEl) nameEl.textContent = view.name;
      if (noteEl) noteEl.textContent = view.note;
    }

    tabs.forEach((tab) => {
      const handler: EventListener = () => {
        const key = tab.dataset.openerStageTab;
        if (key) activate(key);
      };

      tab.addEventListener("click", handler);
      listeners.push({ el: tab, handler });
    });

    win.__metalOpenerStageCleanup = () => {
      listeners.forEach(({ el, handler }) =>
        el.removeEventListener("click", handler),
      );
      win.__metalOpenerStageCleanup = undefined;
    };
  }

  function initOpenerPage() {
    initOpenerStage();
  }

  initOpenerPage();

  document.addEventListener("astro:page-load", initOpenerPage);
</script>
