<script>
  type CoinWindow = Window & {
    __metalCoinViewerCleanup?: () => void;
    __metalCoinOptionsCleanup?: () => void;
  };

  /* ------------------------------------------------------------
     HERO VIEWER — Front / Reverse / Edge 切换
     ------------------------------------------------------------ */

  function initCoinViewer() {
    const root = document.querySelector<HTMLElement>("[data-coin-viewer]");
    if (!root) return;

    const win = window as CoinWindow;
    win.__metalCoinViewerCleanup?.();

    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-coin-face]"),
    );
    const stages = Array.from(
      root.querySelectorAll<HTMLElement>("[data-coin-stage]"),
    );
    const badge = root.querySelector<HTMLElement>("[data-coin-badge]");
    const captionName = root.querySelector<HTMLElement>(
      "[data-coin-caption-name]",
    );
    const captionSpec = root.querySelector<HTMLElement>(
      "[data-coin-caption-spec]",
    );
    const captionText = root.querySelector<HTMLElement>(
      "[data-coin-caption-text]",
    );

    if (!tabs.length || !stages.length) return;

    let faces: { key: string; name: string; spec: string; text: string }[] = [];

    try {
      faces = JSON.parse(root.dataset.coinFaces ?? "[]");
    } catch {
      return;
    }

    if (!Array.isArray(faces) || faces.length === 0) return;

    const listeners: { el: HTMLButtonElement; handler: EventListener }[] = [];

    function activate(key: string) {
      const face = faces.find((item) => item.key === key);
      if (!face) return;

      tabs.forEach((tab) => {
        const active = tab.dataset.coinFace === key;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-pressed", String(active));
      });

      stages.forEach((stage) => {
        stage.classList.toggle("is-active", stage.dataset.coinStage === key);
      });

      if (badge) badge.textContent = face.name;
      if (captionName) captionName.textContent = face.name;
      if (captionSpec) captionSpec.textContent = face.spec;
      if (captionText) captionText.textContent = face.text;
    }

    tabs.forEach((tab) => {
      const handler: EventListener = () => {
        const key = tab.dataset.coinFace;
        if (key) activate(key);
      };

      tab.addEventListener("click", handler);
      listeners.push({ el: tab, handler });
    });

    win.__metalCoinViewerCleanup = () => {
      listeners.forEach(({ el, handler }) =>
        el.removeEventListener("click", handler),
      );
      win.__metalCoinViewerCleanup = undefined;
    };
  }

  /* ------------------------------------------------------------
     OPTIONS COMPARE — 工艺选项对比
     ------------------------------------------------------------ */

  function initCoinOptions() {
    const root = document.querySelector<HTMLElement>("[data-coin-options]");
    if (!root) return;

    const win = window as CoinWindow;
    win.__metalCoinOptionsCleanup?.();

    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-coin-option]"),
    );
    const details = Array.from(
      root.querySelectorAll<HTMLElement>("[data-coin-detail]"),
    );

    if (!tabs.length || !details.length) return;

    const listeners: { el: HTMLButtonElement; handler: EventListener }[] = [];

    function activate(key: string) {
      if (!details.some((detail) => detail.dataset.coinDetail === key)) return;

      tabs.forEach((tab) => {
        const active = tab.dataset.coinOption === key;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-pressed", String(active));
      });

      details.forEach((detail) => {
        const active = detail.dataset.coinDetail === key;
        detail.classList.toggle("is-active", active);
        detail.setAttribute("aria-hidden", String(!active));
      });
    }

    tabs.forEach((tab) => {
      const handler: EventListener = () => {
        const key = tab.dataset.coinOption;
        if (key) activate(key);
      };

      tab.addEventListener("click", handler);
      listeners.push({ el: tab, handler });
    });

    win.__metalCoinOptionsCleanup = () => {
      listeners.forEach(({ el, handler }) =>
        el.removeEventListener("click", handler),
      );
      win.__metalCoinOptionsCleanup = undefined;
    };
  }

  function initCoinPage() {
    initCoinViewer();
    initCoinOptions();
  }

  initCoinPage();

  document.addEventListener("astro:page-load", initCoinPage);
</script>
