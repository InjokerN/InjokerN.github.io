---
import { Image } from "astro:assets";
import ProductDetailLayout from "../../components/ProductDetailLayout.astro";

import { manufacturingProcess } from "../../data/manufacturing-process";

/*
  图片说明：
  - Hero 三面（Front / Reverse / Edge）与细节图使用 home/cases 与 products/home
    目录下的挑战币实拍图；工艺示例图使用 crafts 目录；
  - 应用场景图暂沿用 medals 目录占位，待场景图到位后替换。
*/
import coinHero from "../../assets/home/cases/challenge-coins-hero.jpg";
import coinFront from "../../assets/products/home/home-challenge-coin-01.jpg";
import coinReverse from "../../assets/products/home/home-challenge-coin-02.jpg";
import coinEdge from "../../assets/home/cases/challenge-coins-01.jpg";
import coinDetailRelief from "../../assets/home/cases/challenge-coins-02.jpg";
import coinDetailEdge from "../../assets/home/cases/challenge-coins-03.jpg";
import coinUseBrand from "../../assets/home/cases/challenge-coins-04.jpg";
import coinUseEvents from "../../assets/home/cases/challenge-coins-05.jpg";

import coinUseMilitary from "../../assets/products/medals/medal-use-service.jpg";
import coinUseLaw from "../../assets/products/medals/medal-use-community.jpg";
import coinUseCorporate from "../../assets/products/medals/medal-use-corporate.jpg";
import coinUseCommemorative from "../../assets/products/medals/medal-use-collectors.jpg";

import platingColor from "../../assets/crafts/plating-color.jpg";
import hardEnamel from "../../assets/crafts/hard-enamel.jpg";
import glowInTheDark from "../../assets/crafts/glow-in-the-dark.jpg";

/* ============================================================
   SECTIONS — TOC 锚点（Overview 无编号，其后从 I 顺延）
   ============================================================ */

const sections = [
  { id: "hero", number: "", label: "Overview" },
  { id: "specifications", number: "I", label: "Specifications" },
  { id: "design", number: "II", label: "Design & Craft" },
  { id: "applications", number: "III", label: "Applications" },
  { id: "production", number: "IV", label: "Production & Quality" },
  { id: "faq", number: "V", label: "FAQ" },
  { id: "inquiry", number: "VI", label: "Inquiry" },
];

/* ============================================================
   CHALLENGE COINS — PAGE CONTENT
   ============================================================ */

const product = {
  slug: "challenge-coins",
  title: "Challenge Coins",

  image: coinHero,
  alt: "Custom challenge coin with deep 3D relief and premium finish",

  desc: "Custom challenge coins with deep 3D relief, diamond-cut edges, and dual-tone plating — a recognition object designed for military units, first responders, corporate programs, and collectors.",

  heroTitle: "A coin built to be held.",

  heroDesc:
    "Born in military units and carried into boardrooms, the challenge coin is a recognition object with real physical presence. Deep 3D relief, diamond-cut edges, and dual-tone plating — two faces and one edge, designed to be handed over and kept.",

  statement: [
    "Weight in the hand.",
    "Detail on both faces.",
    "A piece worth keeping.",
  ],

  quickFacts: [
    "MOQ 100 pcs per design",
    "Sample 7–10 working days",
    "Thickness 3.0–4.5 mm",
  ],

  faces: [
    {
      key: "front",
      name: "Front",
      spec: "Identity side",
      image: coinFront,
      alt: "Custom challenge coin — front face with raised emblem",
      text: "The primary emblem, unit mark, or logo sits highest in the relief, so the center reads first — in the hand and in photographs. Visual hierarchy is decided on this face.",
    },
    {
      key: "reverse",
      name: "Reverse",
      spec: "Story side",
      image: coinReverse,
      alt: "Custom challenge coin — reverse face detail",
      text: "Values, dates, engraved text, or serial numbers carry the supporting message. The reverse is planned as part of the same visual system — never filler.",
    },
    {
      key: "edge",
      name: "Edge",
      spec: "The third face",
      image: coinEdge,
      alt: "Custom challenge coin — edge treatment detail",
      text: "Diamond-cut, reeded, smooth, or engraved — the perimeter sets the sense of mass the moment the coin is picked up, and adds a second layer of detail.",
    },
  ],

  specs: [
    {
      label: "Typical Size",
      value: "38–50 mm diameter (1.5\"–2.0\")",
    },
    {
      label: "Thickness",
      value: "3.0–4.5 mm, tailored for hand feel",
    },
    {
      label: "Material",
      value: "Zinc alloy, brass, copper",
    },
    {
      label: "Plating",
      value: "Gold, silver, bronze, antique, black nickel, dual-tone",
    },
    {
      label: "Front",
      value: "3D relief + enamel / print / engraving",
    },
    {
      label: "Reverse",
      value: "3D relief, engraved text, or serial-numbered",
    },
    {
      label: "Edge",
      value: "Diamond cut, reeded, smooth, or engraved",
    },
    {
      label: "Color Fill",
      value: "Soft enamel, hard enamel, or offset print",
    },
    {
      label: "Packaging",
      value: "OPP bag, velvet pouch, coin capsule, presentation box",
    },
  ],

  craftRoutes: [
    {
      key: "die-cast",
      name: "Die-Cast",
      tag: "Zinc alloy · fine detail",
      text: "Molten zinc alloy is injected into the mold under pressure, capturing fine lines, small text, and complex shapes at a lower unit weight and cost.",
      bestFor: "Best for detailed artwork, larger diameters, and larger runs.",
    },
    {
      key: "die-struck",
      name: "Die-Struck",
      tag: "Brass / copper · deeper relief",
      text: "A metal blank is struck between dies under high pressure, producing a denser, heavier coin with deeper relief and a crisper edge.",
      bestFor: "Best for maximum weight, deep 3D relief, and premium feel.",
    },
  ],

  options: [
    {
      key: "relief",
      number: "01",
      name: "3D Relief",
      tag: "Depth first",
      image: coinDetailRelief,
      alt: "Custom challenge coin with deep 3D relief detail",
      summary:
        "The central emblem is raised above the field so it reads as the visual anchor and catches light on its own.",
      construction:
        "Artwork is separated into relief layers — raised emblem, recessed field, text, and edge details — before the mold is cut.",
      strengths:
        "Depth survives photography and handling; the coin reads as a physical object rather than a printed token.",
      considerations:
        "Deeper relief needs a thicker coin and finer metal flow at the edges; extremely fine detail may need to move to the reverse.",
    },
    {
      key: "edge",
      number: "02",
      name: "Edge Treatment",
      tag: "The third face",
      image: coinDetailEdge,
      alt: "Custom challenge coin edge treatment close-up",
      summary:
        "The perimeter is a design surface in its own right — diamond cut, reeded, smooth, or engraved.",
      construction:
        "The rim is machined or engraved after forming: a reeded or diamond-cut pattern, a polished band, or text and numbers.",
      strengths:
        "Adds grip, a second layer of detail, and visible mass from any angle.",
      considerations:
        "Engraved edges suit shorter runs and add handling time; fine reeded patterns show handling wear faster than a polished rim.",
    },
    {
      key: "plating",
      number: "03",
      name: "Plating & Contrast",
      tag: "Light and shadow",
      image: platingColor,
      alt: "Challenge coin plating and contrast finish example",
      summary:
        "Antique recesses with polished raised areas, or true dual-tone finishes that separate the layers.",
      construction:
        "Gold, silver, bronze, black nickel, or dual-tone plating, polished by hand or machine to leave antique in the recesses.",
      strengths:
        "Contrast makes relief readable without extra color; dual-tone suits emblem-plus-field designs.",
      considerations:
        "Antique finishes vary slightly piece to piece — a normal character of the process; polished highs need careful packing to avoid scratches.",
    },
    {
      key: "enamel",
      number: "04",
      name: "Color Fill",
      tag: "Soft vs hard enamel",
      image: hardEnamel,
      alt: "Challenge coin hard enamel color fill example",
      summary:
        "Soft enamel keeps the raised metal lines visible; hard enamel gives a smooth, polished surface; offset print handles gradients and fine detail.",
      construction:
        "Soft enamel sits recessed below the metal lines; hard enamel is ground flush and polished; print is cured onto the surface.",
      strengths:
        "Soft enamel is brighter and sportier; hard enamel feels premium; print covers artwork that enamel cannot.",
      considerations:
        "Hard enamel costs more and suits simpler color blocks; printed colors shift slightly between batches.",
    },
    {
      key: "special",
      number: "05",
      name: "Special Finishes",
      tag: "Beyond the standard",
      image: glowInTheDark,
      alt: "Challenge coin glow-in-the-dark special finish example",
      summary:
        "Glow-in-the-dark, glitter, epoxy domes, cutouts, and serial-numbered editions for collectible runs.",
      construction:
        "Additive layers are applied after plating — luminous or glitter fills, epoxy for a glossy dome, laser-cut openings, laser-engraved numbering.",
      strengths:
        "Makes limited editions, fundraiser pieces, and fan coins feel genuinely collectible.",
      considerations:
        "Special effects add process steps and unit cost; luminous and glitter fills should be checked against intended handling and packaging.",
    },
  ],

  whereItFits: [
    {
      title: "Military & Units",
      text: "Unit coins, deployment coins, commander's coins, and branch anniversaries — the tradition the format was born in.",
      tags: ["Deployment", "Commander's Coin", "Anniversary"],
      image: coinUseMilitary,
      alt: "Custom challenge coin for military units",
    },
    {
      title: "Law Enforcement & First Responders",
      text: "Police, fire, and EMS coins for recognition, promotion, memorials, and academy graduation.",
      tags: ["Recognition", "Promotion", "Memorial"],
      image: coinUseLaw,
      alt: "Custom challenge coin for law enforcement and first responders",
    },
    {
      title: "Corporate Recognition",
      text: "Employee milestones, executive gifts, sales awards, and brand-identity coins that carry a company mark into the field.",
      tags: ["Milestones", "Executive Gifts", "Sales Awards"],
      image: coinUseCorporate,
      alt: "Custom challenge coin for corporate recognition",
    },
    {
      title: "Commemorative Editions",
      text: "Anniversaries, retirements, and memorial pieces — often serial-numbered for a limited run.",
      tags: ["Anniversary", "Retirement", "Limited Run"],
      image: coinUseCommemorative,
      alt: "Custom commemorative challenge coin edition",
    },
    {
      title: "Brand & Fan Merchandise",
      text: "Collector coins for sports teams, esports organizations, fan communities, and pop-culture releases.",
      tags: ["Collectible", "Esports", "Pop Culture"],
      image: coinUseBrand,
      alt: "Custom challenge coin for brand and fan merchandise",
    },
    {
      title: "Events & Challenges",
      text: "Event coins, fundraiser pieces, and membership coins that mark a shared experience.",
      tags: ["Event Coins", "Fundraiser", "Membership"],
      image: coinUseEvents,
      alt: "Custom challenge coin for events and challenges",
    },
  ],

  qualityChecks: [
    "Approved front and reverse artwork",
    "Relief depth and edge profile sample",
    "Plating and enamel color match",
    "Serial numbering accuracy",
    "Packaging and quantity specification",
  ],

  faq: [
    {
      q: "What is the minimum order quantity?",
      a: "Our standard MOQ is 100 pieces per design. For test orders, we can accept 50 pieces with a small surcharge.",
    },
    {
      q: "How long does sampling take?",
      a: "Sampling normally takes 7–10 working days after artwork approval, depending on design complexity and finishing requirements.",
    },
    {
      q: "Can both sides be fully custom-designed?",
      a: "Yes. Front and reverse are treated as one system. Each side can carry its own relief, enamel fill, engraved text, and plating treatment.",
    },
    {
      q: "What edge treatments are available?",
      a: "Common options include diamond cut (reeded), smooth polished, hand-finished antique, and engraved edges with serial numbers or unit text.",
    },
    {
      q: "What is the difference between soft and hard enamel?",
      a: "Soft enamel leaves the raised metal lines visible and reads brighter and sportier. Hard enamel is ground flush and polished for a smooth, premium surface. Offset printing is also available for gradients and fine detail.",
    },
    {
      q: "Can we add serial numbers or individual engraving?",
      a: "Yes. Serial numbers, names, and unique text can be engraved on the edge or reverse face — either as part of the mold, or as post-production laser engraving.",
    },
    {
      q: "What thickness is best for a challenge coin?",
      a: "Most challenge coins fall between 3.0 mm and 4.5 mm. The right thickness depends on how much physical presence you want in the hand — thicker coins feel more substantial, but weigh more per unit.",
    },
    {
      q: "What packaging options are available?",
      a: "Standard packing is individual OPP bags. Velvet pouches, coin capsules, and presentation boxes are available for retail, gift, and commemorative programs.",
    },
  ],
};

const hasProcess = manufacturingProcess.length > 0;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: product.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---
<ProductDetailLayout
  title={product.title}
  description={product.desc}
  ogImage={product.image.src}
  sections={sections}
>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- ============================================================
       HERO — 三面展台 (Front / Reverse / Edge)
       ============================================================ -->

  <section id="hero" class="product-hero">
    <div class="product-hero__grid">
      <div class="product-hero__copy">
        <p class="product-hero__eyebrow">
          CUSTOM {product.title.toUpperCase()}
        </p>

        <h1 class="product-hero__title">{product.heroTitle}</h1>

        <p class="product-hero__desc">{product.heroDesc}</p>

        {product.statement.length > 0 && (
          <div class="product-hero__statement">
            {product.statement.map((line) => (
              <span>{line}</span>
            ))}
          </div>
        )}

        {product.quickFacts.length > 0 && (
          <ul class="product-hero__facts">
            {product.quickFacts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
        )}
      </div>

      <div
        class="coin-viewer"
        data-coin-viewer
        data-coin-faces={JSON.stringify(
          product.faces.map(({ key, name, spec, text }) => ({
            key,
            name,
            spec,
            text,
          })),
        )}
      >
        <div class="coin-viewer__head">
          <span>Coin Viewer</span>
          <span>Select a Face</span>
        </div>

        <div class="coin-viewer__stage">
          {product.faces.map((face, index) => (
            <Image
              src={face.image}
              alt={face.alt}
              class:list={["coin-viewer__image", { "is-active": index === 0 }]}
              data-coin-stage={face.key}
              loading={index === 0 ? "eager" : "lazy"}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1000px) 42vw, 92vw"
            />
          ))}

          <span class="coin-viewer__badge" data-coin-badge>
            {product.faces[0]?.name ?? ""}
          </span>
        </div>

        <div
          class="coin-viewer__tabs"
          role="group"
          aria-label="Coin face selector"
        >
          {product.faces.map((face, index) => (
            <button
              type="button"
              class:list={["coin-viewer__tab", { "is-active": index === 0 }]}
              data-coin-face={face.key}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <strong>{face.name}</strong>
              <span>{face.spec}</span>
            </button>
          ))}
        </div>

        <div class="coin-viewer__caption" data-coin-caption>
          <p class="coin-viewer__caption-head">
            <strong data-coin-caption-name>
              {product.faces[0]?.name ?? ""}
            </strong>
            <span data-coin-caption-spec>
              {product.faces[0]?.spec ?? ""}
            </span>
          </p>

          <p class="coin-viewer__caption-text" data-coin-caption-text>
            {product.faces[0]?.text ?? ""}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       I. SPECIFICATIONS — 锁死结构（specs-layout / specs-feature / spec-row）
       ============================================================ -->

  <section id="specifications" class="product-section">
    <div class="product-section__inner">
      <div class="coin-heading">
        <div>
          <p class="product-eyebrow">I · SPECIFICATIONS</p>

          <h2 class="product-section__title">Built to be held.</h2>
        </div>

        <p class="product-section__lead">
          Diameter, thickness, plating, edge — every dimension on a challenge
          coin is part of how it feels in the hand. Each one can be tailored
          to your project.
        </p>
      </div>

      <div class="specs-layout">
        <div class="specs-feature">
          <div class="specs-feature__value">
            {product.specs[1]?.value.split(",")[0] ?? "3.0–4.5 mm"}
          </div>

          <div class="specs-feature__label">
            {product.specs[1]?.label ?? "Coin Thickness"}
          </div>

          <div class="specs-feature__line"></div>

          <div class="specs-feature__mark">
            CUSTOM
            <br />
            MADE
          </div>
        </div>

        <div class="specs-list">
          {product.specs.map((spec, index) => (
            <div class="spec-row">
              <div class="spec-row__number">
                {String(index + 1).padStart(2, "0")}
              </div>

              <div class="spec-row__label">{spec.label}</div>

              <div class="spec-row__value">{spec.value}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       II. DESIGN & CRAFT — 自由定制区（三面解剖 + 工艺对比）
       ============================================================ -->

  <section id="design" class="product-section">
    <div class="product-section__inner">
      <div class="coin-heading">
        <div>
          <p class="product-eyebrow">II · DESIGN &amp; CRAFT</p>

          <h2 class="product-section__title">Three surfaces. One object.</h2>
        </div>

        <p class="product-section__lead">
          A challenge coin is judged from every angle — front face, reverse
          face, and edge. We plan all three as a single physical object, then
          choose the finishes that make the relief readable.
        </p>
      </div>

      <div class="product-section__subhead">
        <h3>Two ways to build the coin.</h3>
        <p>
          Before finishes, the manufacturing route is chosen. Both methods
          hold fine detail — they differ in weight, relief depth, and how
          the finished coin feels in the hand.
        </p>
      </div>

      <div class="coin-routes">
        {product.craftRoutes.map((item, index) => (
          <article class="coin-route">
            <div class="coin-route__head">
              <span class="coin-route__number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="coin-route__tag">{item.tag}</span>
            </div>

            <h3>{item.name}</h3>

            <p class="coin-route__text">{item.text}</p>

            <p class="coin-route__best">{item.bestFor}</p>
          </article>
        ))}
      </div>

      <div class="product-section__subhead">
        <h3>Choose the finishes.</h3>
        <p>
          Five decisions shape how the coin reads — relief depth, edge
          treatment, plating contrast, color fill, and special effects.
          Review each option before committing to a specification.
        </p>
      </div>

      <div class="coin-options" data-coin-options>
        <div class="coin-options__rail" role="group" aria-label="Finish options">
          {product.options.map((item, index) => (
            <button
              type="button"
              class:list={["coin-option-tab", { "is-active": index === 0 }]}
              data-coin-option={item.key}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <span class="coin-option-tab__thumb">
                <Image
                  src={item.image}
                  alt=""
                  loading="lazy"
                  widths={[120, 180, 240]}
                  sizes="64px"
                />
                <span class="coin-option-tab__number">{item.number}</span>
              </span>

              <span class="coin-option-tab__copy">
                <strong>{item.name}</strong>
                <span>{item.tag}</span>
              </span>

              <span class="coin-option-tab__arrow" aria-hidden="true">
                ↗
              </span>
            </button>
          ))}
        </div>

        <div class="coin-option-list">
          {product.options.map((item, index) => (
            <article
              class:list={["coin-option-detail", { "is-active": index === 0 }]}
              data-coin-detail={item.key}
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <div class="coin-option-detail__media">
                <Image
                  src={item.image}
                  alt={item.alt}
                  loading="lazy"
                  widths={[720, 1080, 1400]}
                  sizes="(min-width: 1000px) 46vw, 92vw"
                />
                <span class="coin-option-detail__index">
                  {item.number} / 05
                </span>
              </div>

              <div class="coin-option-detail__top">
                <p class="coin-option-detail__eyebrow">OPTION {item.number}</p>
                <span class="coin-option-detail__tag">{item.tag}</span>
              </div>

              <h3>{item.name}</h3>

              <p class="coin-option-detail__summary">{item.summary}</p>

              <dl class="coin-option-detail__facts">
                <div>
                  <dt>Construction</dt>
                  <dd>{item.construction}</dd>
                </div>

                <div>
                  <dt>Why choose it</dt>
                  <dd>{item.strengths}</dd>
                </div>

                <div>
                  <dt>Considerations</dt>
                  <dd>{item.considerations}</dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       III. APPLICATIONS
       ============================================================ -->

  <section id="applications" class="product-section">
    <div class="product-section__inner">
      <div class="coin-heading">
        <div>
          <p class="product-eyebrow">III · APPLICATIONS</p>

          <h2 class="product-section__title">Where coins carry meaning.</h2>
        </div>

        <p class="product-section__lead">
          From unit identity to fan merchandise — a challenge coin works best
          when it stands for something the owner wants to carry, hand over,
          or keep.
        </p>
      </div>

      <div class="coin-programs">
        {product.whereItFits.map((item, index) => (
          <article class="coin-program">
            <div class="coin-program__thumb">
              <Image
                src={item.image}
                alt={item.alt}
                loading="lazy"
                widths={[180, 260, 360]}
                sizes="(min-width: 900px) 88px, 72px"
              />
            </div>

            <div class="coin-program__body">
              <div class="coin-program__top">
                <span class="coin-program__number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <h3>{item.title}</h3>
              </div>

              <p>{item.text}</p>

              <ul class="coin-program__tags">
                {item.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       IV. PRODUCTION & QUALITY
       ============================================================ -->

  <section id="production" class="product-section">
    <div class="product-section__inner">
      <div class="coin-heading">
        <div>
          <p class="product-eyebrow">IV · PRODUCTION &amp; QUALITY</p>

          <h2 class="product-section__title">
            From artwork to a coin with real depth.
          </h2>
        </div>

        <p class="product-section__lead">
          A controlled six-step process — from your first artwork to the
          finished, inspected coin. The unplated blank is checked for relief
          before plating, because depth cannot be fixed later.
        </p>
      </div>

      {hasProcess && (
        <div class="production-strip">
          {manufacturingProcess.map((step) => (
            <article class="production-strip__step">
              <span class="production-strip__dot">{step.step}</span>

              <div class="production-strip__image">
                <Image
                  src={step.image}
                  alt={step.alt}
                  loading="lazy"
                  widths={[360, 540, 720]}
                  sizes="(min-width: 900px) 15vw, 45vw"
                />
              </div>

              <div class="production-strip__body">
                <h3>{step.title}</h3>
                {step.text && <p>{step.text}</p>}
              </div>
            </article>
          ))}
        </div>
      )}

      <div class="coin-quality">
        <div class="coin-quality__heading">
          <p class="product-eyebrow">BEFORE DISPATCH</p>

          <h3>Confirm the details that matter.</h3>
        </div>

        <ul class="coin-quality__checks">
          {product.qualityChecks.map((check) => (
            <li>
              <span aria-hidden="true">✓</span>
              <span>{check}</span>
            </li>
          ))}
        </ul>
      </div>

