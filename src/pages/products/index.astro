---
/*
  PAGE  : /products
  FILE  : src/pages/products/index.astro
  ROLE  : 产品列表页 — 展示全部产品品类、下单流程、定制选项与 CTA
*/
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import craftsDataRaw from "../../data/crafts";
import { products } from "../../data/products";

import idea from "../../assets/how-to-order/idea.jpg";
import quote from "../../assets/how-to-order/quote.jpg";
import confirm from "../../assets/how-to-order/confirm.jpg";
import production from "../../assets/how-to-order/production.jpg";
import delivery from "../../assets/how-to-order/delivery.jpg";

/* 产品列表：拆成旗舰 + 网格 */
const featuredProducts = products.filter((p) => p.featured);
const gridProducts = products.filter((p) => !p.featured);

/* Craft tabs 排序：Craft → Add-on → Package → Plating */
const panelOrder = ["craft", "addon", "package", "plating"];
const craftsData = [...craftsDataRaw].sort((a, b) => {
  return panelOrder.indexOf(a.panel) - panelOrder.indexOf(b.panel);
});

/* How to Order 5 步 */
const orderSteps = [
  {
    step: "01",
    title: "Share Your Idea",
    text: "Send us your artwork, reference, quantity, size, or deadline.",
    image: idea,
    alt: "Custom medal project reference",
  },
  {
    step: "02",
    title: "Get a Quote",
    text: "We review the requirements and confirm suitable options, pricing, and timing.",
    image: quote,
    alt: "Custom medal project example",
  },
  {
    step: "03",
    title: "Approve the Proof",
    text: "A free artwork proof, revised until the layout is right. Nothing is cut before you sign off.",
    image: confirm,
    alt: "Custom medal design detail",
  },
  {
    step: "04",
    title: "Sample",
    text: "A physical sample in 7 days, so you can check the finish and weight in hand.",
    image: production,
    alt: "Metal plating and finishing during production",
  },
  {
    step: "05",
    title: "Production & Shipping",
    text: "Bulk run, inspection, packing and worldwide delivery.",
    image: delivery,
    alt: "Presentation packaging for a custom metal product",
  },
];
---

<BaseLayout
  title="Custom Metal Products — CM Crafts & Gifts"
  description="Browse every category we make — medals, challenge coins, enamel pins, keychains and more. No MOQ, free design and proof, 7-day samples."
  ogImage="/image/og-products.jpg"
>
  <main class="products-page">
    <section class="products-hero">
      <div class="products-container">
        <div class="products-hero__inner">
          <p class="products-hero__eyebrow">PRODUCT CATALOG</p>

          <h1 class="products-hero__title">
            Every category.
            <br />
            <em>Every craft.</em>
          </h1>

          <p class="products-hero__subtitle">
            Every category we make, in one place — all from the same workshop.
          </p>

          <ul class="products-hero__trust">
            <li>ISO 9001:2015</li>
            <li>Free design &amp; proof</li>
            <li>No MOQ</li>
            <li>7-day samples</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="products-list" id="products">
      <div class="products-container">
        <div class="products-list__header">
          <div>
            <p class="eyebrow">WHAT WE MAKE</p>
            <h2>Choose the product for your project.</h2>

            <p class="products-list__desc">
              Pick a category to see its options, specifications, process and
              recent projects.
            </p>
          </div>
        </div>

        {featuredProducts.length > 0 && (
          <div class="flagship-list">
            {featuredProducts.map((product) => (
              <a href={`/products/${product.slug}`} class="flagship-card">
                <div class="flagship-card__body">
                  <h3>{product.title}</h3>
                  <p>{product.desc}</p>

                  <ul class="flagship-card__tags">
                    {product.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>

                  <span class="flagship-card__cta">
                    View product <span aria-hidden="true">→</span>
                  </span>
                </div>

                <div class="flagship-card__media">
                  <div class="flagship-card__media-cell">
                    <Image
                      src={product.image}
                      alt={product.alt}
                      loading="lazy"
                      widths={[420, 640, 840]}
                      sizes="(min-width: 1024px) 22vw, 45vw"
                    />
                  </div>

                  {product.featuredImage2 && (
                    <div class="flagship-card__media-cell">
                      <Image
                        src={product.featuredImage2}
                        alt=""
                        loading="lazy"
                        widths={[420, 640, 840]}
                        sizes="(min-width: 1024px) 22vw, 45vw"
                      />
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        )}

        {gridProducts.length > 0 && (
          <div class="product-grid">
            {gridProducts.map((product) => (
              <a href={`/products/${product.slug}`} class="product-card">
                <div class="product-card__media">
                  <Image
                    src={product.image}
                    alt={product.alt}
                    loading="lazy"
                    widths={[400, 600, 800]}
                    sizes="(min-width: 1024px) 28vw, (min-width: 640px) 45vw, 90vw"
                  />
                </div>

                <div class="product-card__body">
                  <h4>{product.title}</h4>
                  <p>{product.desc}</p>

                  <ul class="product-card__tags">
                    {product.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>

                  <span class="product-card__cta">
                    View more <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="order-process" id="how-to-order">
      <div class="products-container">
        <div class="order-process__header">
          <p class="eyebrow">HOW TO ORDER</p>
          <h2>From your idea to the finished product.</h2>

          <p class="order-process__desc">
            Five steps, each with something you approve before the next one
            starts.
          </p>
        </div>

        <div class="order-process__timeline">
          {orderSteps.map((step, index) => (
            <article
              class:list={[
                "order-step",
                index === 0 && "is-first",
                index === 4 && "is-last",
              ]}
            >
              <div class="order-step__media">
                <Image src={step.image} alt={step.alt} loading="lazy" />
              </div>

              <div class="order-step__content">
                <span class="order-step__number">{step.step}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>

              {index < 4 && (
                <div class="order-step__connector" aria-hidden="true">
                  <span></span>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="craft-hub" id="crafts">
      <div class="products-container">
        <div class="craft-hub__header">
          <div class="craft-hub__header-top">
            <div class="craft-hub__copy">
              <p class="eyebrow">CUSTOMIZATION</p>
              <h2>Make the product your own.</h2>

              <p class="craft-hub__desc">
                Choose from different crafts, finishes, add-ons, and packaging
                options to build a product around your design.
              </p>
            </div>

            <a href="/resources" class="craft-hub__resource-btn">
              <span class="craft-hub__resource-label">
                Explore Resource Guides
                <span aria-hidden="true">→</span>
              </span>
            </a>
          </div>

          <div class="craft-tabs" role="tablist">
            {craftsData.map((item, index) => (
              <button
                type="button"
                class:list={["craft-tab-btn", index === 0 && "is-active"]}
                data-craft-tab={item.panel}
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`craft-panel-${item.panel}`}
                id={`craft-tab-${item.panel}`}
                tabindex={index === 0 ? 0 : -1}
              >
                {item.title}
              </button>
            ))}
          </div>
        </div>

        <div class="craft-panels">
          {craftsData.map((panel, index) => (
            <div
              class:list={["craft-panel", index === 0 && "is-active"]}
              data-panel-content={panel.panel}
              role="tabpanel"
              id={`craft-panel-${panel.panel}`}
              aria-labelledby={`craft-tab-${panel.panel}`}
              tabindex="0"
            >
              {panel.type === "cards" && panel.cards && (
                <div class="craft-cards-grid">
                  {panel.cards.map((card) => (
                    <div class="craft-card">
                      <div class="craft-card__img">
                        <Image
                          src={card.image}
                          alt={card.alt}
                          loading="lazy"
                          widths={[400, 600, 800, 1000]}
                          sizes="(min-width: 900px) 280px, (min-width: 540px) 45vw, 90vw"
                        />
                      </div>

                      <div class="craft-card__body">
                        <h3>{card.title}</h3>
                        <p>{card.text}</p>
                      </div>
                    </div>
                  ))}
                </div>
              )}

              {panel.layout === "package" && (
                <div class="craft-package-wrap">
                  <div class="package-section">
                    <span class="package-section__label">
                      Packaging &amp; Protection
                    </span>

                    <div class="package-grid package-grid--top">
                      {panel.cardsTop?.map((card) => (
                        <div class="package-card">
                          <div class="package-card__img">
                            <Image
                              src={card.image}
                              alt={card.alt}
                              loading="lazy"
                              widths={[400, 600, 800, 1000]}
                              sizes="(min-width: 900px) 280px, (min-width: 540px) 45vw, 90vw"
                            />
                          </div>

                          <h4>{card.title}</h4>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="package-section">
                    <span class="package-section__label">
                      Ceremony & Presentation Boxes
                    </span>

                    <div class="package-grid package-grid--bottom">
                      {panel.cardsBottom?.map((card) => (
                        <div class="package-card">
                          <div class="package-card__img">
                            <Image
                              src={card.image}
                              alt={card.alt}
                              loading="lazy"
                              widths={[400, 600, 800, 1000]}
                              sizes="(min-width: 900px) 280px, (min-width: 540px) 45vw, 90vw"
                            />
                          </div>

                          <h4>{card.title}</h4>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}

              {panel.type === "image" && panel.image && (
                <div class="craft-plating-showcase">
                  <div class="craft-plating-frame">
                    <Image
                      src={panel.image}
                      alt={panel.alt ?? ""}
                      loading="lazy"
                      widths={[800, 1200, 1600, 2000]}
                      sizes="(min-width: 1180px) 1040px, 88vw"
                    />
                  </div>

                  <div class="craft-plating-footer">
                    <p class="craft-plating-caption">
                      Standard platings include shiny gold, silver and bronze,
                      antique, satin matte, and dual-tone.
                    </p>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="site-cta">
      <div class="site-cta__circle" aria-hidden="true"></div>

      <div class="site-cta__inner">
        <p class="site-cta__eyebrow">HAVE SOMETHING IN MIND?</p>

        <h2>
          Let's make
          <br />
          something worth keeping.
        </h2>

        <p class="site-cta__desc">
          Send artwork, quantity, size and deadline — you'll get options,
          tooling cost and a lead time in one reply.
        </p>

        <a
          href="#contact"
          class="cta-button"
          data-modal-open
          data-modal-product="Products overview"
        >
          Start Your Project
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  function initCraftTabs() {
    const hub = document.getElementById("crafts");
    if (!hub || hub.dataset.bound === "true") return;
    hub.dataset.bound = "true";

    const buttons = Array.from(
      hub.querySelectorAll<HTMLButtonElement>("[data-craft-tab]"),
    );
    const panels = Array.from(
      hub.querySelectorAll<HTMLElement>("[data-panel-content]"),
    );

    function activate(target: string) {
      buttons.forEach((b) => {
        const on = b.dataset.craftTab === target;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
        b.tabIndex = on ? 0 : -1;
      });

      panels.forEach((p) =>
        p.classList.toggle("is-active", p.dataset.panelContent === target),
      );
    }

    buttons.forEach((btn, index) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.craftTab;
        if (!target) return;
        activate(target);
        history.replaceState(null, "", `#crafts-${target}`);
      });

      btn.addEventListener("keydown", (event) => {
        let next = -1;

        if (event.key === "ArrowRight") next = (index + 1) % buttons.length;
        else if (event.key === "ArrowLeft")
          next = (index - 1 + buttons.length) % buttons.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = buttons.length - 1;

        if (next >= 0) {
          event.preventDefault();

          const nextBtn = buttons[next];
          nextBtn.focus();

          const target = nextBtn.dataset.craftTab;
          if (target) {
            activate(target);
            history.replaceState(null, "", `#crafts-${target}`);
          }
        }
      });
    });

    const hash = window.location.hash;
    if (hash.startsWith("#crafts-")) {
      const target = hash.replace("#crafts-", "");
      if (buttons.some((b) => b.dataset.craftTab === target)) {
        activate(target);
      }
    }
  }

  initCraftTabs();
  document.addEventListener("astro:page-load", initCraftTabs);
</script>

<style>
  .products-page {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .products-page *,
  .products-page *::before,
  .products-page *::after {
    box-sizing: border-box;
  }

  .products-container {
    width: var(--container-width);
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--color-gold-dark);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* ---------- HERO ---------- */
  .products-hero {
    padding: calc(var(--nav-h) + var(--hero-gap)) 0 96px;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    text-align: center;
  }

  .products-hero__inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .products-hero__eyebrow {
    margin: 0 0 24px;
    color: var(--color-gold);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .products-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(52px, 6.5vw, 88px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--color-ink);
  }

  .products-hero__title em {
    color: var(--color-gold);
    font-style: normal;
  }

  .products-hero__subtitle {
    max-width: 620px;
    margin: 30px auto 0;
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  .products-hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 26px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .products-hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .products-hero__trust li::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-gold);
  }

  /* ---------- PRODUCT LIST ---------- */
  .products-list {
    padding: 54px 0;
    background: var(--color-paper);
  }

  .products-list__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 40px;
  }

  .products-list__header h2 {
    max-width: 820px;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .products-list__desc {
    max-width: 650px;
    margin: 18px 0 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .products-count {
    padding-bottom: 7px;
    color: var(--color-muted-2);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    flex-shrink: 0;
  }

  /* ---------- 旗舰卡 ---------- */
  .flagship-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }

  .flagship-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 320px;
    padding: 8px;
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--ease-out),
      box-shadow var(--ease-out),
      border-color var(--ease-out);
  }

  .flagship-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-panel);
    border-color: var(--color-gold);
  }

  .flagship-card__body {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .flagship-card__body h3 {
    margin: 0 0 12px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(26px, 2.4vw, 32px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .flagship-card__body p {
    max-width: 400px;
    margin: 0 0 20px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .flagship-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    padding: 0;
    margin: 0 0 20px;
    list-style: none;
  }

  .flagship-card__tags li {
    padding: 5px 10px;
    border: 1px solid var(--color-line);
    background: var(--color-white);
    color: var(--color-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 999px;
  }

  .flagship-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      color var(--ease-out),
      gap var(--ease-out);
  }

  .flagship-card__cta span {
    color: var(--color-gold);
    font-size: 16px;
  }

  .flagship-card:hover .flagship-card__cta {
    color: var(--color-gold);
    gap: 16px;
  }

  .flagship-card__media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    background: transparent;
    min-width: 0;
  }

  .flagship-card__media-cell {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .flagship-card__media-cell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--ease-slow);
  }

  .flagship-card:hover .flagship-card__media-cell img {
    transform: scale(1.03);
  }

  /* ---------- 普通产品网格 ---------- */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    padding: 8px;
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition:
      transform var(--ease-out),
      box-shadow var(--ease-out),
      border-color var(--ease-out);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-panel);
    border-color: var(--color-gold);
  }

  .product-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .product-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--ease-slow);
  }

  .product-card:hover .product-card__media img {
    transform: scale(1.04);
  }

  .product-card__body {
    padding: 20px 16px 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-card__body h4 {
    margin: 0 0 10px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    transition: color var(--ease-out);
  }

  .product-card:hover .product-card__body h4 {
    color: var(--color-gold);
  }

  .product-card__body p {
    margin: 0 0 18px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .product-card__tags li {
    padding: 5px 9px;
    border: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 999px;
  }

  .product-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 18px;
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
