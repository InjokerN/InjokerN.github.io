    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .route-card__rows dd {
    margin: 0;
    color: var(--ink);
    font-size: 12px;
    font-weight: 600;
    text-align: right;
  }

  .route-note {
    margin-top: 20px;
    padding: 20px 24px;
    background: var(--dark);
    border-radius: var(--radius-lg);
