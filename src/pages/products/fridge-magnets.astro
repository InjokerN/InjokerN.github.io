    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .product-section__lead {
    margin: 0;
  }

  .product-section__subhead-title {
    margin: clamp(44px, 5vw, 64px) 0 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .product-section__subhead-lead {
    max-width: 640px;
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .product-section__note {
    max-width: 840px;
    margin: 44px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
    line-height: 1.85;
  }

  .product-section__note strong {
    display: block;
    margin-bottom: 8px;
    color: var(--ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ============================================================
     HERO
     ============================================================ */

  .fm-hero {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(0, 1.18fr);
