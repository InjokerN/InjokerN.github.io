  }

  .fm-hero__copy {
    min-width: 0;
    max-width: 470px;
  }

  .fm-hero__eyebrow {
    margin: 0 0 20px;
    color: var(--gold);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .fm-hero__title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(38px, 5vw, 64px);
