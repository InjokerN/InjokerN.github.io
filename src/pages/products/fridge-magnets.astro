    font-size: 13px;
    line-height: 1.75;
  }

  .route-note strong {
    display: block;
    margin-bottom: 6px;
    color: var(--gold2);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

