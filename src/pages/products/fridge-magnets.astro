    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .craft-panel__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--paper2);
  }

  .craft-panel__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .craft-panel__index {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 4px 9px;
    background: var(--paper2);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .craft-panel__body {
    flex: 1;
    padding: 26px 24px 28px;
  }

  .craft-panel--light .craft-panel__body {
    background: var(--paper2);
  }

  .craft-panel--dark .craft-panel__body {
    background: var(--dark);
  }

  .craft-panel__body h3 {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .craft-panel--light .craft-panel__body h3 {
    color: var(--ink);
  }

  .craft-panel--dark .craft-panel__body h3 {
    color: var(--gold2);
  }

  .craft-panel__body > p {
    margin: 0;
    font-size: 14px;
    line-height: 1.78;
  }

  .craft-panel--light .craft-panel__body > p {
    color: var(--muted);
  }

  .craft-panel--dark .craft-panel__body > p {
    color: rgba(255, 255, 255, 0.72);
  }

  .craft-panel__note {
    margin-top: 18px !important;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 12px !important;
    line-height: 1.7 !important;
  }

  .craft-panel--light .craft-panel__note {
    color: var(--muted2) !important;
  }

  .craft-panel--dark .craft-panel__note {
    border-top-color: rgba(216, 194, 157, 0.24);
    color: var(--gold2) !important;
  }

  /* ---- print choice ---- */

  .print-choice {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(24px, 4vw, 56px);
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: clamp(28px, 3.4vw, 40px);
    border-top: 1px solid var(--line);
  }

  .print-choice__intro h3 {
    margin: 0 0 14px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .print-choice__intro p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.78;
  }

  .print-choice__compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .print-option {
    padding: 22px;
    background: var(--paper2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .print-option h4 {
    margin: 0 0 10px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .print-option p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }

  /* ---- retail ---- */

  .retail-strip {
    display: grid;
    grid-template-columns: minmax(0, 0.66fr) minmax(0, 1.34fr);
    gap: clamp(24px, 4vw, 52px);
    align-items: center;
    margin-top: clamp(32px, 4vw, 48px);
    padding: clamp(24px, 3vw, 36px);
    background: var(--paper2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .retail-strip__diagram {
    position: relative;
    aspect-ratio: 3 / 4;
    max-width: 230px;
    margin: 0 auto;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .retail-strip__hole {
    position: absolute;
    top: 16px;
    left: 50%;
    width: 34px;
    height: 12px;
    transform: translateX(-50%);
    border: 2px solid var(--muted2);
    border-radius: var(--radius-pill);
  }

  .retail-strip__magnet {
    position: absolute;
    top: 46px;
    left: 50%;
    width: 58%;
    aspect-ratio: 1 / 1;
    transform: translateX(-50%);
    background: var(--ink);
    border-radius: 4px;
    opacity: 0.9;
  }

  .retail-strip__copy {
    position: absolute;
    top: 52%;
