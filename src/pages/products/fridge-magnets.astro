      90deg,
      var(--line) 0 3px,
      transparent 3px 7px
    );
  }

  .fm-hero__magnet-gap::after {
    content: "air gap";
    position: absolute;
    top: 50%;
    left: calc(100% + 10px);
    transform: translateY(-50%);
    color: var(--muted2);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fm-hero__note {
    margin: 18px 0 0;
    padding-left: 14px;
    border-left: 2px solid var(--line);
    color: var(--muted2);
    font-size: 13px;
    line-height: 1.75;
  }

  /* ---- gallery ---- */

  .fm-gallery {
    min-width: 0;
  }

  .fm-gallery__stage {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--paper2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .fm-gallery__frame {
