    background: var(--paper2);
    border: 1px solid var(--line);
    border-radius: 3px 3px 0 0;
  }

  .fm-hero__magnet-back {
    display: block;
    height: 9px;
    background: var(--ink);
    border-radius: 0 0 2px 2px;
  }

  .fm-hero__magnet-gap {
    position: relative;
    display: block;
    height: 10px;
