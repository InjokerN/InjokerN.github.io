    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .fm-hero__facts span {
    color: var(--muted2);
    font-size: 10px;
    letter-spacing: 0.07em;
    line-height: 1.5;
    text-transform: uppercase;
    text-align: right;
  }

  /* ============================================================
     II. SURFACE MATRIX
     ============================================================ */

  .surface-matrix {
    border-top: 1px solid var(--line);
  }

  .surface-matrix__head {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) 110px 130px;
    gap: 20px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted2);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .surface-matrix__head span:nth-child(2),
  .surface-matrix__head span:nth-child(3) {
    text-align: center;
  }

  .surface-row {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) 110px 130px;
    gap: 20px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    transition: background 0.2s ease;
  }

  .surface-row:hover {
    background: var(--paper2);
  }

  .surface-row__name {
    display: grid;
    gap: 3px;
    min-width: 0;
  }

  .surface-row__name strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .surface-row__name span {
    color: var(--muted2);
    font-size: 11px;
    letter-spacing: 0.03em;
  }

  .surface-row__meter {
    display: flex;
    justify-content: center;
    gap: 5px;
  }

  .surface-row__bar {
    display: block;
    width: 20px;
    height: 5px;
    background: var(--line);
    border-radius: 1px;
  }

  .surface-row--3 .surface-row__bar {
    background: var(--gold);
  }

  .surface-row--2 .surface-row__bar:nth-child(1),
  .surface-row--2 .surface-row__bar:nth-child(2) {
    background: var(--gold);
  }

  .surface-row--1 .surface-row__bar:nth-child(1) {
    background: var(--muted2);
  }

  .surface-row__grade {
    justify-self: center;
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--muted2);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .surface-row--3 .surface-row__grade {
    border-color: var(--gold);
    background: var(--gold);
    color: var(--paper2);
  }

  .surface-row--2 .surface-row__grade {
    border-color: var(--gold);
    color: var(--gold);
  }

  .surface-row--0 .surface-row__grade {
    color: var(--muted2);
