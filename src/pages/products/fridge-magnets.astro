  .fm-gallery__thumb:hover img,
  .fm-gallery__thumb.is-active img {
    opacity: 1;
  }

  .fm-gallery__thumb-index {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    padding: 2px 4px;
    background: var(--paper2);
    color: var(--muted2);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  /* ---- hero facts ---- */

  .fm-hero__facts {
    display: grid;
    gap: 12px;
    margin: 28px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .fm-hero__facts li {
