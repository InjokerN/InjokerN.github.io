<script>
  /* ============================================================
     FRIDGE MAGNET PAGE INTERACTIONS

     - Hero 画廊（data-fm-gallery）：图 + 随图说明
     独立 data-* 属性与独立 cleanup 键，
     不与 ProductDetailLayout 的 initProductGallery 冲突。
     ============================================================ */

  type MagnetWindow = Window & {
    __fmGalleryCleanup?: () => void;
  };

  function initFmGallery() {
    const root = document.querySelector<HTMLElement>("[data-fm-gallery]");
    if (!root || root.dataset.bound === "true") return;
    root.dataset.bound = "true";

    const thumbs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]")
    );
    const stages = Array.from(
      root.querySelectorAll<HTMLElement>("[data-gallery-stage]")
    );
    const captionLabel = root.querySelector<HTMLElement>("[data-caption-label]");
    const captionNote = root.querySelector<HTMLElement>("[data-caption-note]");

    let data: { label: string; note: string }[] = [];

    try {
      data = JSON.parse(root.dataset.galleryData ?? "[]");
    } catch {
      return;
    }

    if (!thumbs.length || !stages.length) return;

    function activate(index: number) {
      thumbs.forEach((thumb, i) => {
        const isActive = i === index;
        thumb.classList.toggle("is-active", isActive);
        thumb.setAttribute("aria-pressed", isActive ? "true" : "false");
      });

      stages.forEach((stage, i) => {
        stage.classList.toggle("is-active", i === index);
      });

      const item = data[index];
      if (!item) return;
      if (captionLabel) captionLabel.textContent = item.label;
      if (captionNote) captionNote.textContent = item.note;
    }

    function onThumbClick(event: Event) {
      const thumb = event.currentTarget as HTMLButtonElement;
      const index = Number(thumb.dataset.galleryThumb);
      if (!Number.isNaN(index)) activate(index);
    }

    thumbs.forEach((thumb) => thumb.addEventListener("click", onThumbClick));

    const cleanup = () => {
      thumbs.forEach((thumb) =>
        thumb.removeEventListener("click", onThumbClick)
      );
    };

    const win = window as MagnetWindow;
    win.__fmGalleryCleanup?.();
    win.__fmGalleryCleanup = cleanup;
  }

  initFmGallery();

  document.addEventListener("astro:page-load", initFmGallery);
</script>
