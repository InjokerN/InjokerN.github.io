---
/*
  PAGE  : /contact
  FILE  : src/pages/contact.astro
  ROLE  : 联系页 — 询盘表单、常见问题、工厂位置
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

import mapImage from "../assets/contact/map.jpg";

const pageUrl = Astro.url.href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact CM Crafts & Gifts",
  description:
    "Contact CM Crafts & Gifts for custom metal crafts, medals, pins and keychains.",
  url: pageUrl,
  mainEntity: {
    "@type": "Organization",
    name: "CM Crafts & Gifts",
    email: "daniel.imaginef@gmail.com",
    telephone: "+8615343215723",
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "customer service",
      availableLanguage: ["English", "Chinese"],
      email: "daniel.imaginef@gmail.com",
      telephone: "+8615343215723",
    },
  },
};

/* FAQ */
const faqs = [
  {
    q: "How soon will I get a reply?",
    a: "Most inquiries are answered within one business hour. We reply to every message — even if the project isn't a fit.",
  },
  {
    q: "What should I include in my first message?",
    a: "A rough description of the product, quantity, size, and any deadline you're working with. Artwork is helpful but not required at this stage.",
  },
  {
    q: "I only have a rough idea. Can I still reach out?",
    a: "Yes. Most projects start as a sketch, a reference image, or a short description. We'll help work out the production details.",
  },
  {
    q: "Can you sign an NDA before we discuss the project?",
    a: "Yes. An NDA can be signed before any design files are shared. Just mention it in your first message.",
  },
  {
    q: "What does a quote usually include?",
    a: "Unit price, tooling cost, sampling timeline, production timeline, and shipping estimate — all itemized so you can compare.",
  },
];
---

<BaseLayout
  title="Start a Project | CM Crafts & Gifts — Custom Metal Crafts Manufacturer"
  description="Tell CM Crafts & Gifts what you want to make. Get a custom quote for medals, pins, challenge coins, keychains and other custom metal products."
  ogImage="/image/og-contact.jpg"
>
  <Fragment slot="structured-data">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <main class="contact-page">
    <section class="contact-hero">
      <div class="contact-container">
        <div class="contact-hero__inner">
          <p class="contact-hero__eyebrow">START A PROJECT</p>

          <h1 class="contact-hero__title">
            Bring us your idea.
            <br />
            <em>We'll help make it real.</em>
          </h1>

          <p class="contact-hero__subtitle">
            Send us your design, sketch, reference or simply describe what you
            want to make. We'll help turn the idea into a finished metal
            product.
          </p>
        </div>
      </div>
    </section>

    <section class="contact-inquiry" id="inquiry">
      <div class="contact-container">
        <p class="contact-eyebrow">YOUR PROJECT</p>

        <div class="contact-inquiry__grid">
          <div class="contact-inquiry__intro">
            <h2 class="contact-inquiry__heading">
              Tell us what
              <br />
              you're looking to make.
            </h2>

            <p class="contact-inquiry__desc">
              Name, email and a short description are enough to start —
              everything else can be settled in the reply.
            </p>

            <div class="contact-inquiry__note">
              <span class="contact-inquiry__note-mark" aria-hidden="true">
                +
              </span>

              <p>
                Everything you send stays confidential — an NDA can be signed
                before any files are shared.
              </p>
            </div>
          </div>

          <div class="contact-form-wrapper">
            <div class="contact-form__header">
              <p>Send your inquiry</p>

              <span>
                Fields marked <em>*</em> are required
              </span>
            </div>

            <form
              action="https://api.web3forms.com/submit"
              method="POST"
              class="contact-form"
            >
              <input
                type="hidden"
                name="access_key"
                value="1f0abf29-56b7-4847-a1d4-f5f2f54598fb"
              />

              <input
                type="hidden"
                name="subject"
                value="New Project Inquiry from CM Crafts &amp; Gifts"
              />

              <input
                type="hidden"
                name="from_name"
                value="CM Crafts &amp; Gifts Project Inquiry"
              />

              <input
                type="checkbox"
                name="botcheck"
                class="hidden"
                style="display:none;"
              />

              <div class="form-field">
                <label for="contact-name">
                  Your Name <span>*</span>
                </label>

                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  autocomplete="name"
                  placeholder="e.g. John Smith"
                  required
                />
              </div>

              <div class="form-field">
                <label for="contact-email">
                  Email Address <span>*</span>
                </label>

                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  autocomplete="email"
                  placeholder="you@company.com"
                  required
                />
              </div>

              <div class="form-field form-field--full">
                <label for="contact-company">
                  Company / Organization
                  <small>Optional</small>
                </label>

                <input
                  type="text"
                  id="contact-company"
                  name="company"
                  autocomplete="organization"
                  placeholder="Your company name"
                />
              </div>

              <div class="form-field form-field--full">
                <label for="contact-message">
                  Tell us about your project <span>*</span>
                </label>

                <textarea
                  id="contact-message"
                  name="message"
                  rows="6"
                  placeholder="Tell us about your design, size, finish, quantity, deadline or anything else you already know."
                  required
                ></textarea>
              </div>

              <div class="contact-form__footer">
                <button type="submit" class="contact-submit">
                  Send Inquiry
                  <span aria-hidden="true">↗</span>
                </button>

                <p data-contact-status role="status" aria-live="polite">
                  We'll review your inquiry and reply within one business hour.
                </p>
              </div>
            </form>

            <div
              class="contact-success"
              data-contact-success
              role="status"
              aria-live="polite"
              tabindex="-1"
            >
              <div class="contact-success__mark" aria-hidden="true">✓</div>

              <h3>Inquiry received.</h3>

              <p>
                Our team will review the details. We usually respond within one
                business hour.
              </p>

              <button
                type="button"
                class="contact-submit"
                data-contact-reset
              >
                Back
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-faq">
      <div class="contact-container">
        <p class="contact-eyebrow">FAQ</p>

        <h2 class="contact-faq__heading">
          Common questions
          <br />
          <em>before you start.</em>
        </h2>

        <div class="faq-list">
          {faqs.map((item) => (
            <details class="faq-item">
              <summary>
                <span>{item.q}</span>
                <span class="faq-plus">+</span>
              </summary>

              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-factory">
      <div class="contact-container">
        <p class="contact-eyebrow">FACTORY</p>

        <div class="contact-factory__grid">
          <div class="contact-factory__copy">
            <h2 class="contact-factory__heading">
              Built for
              <br />
              <em>custom manufacturing.</em>
            </h2>

            <p class="contact-factory__desc">
              Our factory runs tooling, stamping, enameling and inspection
              under one roof — 2,000 m², 30+ staff.
            </p>

            <a
              href="https://www.google.com/maps/search/?api=1&query=Hunan+Province+China"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-factory__link"
            >
              Open in Google Maps
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <a
            href="https://www.google.com/maps/search/?api=1&query=Hunan+Province+China"
            target="_blank"
            rel="noopener noreferrer"
            class="map-card"
            aria-label="Open factory location in Google Maps"
          >
            <Image
              src={mapImage}
              alt="Map showing factory location in Hunan Province, China"
              loading="lazy"
              widths={[600, 900, 1200]}
              sizes="(max-width: 1024px) 100vw, 60vw"
            />
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>(".contact-form");
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const status = form.querySelector<HTMLElement>("[data-contact-status]");
    const submitBtn = form.querySelector<HTMLButtonElement>(
      "button[type='submit']",
    );

    const wrapper = form.closest<HTMLElement>(".contact-form-wrapper");

    wrapper
      ?.querySelector<HTMLElement>("[data-contact-reset]")
      ?.addEventListener("click", () => {
        wrapper.classList.remove("is-sent");
        form.querySelector<HTMLElement>("input, textarea")?.focus();
      });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (submitBtn) submitBtn.disabled = true;

      if (status) {
        status.textContent = "Sending…";
        status.dataset.state = "loading";
      }

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        const result = await response.json();

        if (response.ok && result.success) {
          const successEl = wrapper?.querySelector<HTMLElement>(
            "[data-contact-success]",
          );

          if (status) {
            status.textContent = "";
            status.dataset.state = "";
          }

          form.reset();
          wrapper?.classList.add("is-sent");
          successEl?.focus();
        } else {
          if (status) {
            status.textContent =
              "Something went wrong. Please email us at daniel.imaginef@gmail.com.";
            status.dataset.state = "error";
          }
        }
      } catch {
        if (status) {
          status.textContent =
            "Network error. Please email us at daniel.imaginef@gmail.com.";
          status.dataset.state = "error";
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  initContactForm();
  document.addEventListener("astro:page-load", initContactForm);
</script>

<style>
  .contact-page {
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }

  .contact-page *,
  .contact-page *::before,
  .contact-page *::after {
    box-sizing: border-box;
  }

  .contact-container {
    width: var(--container-width);
    margin: 0 auto;
  }

  .contact-eyebrow {
    margin: 0 0 10px;
    color: var(--color-gold-dark);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .contact-inquiry,
  .contact-faq,
  .contact-factory {
    padding: 54px 0;
    border-top: 1px solid var(--color-line);
  }

  /* ---------- HERO ---------- */
  .contact-hero {
    padding: calc(var(--nav-h) + var(--hero-gap)) 0 96px;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-paper);
    text-align: center;
  }

  .contact-hero__inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-hero__eyebrow {
    margin: 0 0 24px;
    color: var(--color-gold);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .contact-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(44px, 5vw, 72px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }

  .contact-hero__title em {
    color: var(--color-gold);
    font-style: normal;
  }

  .contact-hero__subtitle {
    max-width: 620px;
    margin: 30px auto 0;
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  /* ---------- INQUIRY ---------- */
  .contact-inquiry__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.75fr) minmax(0, 1.25fr);
    gap: 58px;
    align-items: start;
  }

  .contact-inquiry__intro {
    position: sticky;
    top: 100px;
  }

  .contact-inquiry__heading {
    margin: 0 0 18px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .contact-inquiry__desc {
    max-width: 390px;
    margin: 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .contact-inquiry__note {
    display: flex;
    gap: 16px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
  }

  .contact-inquiry__note-mark {
    flex-shrink: 0;
    color: var(--color-gold);
    font-size: 18px;
    line-height: 1;
  }

  .contact-inquiry__note p {
    max-width: 330px;
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .contact-form-wrapper {
    padding: 34px;
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  .contact-form__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 34px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-line);
  }

  .contact-form__header p {
    margin: 0;
    color: var(--color-ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contact-form__header span {
    color: var(--color-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .contact-form__header em {
    color: var(--color-gold);
    font-style: normal;
    font-weight: 700;
  }

  .contact-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 28px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-field--full {
    grid-column: 1 / -1;
  }

  .form-field label {
    display: flex;
    align-items: baseline;
    gap: 7px;
    color: var(--color-ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .form-field label > span {
    color: var(--color-gold);
  }

  .form-field label small {
    color: var(--color-muted-2);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: none;
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    padding: 10px 0;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--color-ink);
    font-family: inherit;
    font-size: 15px;
    line-height: 1.55;
    transition: border-color var(--ease-out);
  }

  .form-field input,
  .form-field select {
    height: 42px;
  }

  .form-field textarea {
    min-height: 115px;
    resize: vertical;
    padding-top: 12px;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--color-muted-2);
  }

  .form-field input:hover,
  .form-field textarea:hover {
    border-bottom-color: var(--color-muted);
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-bottom-color: var(--color-gold);
  }

  .form-field select {
    appearance: auto;
    cursor: pointer;
  }

  .contact-form__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    grid-column: 1 / -1;
    gap: 24px;
    margin-top: 4px;
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
  }

  .contact-form__footer p {
    max-width: 300px;
    margin: 0;
    color: var(--color-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  .contact-form__footer p[data-state="success"] {
    color: var(--color-ink);
  }

  .contact-form__footer p[data-state="error"] {
    color: #a13d2d;
  }

  .contact-success {
    display: none;
    padding: 48px 24px;
    text-align: center;
  }

  .contact-form-wrapper.is-sent .contact-form__header,
  .contact-form-wrapper.is-sent .contact-form {
    display: none;
  }

  .contact-form-wrapper.is-sent .contact-success {
    display: block;
  }

  .contact-success__mark {
    width: 52px;
    height: 52px;
    margin: 0 auto 18px;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-white);
    font-size: 24px;
    line-height: 52px;
  }

  .contact-success h3 {
    margin: 0 0 10px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
  }

  .contact-success p {
    max-width: 420px;
    margin: 0 auto 22px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .contact-submit {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 14px;
    padding: 14px 24px;
    border: 0;
    border-radius: 999px;
    background: var(--color-gold);
    color: var(--color-white);
    cursor: pointer;
    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      background var(--ease-out),
      color var(--ease-out),
      transform var(--ease-out);
  }

  .contact-submit:hover {
    background: var(--color-ink);
    transform: translateY(-2px);
  }

  .contact-submit span {
    font-size: 17px;
    transition: transform var(--ease-out);
  }

  .contact-submit:hover span {
    transform: translate(4px, -4px);
  }

  /* ---------- FAQ ---------- */
  .contact-faq__heading {
    margin: 0 0 40px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .contact-faq__heading em {
    color: var(--color-gold);
    font-style: normal;
  }

  .faq-list {
    border-top: 1px solid var(--color-line);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-line);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 22px 0;
    cursor: pointer;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    list-style: none;
    transition: color var(--ease-out);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover {
    color: var(--color-gold);
  }

  .faq-plus {
    flex-shrink: 0;
    color: var(--color-gold);
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
    transition: transform var(--ease-out);
  }

  .faq-item[open] .faq-plus {
    transform: rotate(45deg);
  }

  .faq-item > p {
    max-width: 760px;
    margin: 0;
    padding: 0 60px 22px 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.75;
  }

  /* ---------- FACTORY ---------- */
  .contact-factory__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
    gap: 58px;
    align-items: center;
  }

  .contact-factory__heading {
    margin: 0 0 18px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .contact-factory__heading em {
    color: var(--color-gold);
    font-style: normal;
  }

  .contact-factory__desc {
    max-width: 330px;
    margin: 0 0 22px;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .contact-factory__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 6px;
    transition:
      color var(--ease-out),
      border-color var(--ease-out),
      gap var(--ease-out);
  }

  .contact-factory__link:hover {
    color: var(--color-gold);
    border-color: var(--color-gold);
    gap: 16px;
  }

  .contact-factory__link span {
    color: var(--color-gold);
    font-size: 15px;
  }

  .map-card {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      transform var(--ease-out),
      box-shadow var(--ease-out),
      border-color var(--ease-out);
  }

  .map-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-panel);
    border-color: var(--color-gold);
  }

  .map-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--ease-slow);
  }

  .map-card:hover img {
    transform: scale(1.03);
  }

  /* ---------- 平板适配 ---------- */
  @media (max-width: 1024px) {
    .contact-hero {
      padding-bottom: 80px;
      min-height: 440px;
    }

    .contact-inquiry,
    .contact-faq,
    .contact-factory {
