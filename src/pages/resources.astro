---
/*
  PAGE  : /resources
  FILE  : src/pages/resources.astro
  ROLE  : 资源页 — 下载资料、工艺讲解与 CTA
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import {
  downloads,
  craftGuides,
  guideOutline,
  type CraftPhase,
} from "../data/resources";

const featuredResource = downloads[0];
const otherDownloads = downloads.slice(1);

const pillarGuide = craftGuides[0];

const phaseLabels: Record<CraftPhase, string> = {
  choose: "Craft selection",
  verify: "Cost & quality",
  durability: "Function & durability",
};

const hasOutline = guideOutline.length > 0;
---

<BaseLayout
  title="Resources & Downloads — CM Crafts & Gifts"
  description="Product guides, catalogs, manufacturing resources and craft knowledge from CM Crafts & Gifts."
>
  <main class="resources-page">
    <section class="resources-hero">
      <div class="resources-container">
        <div class="resources-hero__inner">
          <p class="resources-hero__eyebrow">KNOWLEDGE & RESOURCES</p>

          <h1 class="resources-hero__title">
            Know the product.
            <br />
            <em>Make the right choice.</em>
          </h1>

          <p class="resources-hero__subtitle">
            Product guides, catalogs, and practical information to help you plan
            your next custom metal project — from artwork prep to craft
            selection.
          </p>
        </div>
      </div>
    </section>

    {featuredResource && (
      <section class="resources-section">
        <div class="resources-container">
          <p class="resources-eyebrow">FEATURED RESOURCE</p>

          <div class="featured-resource">
            <a
              href={featuredResource.file}
              class="featured-resource__media"
              download
              aria-label={`Download ${featuredResource.title}`}
            >
              <div class="featured-resource__media-inner">
                <Image
                  src={featuredResource.cover}
                  alt={featuredResource.title}
                  loading="lazy"
                  widths={[400, 600, 800]}
                  sizes="360px"
                />
              </div>
            </a>

            <div class="featured-resource__body">
              <p class="featured-resource__type">DOWNLOADABLE GUIDE</p>

              <h2 class="featured-resource__title">{featuredResource.title}</h2>

              <p class="featured-resource__desc">{featuredResource.desc}</p>

              <a
                href={featuredResource.file}
                class="featured-resource__button"
                download
              >
                Download PDF
                <span aria-hidden="true">↓</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    {otherDownloads.length > 0 && (
      <section class="resources-section" id="downloads">
        <div class="resources-container">
          <p class="resources-eyebrow">DOWNLOAD LIBRARY</p>

          <h2 class="resources-section-title">More resources.</h2>

          <div class="downloads-list">
            {otherDownloads.map((item) => (
              <a href={item.file} class="download-item" download>
                <div class="download-item__media">
                  <Image
                    src={item.cover}
                    alt={item.title}
                    loading="lazy"
                    widths={[240, 360, 480]}
                    sizes="160px"
                  />
                </div>

                <div class="download-item__content">
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                </div>

                <span class="download-item__action">
                  Download PDF
                  <span aria-hidden="true">↓</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="resources-section" id="craft-guides">
      <div class="resources-container">
        <p class="resources-eyebrow">CRAFT GUIDES</p>

        <h2 class="resources-section-title">
          Deep dives into
          <br />
          what actually matters.
        </h2>

        <p class="resources-section-lede">
          A structured path through the decisions that matter — from choosing a
          craft, to verifying cost and quality, to checking function and
          durability.
        </p>

        {/* ---------- START HERE：支柱页入口 ---------- */}
        {pillarGuide && (
          <a href={pillarGuide.href} class="guides-start">
            <div class="guides-start__body">
              <p class="guides-start__eyebrow">START HERE</p>

              <h3 class="guides-start__title">{pillarGuide.title}</h3>

              <p class="guides-start__desc">{pillarGuide.desc}</p>

              <span class="guides-start__cta">
                Read the full guide
                <span aria-hidden="true">→</span>
              </span>
            </div>

            <span class="guides-start__arrow" aria-hidden="true">↗</span>
          </a>
        )}

        {/* ---------- 指南目录：一行一个 ---------- */}
        {hasOutline && (
          <div class="guide-outline">
            <ol class="guide-outline__list">
              {guideOutline.map((item) => (
                <li>
                  <a href={item.href} class="guide-outline__item">
                    <span class="guide-outline__number">{item.number}</span>

                    <span class="guide-outline__body">
                      <span class="guide-outline__title">{item.title}</span>
                      <span class="guide-outline__desc">{item.desc}</span>
                    </span>

                    <span class="guide-outline__phase">
                      {phaseLabels[item.phase]}
                    </span>

                    <span class="guide-outline__arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
    </section>

    <section class="site-cta">
      <div class="site-cta__circle" aria-hidden="true"></div>

      <div class="site-cta__inner">
        <p class="site-cta__eyebrow">FOUND WHAT YOU NEED?</p>

        <h2>
          Now let's talk
          <br />
          about your project.
        </h2>

        <p class="site-cta__desc">
          The guides give you the background. Send us your specific case and
          we'll tell you what's actually possible — options, timing, and cost.
        </p>

        <a
          href="#contact"
          class="cta-button"
          data-modal-open
          data-modal-product="Resources page"
        >
          Ask About Your Project
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .resources-page {
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }

  .resources-page *,
  .resources-page *::before,
  .resources-page *::after {
    box-sizing: border-box;
  }

  .resources-container {
    width: var(--container-width);
    margin: 0 auto;
  }

  .resources-eyebrow {
    margin: 0 0 10px;
    color: var(--color-gold-dark);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .resources-section-title {
    margin: 0 0 40px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(34px, 4.2vw, 54px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .resources-section-lede {
    max-width: 640px;
    margin: -22px 0 40px;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.7;
  }

  .resources-section {
    padding: 54px 0;
    border-top: 1px solid var(--color-line);
  }

  /* ---------- HERO ---------- */
  .resources-hero {
    padding: 88px 0 96px;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-paper);
    text-align: center;
  }

  .resources-hero__inner {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .resources-hero__eyebrow {
    margin: 0 0 24px;
    color: var(--color-gold);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .resources-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(44px, 5vw, 72px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }

  .resources-hero__title em {
    color: var(--color-gold);
    font-style: normal;
  }

  .resources-hero__subtitle {
    max-width: 620px;
    margin: 30px auto 0;
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  /* ---------- FEATURED RESOURCE ---------- */
  .featured-resource {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .featured-resource__media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 420px;
    padding: 40px;
    background: var(--color-surface);
    text-decoration: none;
    cursor: pointer;
  }

  .featured-resource__media-inner {
    position: relative;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 16 / 10;
    background: var(--color-white);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.12);
    transform: rotate(0deg);
    transition:
      transform var(--ease-slow),
      box-shadow var(--ease-slow);
  }

  .featured-resource__media:hover .featured-resource__media-inner {
    transform: rotate(-3deg) translateY(-6px);
    box-shadow: 0 35px 65px rgba(0, 0, 0, 0.17);
  }

  .featured-resource__media-inner img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-resource__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 36px 40px;
    background: var(--color-paper);
  }

  .featured-resource__type {
    margin: 0 0 14px;
    color: var(--color-gold);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .featured-resource__title {
    margin: 0 0 16px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(26px, 2.4vw, 32px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .featured-resource__desc {
    max-width: 420px;
    margin: 0 0 26px;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .featured-resource__button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 8px;
    align-self: flex-start;
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid var(--color-ink);
    transition:
      color var(--ease-out),
      border-color var(--ease-out),
      gap var(--ease-out);
  }

  .featured-resource__button:hover {
    color: var(--color-gold);
    border-color: var(--color-gold);
    gap: 18px;
  }

  .featured-resource__button span {
    color: var(--color-gold);
    font-size: 15px;
  }

  /* ---------- DOWNLOAD LIBRARY ---------- */
  .downloads-list {
    border-top: 1px solid var(--color-line);
  }

  .download-item {
    display: grid;
    grid-template-columns: 160px 1fr auto;
    gap: 32px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
    transition:
      padding var(--ease-out),
      background var(--ease-out);
  }

  .download-item:hover {
    padding-left: 20px;
    padding-right: 20px;
    background: linear-gradient(
      135deg,
      rgba(174, 141, 90, 0.12) 0%,
      rgba(174, 141, 90, 0.02) 100%
    );
  }

  .download-item__media {
    width: 160px;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .download-item__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--ease-slow);
  }

  .download-item:hover .download-item__media img {
    transform: scale(1.04);
  }

  .download-item__content h3 {
    margin: 0 0 8px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .download-item__content p {
    max-width: 560px;
    margin: 0;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  .download-item__action {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      color var(--ease-out),
      gap var(--ease-out);
  }

  .download-item__action span {
    color: var(--color-gold);
    font-size: 15px;
  }

  .download-item:hover .download-item__action {
    color: var(--color-gold);
    gap: 16px;
  }

  /* ---------- CRAFT GUIDES：START HERE ---------- */
  .guides-start {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 36px;
    margin-bottom: 48px;
    padding: 38px 44px;
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--ease-out),
      transform var(--ease-out),
      box-shadow var(--ease-out);
  }

  .guides-start:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
    box-shadow: var(--shadow-panel);
  }

  .guides-start__body {
    min-width: 0;
  }

  .guides-start__eyebrow {
    margin: 0 0 14px;
    color: var(--color-gold-dark);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .guides-start__title {
    margin: 0 0 12px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .guides-start__desc {
    max-width: 640px;
    margin: 0 0 20px;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .guides-start__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-ink);
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      color var(--ease-out),
      border-color var(--ease-out),
      gap var(--ease-out);
  }

  .guides-start:hover .guides-start__cta {
    color: var(--color-gold-dark);
    border-color: var(--color-gold);
    gap: 16px;
  }

  .guides-start__cta span {
    color: var(--color-gold);
    font-size: 15px;
  }

  .guides-start__arrow {
    flex: 0 0 auto;
    color: var(--color-gold);
    font-size: 28px;
    line-height: 1;
    transition: transform var(--ease-out);
  }

  .guides-start:hover .guides-start__arrow {
    transform: translate(4px, -4px);
  }

  /* ---------- CRAFT GUIDES：目录列表 ---------- */
  .guide-outline__note {
    max-width: 640px;
    margin: 0 0 20px;
    color: var(--color-muted-2);
    font-size: 13px;
    line-height: 1.65;
  }

  .guide-outline__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .guide-outline__item {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto 24px;
    gap: 20px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
    transition:
      padding var(--ease-out),
      background var(--ease-out);
  }

  .guide-outline__item:hover {
    padding-left: 16px;
    padding-right: 16px;
    background: linear-gradient(
      135deg,
      rgba(174, 141, 90, 0.1) 0%,
      rgba(174, 141, 90, 0.01) 100%
    );
  }

  .guide-outline__number {
    color: var(--color-gold-dark);
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .guide-outline__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
  }

  .guide-outline__title {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    transition: color var(--ease-out);
  }

  .guide-outline__item:hover .guide-outline__title {
    color: var(--color-gold-dark);
  }

  .guide-outline__desc {
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .guide-outline__phase {
    padding: 4px 8px;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    color: var(--color-muted-2);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .guide-outline__arrow {
    justify-self: end;
    color: var(--color-gold-dark);
    font-size: 18px;
    line-height: 1;
    transition: transform var(--ease-out);
  }

  .guide-outline__item:hover .guide-outline__arrow {
    transform: translateX(4px);
  }

  /* ---------- CTA ---------- */
  .site-cta {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 78px 6%;
    min-height: 500px;
    background: var(--color-ink-deep);
    color: var(--color-cream);
    overflow: hidden;
  }

  .site-cta::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 42px;
    height: 1px;
    background: var(--color-gold);
    transform: translateX(-50%);
  }

  .site-cta__circle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 480px;
    height: 480px;
    border: 1px solid rgba(174, 141, 90, 0.18);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .site-cta__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    text-align: center;
  }

  .site-cta__eyebrow {
    margin: 0 0 20px;
    color: var(--color-gold-soft);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .site-cta h2 {
    margin: 0 0 22px;
    color: var(--color-cream);
    font-family: var(--font-display);
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .site-cta__desc {
    max-width: 570px;
    margin: 0 auto 30px;
    color: var(--color-cream-muted);
    font-size: 15px;
    line-height: 1.75;
  }

  .site-cta .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-width: 180px;
    padding: 15px 24px;
    background: var(--color-gold);
    color: var(--color-white);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 999px;
    transition:
      background var(--ease-out),
      color var(--ease-out),
      transform var(--ease-out);
  }

  .site-cta .cta-button:hover {
    background: var(--color-white);
    color: var(--color-ink);
    transform: translateY(-2px);
  }

  .site-cta .cta-button span {
    font-size: 17px;
    font-weight: 400;
  }

  /* ---------- 平板适配 ---------- */
  @media (max-width: 1024px) {
    .resources-hero {
      padding: 72px 0 80px;
      min-height: 440px;
    }

    .resources-section {
      padding: 44px 0;
    }

    .featured-resource {
      grid-template-columns: 1fr;
    }

    .featured-resource__media {
      min-height: 320px;
    }

    .featured-resource__body {
      padding: 28px 24px;
    }

    .download-item {
      grid-template-columns: 140px 1fr auto;
      gap: 24px;
    }

    .download-item__media {
      width: 140px;
    }

    .guides-start {
      padding: 32px 28px;
    }

    .guide-outline__item {
      grid-template-columns: 40px minmax(0, 1fr) auto 20px;
      gap: 14px;
    }

    .guide-outline__title {
      font-size: 18px;
    }
  }

  /* ---------- 手机适配 ---------- */
  @media (max-width: 640px) {
    .resources-container {
      width: calc(100% - 36px);
    }

    .resources-hero {
      padding: 48px 0 56px;
      min-height: 0;
    }

    .resources-hero__title {
      font-size: clamp(36px, 10vw, 48px);
    }

    .resources-hero__subtitle {
      margin-top: 22px;
      font-size: 15px;
    }

    .resources-section {
      padding: 34px 0;
    }

    .resources-section-title {
      margin-bottom: 28px;
      font-size: 32px;
    }

    .resources-section-lede {
      margin-top: -16px;
      margin-bottom: 28px;
      font-size: 15px;
    }

    .featured-resource__media {
      min-height: 260px;
      padding: 28px;
    }

    .featured-resource__title {
      font-size: 24px;
    }

    .download-item {
      grid-template-columns: 120px 1fr;
      gap: 16px;
      padding: 18px 0;
    }

