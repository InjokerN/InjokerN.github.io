    border-radius: var(--radius-lg);
  }

  .image-slot img {
    position: relative;

    z-index: 1;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .image-slot--hero {
    min-height: 520px;

    box-shadow: var(--shadow-panel);
  }

  .image-slot--hero img {
    position: absolute;

    inset: 0;

    object-fit: cover;
  }

  /* ==========================================================
     SECTIONS
  =========================================================== */

  .case-section,
  .case-next-step {
    padding: 74px 0;

    border-top: 1px solid var(--color-line);

    scroll-margin-top: 100px;
  }

  .section-kicker {
    color: var(--color-gold-dark);

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 0.17em;

    line-height: 1.5;

    text-transform: uppercase;
  }

  .case-section h2 {
    max-width: 640px;

    margin: 12px 0 0;

    color: var(--color-ink);

    font-family: var(--font-display);

    font-size: clamp(34px, 4vw, 54px);

    font-weight: 600;

    line-height: 1.05;

    letter-spacing: -0.045em;
  }

  .case-next-step h2 {
    max-width: 880px;

    margin: 10px 0 16px;

    color: var(--color-ink);

    font-family: var(--font-display);

    font-size: clamp(32px, 4vw, 52px);

    font-weight: 600;

    line-height: 1.08;

    letter-spacing: -0.04em;
  }

  .lead {
    max-width: 740px;

    color: var(--color-muted);

    font-size: 16px;

    line-height: 1.8;
  }

  /* ==========================================================
     SECTION HEAD — 6 : 4 两栏
     想改副标题位置：调 grid-template-columns 或 gap
  =========================================================== */

  .section-head {
    display: grid;

    grid-template-columns:
      minmax(0, 6fr)
      minmax(0, 4fr);

    gap: 50px;

    align-items: center;

    margin-bottom: 42px;
  }

  .section-head__main {
    min-width: 0;
  }

  .section-head__main .lead {
    max-width: 560px;

    margin: 22px 0 0;
  }

  .section-head__lead {
    min-width: 0;

    margin: 0;

    color: var(--color-muted);

    font-size: 16px;

    line-height: 1.8;
  }

  .section-head__aside {
    min-width: 0;

    display: flex;
  }

  .section-head__aside .card {
    width: 100%;

    display: flex;

    flex-direction: column;

    justify-content: center;
  }

  .case-section__body {
    min-width: 0;
  }

  /* ==========================================================
     CARD
  =========================================================== */

  .card {
    padding: 28px;

    background: rgba(255, 255, 255, 0.46);

    border: 1px solid var(--color-line);

    border-radius: var(--radius-lg);

    box-shadow: var(--shadow-sm);
  }

  .card h3 {
    margin: 0 0 11px;

    color: var(--color-ink);

    font-family: var(--font-display);

    font-size: 18px;

    font-weight: 600;

    line-height: 1.3;
  }

  .card p {
    margin: 0;

    color: var(--color-muted);

    font-size: 14px;

    line-height: 1.78;
  }

  /* ==========================================================
     Core Requirements 卡片宽度
     收窄过头就加 max-width，想更窄就减
  =========================================================== */

  .card--centered {
    max-width: 1080px;

    margin: 0 auto;

    padding: 32px 40px;
  }

  .card--centered > h3 {
    text-align: center;

    margin-bottom: 22px;
  }

  /* ==========================================================
     CHECKLIST
  =========================================================== */

  .checklist {
    display: grid;

    gap: 12px;

