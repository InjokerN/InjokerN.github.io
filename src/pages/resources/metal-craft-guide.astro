---
/*
  PAGE: /resources/metal-craft-guide
  FILE: src/pages/resources/metal-craft-guide.astro
  ROLE: Metal Crafts & Gifts Manufacturing Guide — 支柱页（轻量全景）
*/

import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import {
  formatNewsDate,
  toNewsISO,
} from "../../data/news-list";

import guideCover from "../../assets/resources/craft-cover.jpg";

type ClusterStatus = "published" | "draft";

interface ClusterGuide {
  id: string;
  number: string;
  step: string;
  eyebrow: string;
  title: string;
  decision: string;
  points: string[];
  href: string;
  status: ClusterStatus;
}

const clusterGuides: ClusterGuide[] = [
  {
    id: "guide-enamel",
    number: "01",
    step: "Coloring",
    eyebrow: "SURFACE & FINISH",
    title: "Soft Enamel vs. Hard Enamel",
    decision:
      "Soft enamel leaves raised metal lines for a tactile, textured finish; hard enamel is ground flat and polished for a premium surface. The right choice depends on whether the piece is a promotional item or a collectible.",
    points: [
      "Process, surface feel, and visual difference",
      "Design limits and wear behavior",
      "Selection by product type and budget",
    ],
    href: "/resources/metal-craft-guide/soft-vs-hard-enamel",
    status: "published",
  },
  {
    id: "guide-forming",
    number: "02",
    step: "Tooling & Forming",
    eyebrow: "TOOLING & PRODUCTION",
    title: "Metal Forming & Mold Fees",
    decision:
      "Stamping and die-casting are the two main forming paths, and the mold fee reflects the complexity of that specific tool — not a per-unit markup. Understanding the tooling logic is the first step to reading a quote correctly.",
    points: [
      "Stamping vs. die-casting: process and fit",
      "Relief depth, edge detail, and design limits",
      "Mold fee structure, ownership, and reuse",
    ],
    href: "/resources/metal-craft-guide/metal-forming-mold-fees",
    status: "published",
  },
  {
    id: "guide-color",
    number: "03",
    step: "Artwork",
    eyebrow: "DESIGN & COLOR",
    title: "Color Matching & Artwork Standards",
    decision:
      "Screen color and finished metal color are never identical. A controlled process — signed sample, archived formula, D65 lighting, and a stated ΔE tolerance — is what makes color approval repeatable across batches.",
    points: [
      "Vector files, line width, and text legibility",
      "Pantone, spot color, and screen-to-metal gap",
      "D65, spectrophotometer, and ΔE ≤ 1.5",
    ],
    href: "/resources/metal-craft-guide/color-matching-artwork",
    status: "published",
  },
  {
    id: "guide-plating",
    number: "04",
    step: "Plating",
    eyebrow: "SURFACE TREATMENT",
    title: "Plating Durability & Surface Finishes",
    decision:
      "Plating is a micron-level film. Under daily wear it thins gradually and reveals the base metal — this is a physical property, not a defect. Finish choice and routine care determine how visible that change becomes.",
    points: [
      "Bright, satin, antique, and specialty finishes",
      "Coating thickness and wear mechanism",
      "Seal coats and maintenance guidance",
    ],
    href: "/resources/metal-craft-guide/plating-durability",
    status: "published",
  },
  {
    id: "guide-attachments",
    number: "05",
    step: "Attachment & Packaging",
    eyebrow: "FIXATION & DELIVERY",
    title: "Pin Attachments & Packaging",
    decision:
      "Attachment choice depends on fabric, wear frequency, and whether piercing is allowed. Packaging is the same decision seen from the buyer's side — how the piece is presented and protected at the moment it matters.",
    points: [
      "Butterfly, rubber, flat locking, and magnetic",
      "Safety pins, keyrings, and hardware options",
      "Backing cards, boxes, and transit protection",
    ],
    href: "/resources/metal-craft-guide/attachments-packaging",
    status: "published",
  },
  {
    id: "guide-qc",
    number: "06",
    step: "QC",
    eyebrow: "QUALITY & RELIABILITY",
    title: "Quality Control & Tolerances",
    decision:
      "A reliable batch is defined by acceptance criteria, not by assurances. Tolerances, AQL sampling, inspection gates, and test methods are what let a buyer verify that the goods match the approved sample.",
    points: [
      "Dimensional tolerances and inspection points",
      "Pull, torque, and plating wear testing",
      "AQL, defect classification, and batch consistency",
    ],
    href: "/resources/metal-craft-guide/quality-control-tolerances",
    status: "published",
  },
];

const guideMeta = {
  date: "2026-09-10",
  title: "Metal Crafts & Gifts Manufacturing Guide",
  subtitle: "FAQ & Selection Standards",
  excerpt:
    "A high-level map of how a custom metal piece moves from artwork to delivered product — and where each decision actually gets made.",
  alt: "Metal badge and commemorative coin manufacturing guide",
};

const flowSteps = [
  { number: "01", label: "Artwork" },
  { number: "02", label: "Tooling" },
  { number: "03", label: "Forming" },
  { number: "04", label: "Coloring" },
  { number: "05", label: "Plating" },
  { number: "06", label: "Attachment" },
  { number: "07", label: "QC" },
  { number: "08", label: "Packaging" },
];

const decisionFrames = [
  {
    number: "01",
    question: "What is it for?",
    answer:
      "Promotional items and collectibles pull the design in different directions — cost per unit versus perceived value.",
    link: "#guide-enamel",
    linkLabel: "Enamel selection",
  },
  {
    number: "02",
    question: "What does it need to survive?",
    answer:
      "Indoor display and daily outdoor wear demand different plating, attachment, and packaging choices.",
    link: "#guide-plating",
    linkLabel: "Durability factors",
  },
  {
    number: "03",
    question: "What does success look like?",
    answer:
      "A low unit cost, a premium finish, and a repeatable batch are three different targets — name the one that matters first.",
    link: "#guide-qc",
    linkLabel: "Quality criteria",
