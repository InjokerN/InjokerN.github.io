              A practical map of metal craft production
            </p>

            <h1 class="guide-hero__title">
              Metal Crafts
              <span>& Gifts</span>
              <span class="guide-hero__title-sub">
                Manufacturing Guide
              </span>
            </h1>

            <p class="guide-hero__description">
              {guideMeta.excerpt}
            </p>

            <div class="guide-hero__meta">
              <time datetime={toNewsISO(guideMeta.date)}>
                {formatNewsDate(guideMeta.date)}
              </time>
              <span class="guide-hero__meta-divider"></span>
              <span>METALCRAFTS</span>
              <span class="guide-hero__meta-divider"></span>
              <span>OVERVIEW · 6 DEEP DIVES</span>
            </div>
          </div>

          <figure class="guide-hero__visual">
