          <!-- Desktop contents navigation -->
          <aside class="guide-sidebar" aria-label="Article contents">
            <div class="guide-sidebar__sticky">
              <p class="guide-sidebar__heading">In this overview</p>

              <nav class="guide-toc">
                {clusterGuides.map((item) => (
                  <a
                    href={`#${item.id}`}
                    class="guide-toc__link"
                    data-toc-link={item.id}
                  >
                    <span class="guide-toc__number">{item.number}</span>
                    <span class="guide-toc__text">{item.title}</span>
                  </a>
                ))}
              </nav>

              <div class="guide-sidebar__note">
                <span class="guide-sidebar__note-mark">MC</span>
                <p>
                  Each section ends with a link to a dedicated deep dive.
                </p>
              </div>
            </div>
          </aside>

          <!-- Article body -->
          <article class="guide-content">

            <!-- Mobile contents navigation -->
            <details class="guide-mobile-toc">
              <summary>
                <span>In this overview</span>
                <span class="guide-mobile-toc__icon" aria-hidden="true">+</span>
              </summary>
              <nav aria-label="Mobile article contents">
                {clusterGuides.map((item) => (
                  <a href={`#${item.id}`}>
                    <span>{item.number}</span>
                    {item.title}
                  </a>
                ))}
              </nav>
            </details>

            <!-- =================================================
                 OPENING: OVERVIEW + PRODUCTION FLOW（合并板块）
            ================================================== -->
            <section class="guide-opening" aria-label="Overview and production flow">
              <div class="guide-opening__intro">
                <span class="guide-opening__label">THE OVERVIEW</span>
                <p class="guide-opening__text">
                  This page gives you the full shape of a custom metal project —
                  from artwork to delivered product — without dropping into any
                  single process. Each section closes with a link to a dedicated
                  deep dive, where the specifications, test methods, and
                  selection criteria live.
                </p>
              </div>

              <div class="guide-opening__flow">
                <p class="guide-opening__flow-eyebrow">PRODUCTION FLOW</p>
                <p class="guide-opening__flow-desc">
                  Every custom metal piece moves through the same sequence. Each
                  section below explains where these steps are decided.
                </p>

                <ol class="guide-opening__steps">
                  {flowSteps.map((step) => (
                    <li class="guide-opening__step">
                      <span class="guide-opening__step-number">{step.number}</span>
                      <span class="guide-opening__step-label">{step.label}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </section>


            <!-- =================================================
                 CLUSTER SECTIONS
            ================================================== -->
            {clusterGuides.map((guide) => (
              <section
                id={guide.id}
                class="guide-section"
                data-article-section={guide.id}
              >
                <header class="guide-section__header">
                  <div class="guide-section__index">{guide.number}</div>
                  <div class="guide-section__heading">
                    <p class="guide-section__eyebrow">
                      {guide.eyebrow} · STEP · {guide.step}
                    </p>
                    <h2>{guide.title}</h2>
                  </div>
                </header>

                <p class="guide-lead">{guide.decision}</p>

                <ul class="guide-points">
                  {guide.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>

                {guide.status === "published" ? (
                  <a href={guide.href} class="guide-more">
                    Read the full guide
                    <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <a href="/resources#craft-guides" class="guide-more guide-more--draft">
                    Full guide coming soon
                    <span aria-hidden="true">→</span>
                  </a>
                )}
              </section>
            ))}


            <!-- =================================================
                 DECISION FRAMEWORK
            ================================================== -->
            <section class="decision-frame" aria-label="Decision framework">
              <header class="decision-frame__header">
                <p class="decision-frame__eyebrow">DECISION FRAMEWORK</p>
                <h2 class="decision-frame__title">
                  Three questions before you request a quote.
                </h2>
              </header>

              <div class="decision-frame__grid">
                {decisionFrames.map((frame) => (
                  <div class="decision-frame__item">
                    <span class="decision-frame__number">{frame.number}</span>
                    <h3 class="decision-frame__question">{frame.question}</h3>
                    <p class="decision-frame__answer">{frame.answer}</p>
                    <a href={frame.link} class="decision-frame__link">
                      {frame.linkLabel}
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                ))}
              </div>
            </section>


            <!-- =================================================
                 CONCLUSION
            ================================================== -->
            <footer class="guide-conclusion">
              <div class="guide-conclusion__rule"></div>
              <p class="guide-conclusion__label">END OF OVERVIEW</p>
              <p class="guide-conclusion__text">
                If you already know which topic you need, jump straight to that
                deep dive. If you are still shaping the project, send us the
                brief — product type, quantity, intended use, and any reference
                material — and we will tell you which decisions matter most for
                your case.
              </p>
              <div class="guide-conclusion__signature">
                <span>METALCRAFTS</span>
                <span>CRAFT · DETAIL · QUALITY</span>
              </div>

              <div class="guide-back">
                <a href="/resources" class="guide-back__link">
                  <span class="guide-back__arrow" aria-hidden="true">←</span>
                  Back to all resources
                </a>
              </div>
            </footer>

          </article>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>


<!-- =========================================================
     TABLE OF CONTENTS INTERACTION
========================================================== -->
<script>
  type GuideWindow = Window & {
    __craftGuideCleanup?: () => void;
  };

  function initCraftGuide() {
    const root = document.querySelector<HTMLElement>(".craft-guide");
    const nav = document.querySelector<HTMLElement>(".nav");
    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    );
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("[data-article-section]")
    );

    if (!root || !nav || !tocLinks.length || !sections.length) return;

    const win = window as GuideWindow;
    win.__craftGuideCleanup?.();

    const syncNavHeight = () => {
      root.style.setProperty(
        "--guide-nav-height",
        `${nav.getBoundingClientRect().height}px`
      );
    };

    const setActive = (id: string) => {
      tocLinks.forEach((link) => {
        const active = link.dataset.tocLink === id;
        link.classList.toggle("is-active", active);

        if (active) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const handleLinkClick = (event: MouseEvent) => {
      const link = event.currentTarget as HTMLAnchorElement;
      const id = link.dataset.tocLink;
      if (!id) return;

      const target = document.getElementById(id);
      if (!target) return;

      event.preventDefault();

      const navHeight = nav.getBoundingClientRect().height;
      const targetTop =
        target.getBoundingClientRect().top +
        window.scrollY -
        navHeight -
        28;

      window.scrollTo({
        top: targetTop,
        behavior: "smooth",
      });

      history.replaceState(null, "", `#${id}`);
      setActive(id);

      const mobileToc = root.querySelector<HTMLDetailsElement>(
        ".guide-mobile-toc"
      );

      if (mobileToc?.open) {
        mobileToc.open = false;
      }
    };

    tocLinks.forEach((link) => {
      link.addEventListener("click", handleLinkClick);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort(
            (a, b) =>
              a.boundingClientRect.top - b.boundingClientRect.top
          );

        if (!visible.length) return;

        const activeId = (
          visible[0].target as HTMLElement
        ).dataset.articleSection;

        if (activeId) setActive(activeId);
      },
      {
        root: null,
        rootMargin: `-${nav.getBoundingClientRect().height + 48}px 0px -62% 0px`,
        threshold: 0,
      }
    );

    sections.forEach((section) => observer.observe(section));

    syncNavHeight();

    const resizeObserver = new ResizeObserver(syncNavHeight);
    resizeObserver.observe(nav);

    const handleResize = () => syncNavHeight();
    window.addEventListener("resize", handleResize);

    const hash = window.location.hash.replace("#", "");
    if (hash && sections.some((section) => section.id === hash)) {
      setActive(hash);
    } else {
      setActive(sections[0]?.id ?? "");
    }

    win.__craftGuideCleanup = () => {
      tocLinks.forEach((link) => {
        link.removeEventListener("click", handleLinkClick);
      });

      observer.disconnect();
      resizeObserver.disconnect();
      window.removeEventListener("resize", handleResize);
      win.__craftGuideCleanup = undefined;
    };
  }

  initCraftGuide();
  document.addEventListener("astro:page-load", initCraftGuide);
</script>


<style>
  /* =========================================================
