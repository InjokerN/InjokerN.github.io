              />
              <figcaption class="guide-hero__caption">
                <span>01 / CRAFT & MATERIALS</span>
                <span>Production knowledge</span>
              </figcaption>
            </div>
          </figure>
        </div>
      </div>
    </header>


    <!-- =====================================================
         ARTICLE
    ====================================================== -->
    <section class="guide-article">
      <div class="guide-shell">
