              Plating Durability
              <span>&amp; Surface Finishes</span>
            </h1>

            <p class="plating-hero__desc">{meta.excerpt}</p>

            <div class="plating-hero__meta">
              <time datetime={toNewsISO(meta.date)}>
                {formatNewsDate(meta.date)}
