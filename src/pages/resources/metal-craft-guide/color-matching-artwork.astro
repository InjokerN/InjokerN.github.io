    left: 20px;
    color: var(--color-gold);
    font-family: var(--font-serif);
    font-size: 76px;
    line-height: 1;
    opacity: 0.7;
  }

  .color-thesis__label {
    display: block;
    margin-bottom: 12px;
    color: var(--color-gold-dark);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .color-thesis p {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(18px, 1.9vw, 22px);
    line-height: 1.58;
    letter-spacing: -0.012em;
  }

  /* =========================================================
     SECTIONS
  ========================================================== */

  .color-section {
    min-width: 0;
    margin-top: 78px;
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }

  .color-section__header {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-line);
  }

  .color-section__index {
    color: var(--color-gold-dark);
    font-family: var(--font-serif);
    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .color-section__eyebrow {
    margin: 0 0 9px;
    color: var(--color-muted-2);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .color-section h2 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(27px, 2.9vw, 37px);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.035em;
  }

  /* =========================================================
     NOTE
  ========================================================== */

  .color-note {
    margin: 30px 0 8px;
    padding: 24px 26px;
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--color-gold);
    background: var(--color-paper-2);
  }

  .color-note__label {
    margin: 0 0 10px;
    color: var(--color-gold-dark);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .color-note__foot {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.75;
  }

  /* =========================================================
     FIGURE
  ========================================================== */

  .color-figure {
    margin: 30px 0 26px;
  }

  .color-figure__frame {
    padding: 22px 18px;
    border: 1px solid var(--color-line);
    background: var(--color-paper-2);
    overflow-x: auto;
  }

  .color-figure svg {
    display: block;
    width: 100%;
    min-width: 520px;
    height: auto;
  }

  .color-figure figcaption {
    margin-top: 12px;
    color: var(--color-muted-2);
    font-size: 11px;
    line-height: 1.65;
  }

  /* =========================================================
     RENDER STRIP
  ========================================================== */

  .color-render {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 28px 0 26px;
    border: 1px solid var(--color-line);
  }

  .color-render__item {
    padding: 22px 22px 24px;
    border-right: 1px solid var(--color-line);
    background: var(--color-paper-2);
  }

  .color-render__item:last-child {
    border-right: 0;
  }

  .color-render__num {
    display: block;
    margin-bottom: 14px;
    color: var(--color-gold-dark);
    font-family: var(--font-serif);
    font-size: 15px;
    letter-spacing: -0.02em;
  }

  .color-render h3 {
    margin: 0 0 8px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .color-render p {
    margin: 0;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.68;
  }

  /* =========================================================
     RULES LIST
  ========================================================== */

  .color-rules {
    margin: 30px 0 8px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-ink);
  }

  .color-rules li {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0 18px;
    border-bottom: 1px solid var(--color-line);
  }

  .color-rules__num {
    color: var(--color-gold-dark);
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.5;
  }

  .color-rules h3 {
    margin: 0 0 7px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.018em;
  }

  .color-rules p {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.72;
  }

  /* =========================================================
     MIX STEPS
  ========================================================== */

  .color-steps {
    margin: 28px 0 26px;
    border-left: 1px solid var(--color-line);
    padding-left: 0;
  }

  .color-step {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    padding: 0 0 24px 20px;
  }

  .color-step::before {
    position: absolute;
    top: 4px;
    left: -4px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-gold);
    content: "";
  }

  .color-step__num {
    color: var(--color-gold-dark);
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.5;
  }

  .color-step h3 {
    margin: 0 0 6px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.018em;
  }

  .color-step p {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.72;
  }

  /* =========================================================
     LEGEND
  ========================================================== */

  .color-legend {
    margin: 26px 0 26px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-ink);
  }

  .color-legend li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .color-legend__num {
    color: var(--color-gold-dark);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.9;
  }

  .color-legend h3 {
    margin: 0 0 4px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .color-legend p {
    margin: 0;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.65;
  }

  .color-legend__area {
    display: inline-block;
    margin-right: 8px;
    padding: 1px 6px;
    border: 1px solid var(--color-line);
    color: var(--color-muted-2);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* =========================================================
     GATES
  ========================================================== */

  .color-gates {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 30px 0 10px;
    border-top: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }

  .color-gate {
    padding: 20px 20px 22px;
    border-right: 1px solid var(--color-line);
  }

  .color-gate:last-child {
    border-right: 0;
  }

  .color-gate__num {
    display: block;
    margin-bottom: 12px;
    color: var(--color-gold-dark);
    font-family: var(--font-serif);
    font-size: 14px;
  }

  .color-gate h3 {
    margin: 0 0 12px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .color-gate p {
    margin: 0 0 10px;
    color: var(--color-muted);
    font-size: 12px;
    line-height: 1.65;
  }

  .color-gate p span {
    display: block;
    margin-bottom: 2px;
    color: var(--color-gold-dark);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .color-gate__leaves {
    margin-bottom: 0 !important;
    color: var(--color-muted-2) !important;
  }

  /* =========================================================
     DELTA E BANDS
  ========================================================== */

  .color-bands {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 22px 0 28px;
    border-top: 1px solid var(--color-ink);
  }

  .color-bands__item {
    padding: 16px 18px 18px 0;
    border-right: 1px solid var(--color-line);
  }

  .color-bands__item:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .color-bands__range {
    display: block;
    margin-bottom: 8px;
    color: var(--color-gold-dark);
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .color-bands h3 {
    margin: 0 0 6px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .color-bands p {
    margin: 0;
    color: var(--color-muted);
    font-size: 12px;
    line-height: 1.65;
  }

  /* =========================================================
     CONDITIONS
  ========================================================== */

  .color-conditions {
    margin: 24px 0 26px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .color-conditions li {
    position: relative;
    padding: 12px 0 12px 20px;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .color-conditions li::before {
    position: absolute;
    left: 0;
    top: 20px;
    width: 5px;
    height: 1px;
    background: var(--color-gold);
    content: "";
  }

  /* =========================================================
     CASES
  ========================================================== */

  .color-cases {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin: 28px 0 26px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .color-case {
    padding: 22px 22px 20px;
    background: var(--color-paper-2);
  }

  .color-case h3 {
    margin: 0 0 8px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.018em;
  }

  .color-case p {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.72;
  }

  /* =========================================================
     HANDOVER
  ========================================================== */

  .color-handover {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin: 28px 0 26px;
  }

  .color-handover__col {
    padding-top: 16px;
    border-top: 1px solid var(--color-ink);
  }

  .color-handover__label {
    margin: 0 0 14px;
    color: var(--color-gold-dark);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .color-handover ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .color-handover li {
    position: relative;
    margin-bottom: 10px;
    padding-left: 18px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .color-handover li::before {
    position: absolute;
    left: 0;
    top: 9px;
    width: 5px;
    height: 1px;
    background: var(--color-gold);
    content: "";
  }

  /* =========================================================
     CONCLUSION
  ========================================================== */

  .color-conclusion {
    margin-top: 78px;
  }

  .color-conclusion__rule {
    width: 48px;
    height: 2px;
    margin-bottom: 22px;
    background: var(--color-gold);
  }

  .color-conclusion__label {
    margin-bottom: 16px;
    color: var(--color-gold-dark);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .color-rule {
    margin-bottom: 30px;
    padding-left: 22px;
    border-left: 2px solid var(--color-gold);
  }

  .color-rule p {
    margin: 0 0 12px;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.6;
  }

  .color-rule p:last-child {
    margin-bottom: 0;
  }

  .color-rule strong {
    color: var(--color-ink);
    font-weight: 400;
  }

  .color-conclusion__text {
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.85;
  }

  .color-conclusion__signature {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted-2);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  /* =========================================================
     CLUSTER NAV
  ========================================================== */

  .color-cluster {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 34px;
  }

  .color-cluster__link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--ease-out), background var(--ease-out);
  }

  .color-cluster__link:hover {
    border-color: var(--color-gold);
    background: var(--color-paper-2);
  }

  .color-cluster__link--next {
    text-align: right;
    align-items: flex-end;
  }

  .color-cluster__label {
    color: var(--color-muted-2);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .color-cluster__title {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .color-cluster__title span {
    color: var(--color-gold);
  }

  /* =========================================================
     RESPONSIVE — TABLET
  ========================================================== */

  @media (max-width: 1100px) {
    .color-reading {
      grid-template-columns: minmax(165px, 195px) minmax(0, 1fr);
      gap: 38px;
    }

    .color-content {
      font-size: 15px;
    }

    .color-thesis {
      padding: 30px 30px 28px 60px;
    }

    .color-gates {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .color-gate {
      border-bottom: 1px solid var(--color-line);
    }

    .color-gate:nth-child(2n) {
      border-right: 0;
    }

    .color-gate:nth-child(3),
    .color-gate:nth-child(4) {
      border-bottom: 0;
    }
  }

  /* =========================================================
     RESPONSIVE — SMALL TABLET
  ========================================================== */

  @media (max-width: 820px) {
    .color-hero {
      padding-top: calc(var(--color-nav-height, 72px) + 26px);
    }

    .color-hero__grid {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 26px 30px;
    }

    .color-hero__copy {
      max-width: 680px;
    }

    .color-hero__title {
      font-size: clamp(40px, 7.6vw, 62px);
    }

    .color-hero__desc {
      max-width: 600px;
    }

    .color-hero__frame img {
      aspect-ratio: 1.6 / 1;
    }

    .color-article {
      padding-block: 46px 76px;
    }

    .color-reading {
      display: block;
    }

    .color-sidebar {
      display: none;
    }

    .color-content {
      max-width: 760px;
      margin-inline: auto;
      font-size: 16px;
    }

    .color-mobile-toc {
      display: block;
      margin-bottom: 40px;
      border: 1px solid var(--color-line);
      background: var(--color-paper-2);
    }

    .color-mobile-toc summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      padding: 16px 18px;
      color: var(--color-ink);
      cursor: pointer;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.1em;
      list-style: none;
      text-transform: uppercase;
    }

    .color-mobile-toc summary::-webkit-details-marker {
      display: none;
    }

    .color-mobile-toc__icon {
      color: var(--color-gold-dark);
      font-size: 19px;
      font-weight: 400;
      transition: transform 180ms ease;
    }

    .color-mobile-toc[open] .color-mobile-toc__icon {
      transform: rotate(45deg);
    }

    .color-mobile-toc nav {
      display: grid;
      padding: 0 18px 12px;
    }

    .color-mobile-toc nav a {
      display: flex;
      gap: 14px;
      align-items: baseline;
      padding: 10px 0;
      border-top: 1px solid var(--color-line);
      color: var(--color-muted);
      font-family: var(--font-serif);
      font-size: 15px;
      text-decoration: none;
    }

    .color-mobile-toc nav a span {
      color: var(--color-gold-dark);
      font-size: 9px;
      font-weight: 800;
    }

    .color-thesis {
      margin-bottom: 52px;
    }

    .color-section {
      margin-top: 64px;
    }

    .color-cluster {
      grid-template-columns: 1fr;
    }

    .color-cluster__link--next {
      text-align: left;
      align-items: flex-start;
    }
  }

  /* =========================================================
     RESPONSIVE — MOBILE
  ========================================================== */

  @media (max-width: 560px) {
    .color-hero {
      padding-top: calc(var(--color-nav-height, 72px) + 18px);
    }

    .color-hero__grid {
      gap: 26px;
      padding-block: 22px 26px;
    }

    .color-hero__overline {
      margin-bottom: 14px;
      font-size: 9px;
    }

    .color-hero__title {
      font-size: clamp(34px, 9.4vw, 48px);
      letter-spacing: -0.045em;
    }

    .color-hero__desc {
      margin-top: 18px;
      font-size: 16px;
      line-height: 1.68;
    }

    .color-hero__meta {
      gap: 8px;
      margin-top: 22px;
      font-size: 8px;
    }

    .color-hero__frame::before {
      inset: -8px;
    }

    .color-hero__frame img {
      aspect-ratio: 1.2 / 1;
    }

    .color-hero__visual figcaption {
      padding-top: 10px;
      font-size: 8px;
    }

    .color-article {
      padding-block: 32px 62px;
    }

    .color-mobile-toc {
      margin-bottom: 32px;
    }

    .color-thesis {
      margin-bottom: 42px;
      padding: 22px 20px 22px 44px;
    }

    .color-thesis::before {
      top: 12px;
      left: 10px;
      font-size: 54px;
    }

    .color-thesis p {
      font-size: 17px;
      line-height: 1.55;
    }

    .color-section {
      margin-top: 52px;
    }

    .color-section__header {
      grid-template-columns: 36px minmax(0, 1fr);
      gap: 12px;
      margin-bottom: 18px;
      padding-bottom: 16px;
    }

    .color-section__index {
      font-size: 26px;
    }

    .color-section__eyebrow {
      margin-bottom: 7px;
      font-size: 8px;
    }

    .color-section h2 {
      font-size: clamp(24px, 6.8vw, 30px);
      line-height: 1.18;
    }

    .color-content {
      font-size: 15px;
      line-height: 1.8;
    }

    .color-content p {
      margin-bottom: 17px;
    }

    .color-note {
      padding: 18px;
    }

    .color-figure__frame {
      padding: 14px 10px;
    }

    .color-figure svg {
      min-width: 460px;
    }

    .color-render {
      grid-template-columns: 1fr;
    }

    .color-render__item {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .color-render__item:last-child {
      border-bottom: 0;
    }

    .color-rules li,
    .color-legend li {
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 10px;
    }

    .color-rules h3,
    .color-step h3,
    .color-case h3 {
      font-size: 17px;
    }

    .color-gates {
      grid-template-columns: 1fr;
    }

    .color-gate {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .color-gate:nth-child(3) {
      border-bottom: 1px solid var(--color-line);
    }

    .color-gate:last-child {
      border-bottom: 0;
    }

    .color-cases {
      grid-template-columns: 1fr;
    }

    .color-bands {
      grid-template-columns: 1fr 1fr;
    }

    .color-bands__item {
      padding-right: 14px;
    }

    .color-bands__item:nth-child(2n) {
      border-right: 0;
    }

    .color-handover {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .color-rule p {
      font-size: 17px;
    }

    .color-conclusion {
      margin-top: 54px;
    }

    .color-conclusion__text {
      font-size: 15px;
    }
  }

  /* =========================================================
     ACCESSIBILITY
  ========================================================== */

  @media (prefers-reduced-motion: reduce) {
    .color-page *,
    .color-page *::before,
