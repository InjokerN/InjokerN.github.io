  },
];

const fileRules = [
  {
    title: "Vector, 1:1, with real dimensions",
    text: "A file drawn at 1:1 removes one class of error before it starts. Scaled artwork invites scaled line weights, and a 0.2 mm line that becomes 0.15 mm after scaling is no longer a line the process can hold.",
  },
  {
    title: "One closed path per colour",
    text: "Every colour area is a closed shape, separate from its neighbours. The metal between them is not a stroke you draw — it is the space the die leaves behind, so the gap has to exist in the geometry.",
  },
  {
    title: "A Pantone code on every area",
    text: "Not a hex value, not an RGB triplet, not “the blue from the website”. Each shape carries a Pantone code, and the count of codes is the colour count that gets quoted.",
  },
  {
    title: "Text outlined, not live",
    text: "Fonts get substituted, weights get lost, and a re-flowed line changes the metal around it. Convert type to outlines, then check the smallest stroke against the process minimum.",
  },
  {
    title: "No gradients, halftones, shadows or transparency",
    text: "Enamel is a solid colour in a cell. Anything that depends on a smooth transition has to become print, a dome, or a different design — and that decision belongs before the tool is cut, not after.",
