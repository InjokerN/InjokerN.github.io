  title: "Color Matching & Artwork Standards",
  subtitle: "Pantone codes, the proof you sign, and what ΔE can and cannot tell you",
  excerpt:
    "Colour is not agreed on a screen. It is agreed on a code, printed on a proof, signed before production — and measured afterwards to check that nothing drifted.",
  ogImage: colorShot.src,
};

const sections = [
  { id: "screen", number: "01", title: "Screen colour is not pigment" },
  { id: "file", number: "02", title: "The file that survives production" },
  { id: "pantone", number: "03", title: "Pantone is the working standard" },
  { id: "proof", number: "04", title: "The proof is where colour is agreed" },
  { id: "delta", number: "05", title: "ΔE is a check, not an agreement" },
  { id: "disagree", number: "06", title: "When the number and the eye disagree" },
  { id: "handover", number: "07", title: "What to send, what comes back" },
];

const renderRows = [
  {
    label: "On your screen",
    note: "Emissive light, gamma-corrected, sitting inside a bright interface.",
  },
  {
    label: "On the Pantone chip",
    note: "Reflective ink printed on coated paper, viewed under one light.",
  },
  {
    label: "On the finished part",
