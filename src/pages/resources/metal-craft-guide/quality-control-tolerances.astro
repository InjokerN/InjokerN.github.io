<script>
  type QcWindow = Window & {
    __qcGuideCleanup?: () => void;
  };

  function initQcGuide() {
    const root = document.querySelector<HTMLElement>(".qc-page");
    const nav = document.querySelector<HTMLElement>(".nav");
    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")
    );
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("[data-article-section]")
    );

    if (!root || !nav || !tocLinks.length || !sections.length) return;

    const win = window as QcWindow;
    win.__qcGuideCleanup?.();

    const syncNavHeight = () => {
      root.style.setProperty(
        "--qc-nav-height",
        `${nav.getBoundingClientRect().height}px`
      );
    };

    const setActive = (id: string) => {
      tocLinks.forEach((link) => {
        const active = link.dataset.tocLink === id;
        link.classList.toggle("is-active", active);

        if (active) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    };

    const handleLinkClick = (event: MouseEvent) => {
      const link = event.currentTarget as HTMLAnchorElement;
      const id = link.dataset.tocLink;
      if (!id) return;

      const target = document.getElementById(id);
      if (!target) return;

      event.preventDefault();

      const navHeight = nav.getBoundingClientRect().height;
      const targetTop =
        target.getBoundingClientRect().top + window.scrollY - navHeight - 28;

      window.scrollTo({
        top: targetTop,
        behavior: "smooth",
      });

      history.replaceState(null, "", `#${id}`);
      setActive(id);

      const mobileToc = root.querySelector<HTMLDetailsElement>(
        ".qc-mobile-toc"
      );

      if (mobileToc?.open) {
        mobileToc.open = false;
      }
    };

    tocLinks.forEach((link) => {
      link.addEventListener("click", handleLinkClick);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (!visible.length) return;

        const activeId = (visible[0].target as HTMLElement).dataset
          .articleSection;

        if (activeId) setActive(activeId);
      },
      {
        root: null,
        rootMargin: `-${nav.getBoundingClientRect().height + 48}px 0px -62% 0px`,
        threshold: 0,
      }
    );

    sections.forEach((section) => observer.observe(section));

    syncNavHeight();

    const resizeObserver = new ResizeObserver(syncNavHeight);
    resizeObserver.observe(nav);

    const handleResize = () => syncNavHeight();
    window.addEventListener("resize", handleResize);

    const hash = window.location.hash.replace("#", "");
    if (hash && sections.some((section) => section.id === hash)) {
      setActive(hash);
    } else {
      setActive(sections[0]?.id ?? "");
    }

    win.__qcGuideCleanup = () => {
      tocLinks.forEach((link) => {
        link.removeEventListener("click", handleLinkClick);
      });

      observer.disconnect();
      resizeObserver.disconnect();
      window.removeEventListener("resize", handleResize);
      win.__qcGuideCleanup = undefined;
    };
  }

  initQcGuide();
  document.addEventListener("astro:page-load", initQcGuide);
</script>

