  .forming-hero__frame::before {
    position: absolute;
    z-index: -1;
    inset: -12px;
    border: 1px solid var(--color-line);
    content: "";
    pointer-events: none;
  }

  .forming-hero__frame img {
    position: relative;
    width: 100%;
    height: auto;
    aspect-ratio: 1.13 / 1;
    object-fit: cover;
    background: var(--color-surface);
  }

  .forming-hero__visual figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 2px 0;
    color: var(--color-muted-2);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  /* =========================================================
     ARTICLE LAYOUT
  ========================================================== */

  .forming-article {
    padding: 62px 0 104px;
    border-top: 1px solid var(--color-line);
  }

  .forming-reading {
    display: grid;
    grid-template-columns: minmax(180px, 216px) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 76px);
  }

  .forming-sidebar {
    min-width: 0;
  }

  .forming-sidebar__sticky {
    position: sticky;
    top: calc(var(--forming-nav-height, 72px) + 34px);
  }

  .forming-sidebar__heading {
    margin: 0 0 20px;
    color: var(--color-ink);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .forming-toc {
    position: relative;
    display: grid;
    gap: 2px;
  }

  .forming-toc::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--color-line);
    content: "";
  }

  .forming-toc__link {
    position: relative;
    display: grid;
    grid-template-columns: 25px minmax(0, 1fr);
    gap: 11px;
    align-items: start;
    padding: 12px 0 12px 16px;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.4;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .forming-toc__number {
    padding-top: 3px;
    color: var(--color-muted-2);
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .forming-toc__link:hover,
  .forming-toc__link.is-active {
    color: var(--color-ink);
  }

  .forming-toc__link.is-active::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--color-gold);
    content: "";
  }

  .forming-toc__link.is-active .forming-toc__number {
    color: var(--color-gold-dark);
  }

  .forming-sidebar__note {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
  }

  .forming-sidebar__mark {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    place-items: center;
    border: 1px solid var(--color-line);
    color: var(--color-gold-dark);
    font-family: var(--font-serif);
    font-size: 12px;
  }

  .forming-sidebar__note-body {
    min-width: 0;
  }

  .forming-sidebar__note p {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 13px;
    line-height: 1.55;
  }

  .forming-sidebar__back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 12px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color var(--ease-out),
      border-color var(--ease-out),
      gap var(--ease-out);
  }

  .forming-sidebar__back span {
    color: var(--color-gold);
    font-size: 12px;
  }

  .forming-sidebar__back:hover {
    color: var(--color-gold-dark);
    border-color: var(--color-gold);
    gap: 11px;
  }

  .forming-content {
    min-width: 0;
    font-size: 16px;
    line-height: 1.85;
  }

  .forming-content p {
    margin: 0 0 20px;
  }

  .forming-content a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-gold);
    transition: color var(--ease-out), border-color var(--ease-out);
  }

  .forming-content a:hover {
    color: var(--color-gold-dark);
    border-color: var(--color-gold-dark);
  }

  .forming-mobile-toc {
    display: none;
  }

  /* =========================================================
     THESIS
  ========================================================== */

  .forming-thesis {
    position: relative;
    margin-bottom: 64px;
    padding: 36px 40px 34px 72px;
    border: 1px solid var(--color-line);
    background: var(--color-paper-2);
  }

  .forming-thesis::before {
    content: "\201C";
    position: absolute;
    top: 20px;
    left: 20px;
    color: var(--color-gold);
    font-family: var(--font-serif);
    font-size: 76px;
    line-height: 1;
    opacity: 0.7;
  }

  .forming-thesis__label {
    display: block;
    margin-bottom: 12px;
    color: var(--color-gold-dark);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .forming-thesis p {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(18px, 1.9vw, 22px);
    line-height: 1.58;
    letter-spacing: -0.012em;
  }

  /* =========================================================
     SECTIONS
  ========================================================== */

  .forming-section {
    min-width: 0;
    margin-top: 78px;
    scroll-margin-top: calc(var(--forming-nav-height, 72px) + 32px);
  }

  .forming-section__header {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-line);
  }

  .forming-section__index {
    color: var(--color-gold-dark);
    font-family: var(--font-serif);
    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .forming-section__eyebrow {
    margin: 0 0 9px;
    color: var(--color-muted-2);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.15em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .forming-section h2 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(27px, 2.9vw, 37px);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.035em;
  }

  .forming-subhead {
    margin: 34px 0 16px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  /* =========================================================
     NOTE
  ========================================================== */

  .forming-note {
    margin: 30px 0 8px;
    padding: 24px 26px;
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--color-gold);
    background: var(--color-paper-2);
  }

  .forming-note__label {
    margin: 0 0 10px;
    color: var(--color-gold-dark);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .forming-note__foot {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.75;
  }

  /* =========================================================
     FIGURE
  ========================================================== */

  .forming-figure {
    margin: 30px 0 26px;
  }

  .forming-figure__frame {
    padding: 22px 18px;
    border: 1px solid var(--color-line);
    background: var(--color-paper-2);
    overflow-x: auto;
  }

  .forming-figure svg {
    display: block;
    width: 100%;
    min-width: 520px;
    height: auto;
  }

  .forming-figure figcaption {
    margin-top: 12px;
    color: var(--color-muted-2);
    font-size: 11px;
    line-height: 1.65;
  }

  .forming-photo {
    margin: 28px 0 26px;
  }

  .forming-photo__frame {
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .forming-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .forming-photo figcaption {
    margin-top: 12px;
    color: var(--color-muted-2);
    font-size: 11px;
    line-height: 1.65;
  }

  /* =========================================================
     TABLE
  ========================================================== */

  .forming-table-wrap {
    margin: 26px 0 30px;
    overflow-x: auto;
  }

  .forming-table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .forming-table th {
    padding: 0 16px 10px 0;
    border-bottom: 1px solid var(--color-ink);
    color: var(--color-gold-dark);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-align: left;
    text-transform: uppercase;
    vertical-align: bottom;
  }

  .forming-table td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    line-height: 1.6;
    vertical-align: top;
  }

  .forming-table td:first-child {
    width: 24%;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.45;
  }

  .forming-table--limits td:first-child {
    width: 24%;
  }

  .forming-table--limits td:nth-child(2),
  .forming-table--limits td:nth-child(3) {
    width: 19%;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 14px;
  }

  .forming-table--limits td:last-child {
    width: 38%;
  }

  /* =========================================================
     COST BARS
  ========================================================== */

  .forming-bars {
    margin: 28px 0 10px;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-ink);
  }

  .forming-bars li {
    padding: 18px 0 16px;
    border-bottom: 1px solid var(--color-line);
  }

  .forming-bars__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 10px;
  }

  .forming-bars__label {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.3;
  }

  .forming-bars__share {
    flex: 0 0 auto;
    color: var(--color-gold-dark);
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.02em;
  }

  .forming-bars__track {
    height: 5px;
    background: var(--color-surface);
  }

  .forming-bars__fill {
    display: block;
    height: 100%;
    background: var(--color-gold);
    opacity: 0.85;
  }

  .forming-bars__note {
    margin: 10px 0 0;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.65;
  }

  .forming-bars__caption {
    margin: 0 0 26px;
    color: var(--color-muted-2);
    font-size: 11px;
    line-height: 1.65;
  }

  /* =========================================================
     FORMULA
  ========================================================== */

  .forming-formula {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin: 26px 0;
    padding: 26px 28px;
    border: 1px solid var(--color-line);
    background: var(--color-paper-2);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 16px;
  }

  .forming-formula__part {
    white-space: nowrap;
  }

  .forming-formula__op {
    color: var(--color-gold-dark);
  }

  .forming-formula__frac {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    line-height: 1.25;
  }

  .forming-formula__frac span {
    padding: 0 6px;
  }

  .forming-formula__frac span:first-child {
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 4px;
  }

  /* =========================================================
     WEAR LADDER
  ========================================================== */

  .forming-ladder {
    margin: 30px 0 10px;
    border-top: 1px solid var(--color-line);
  }

  .forming-ladder__step {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .forming-ladder__num {
    color: var(--color-gold-dark);
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  .forming-ladder h3 {
    margin: 0 0 7px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: -0.018em;
  }

  .forming-ladder p {
    margin: 0;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.72;
  }

  /* =========================================================
     OUR DECISIONS
  ========================================================== */

  .forming-decisions {
    margin: 30px 0 12px;
    border-top: 1px solid var(--color-ink);
  }

  .forming-decision {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 18px;
    padding: 22px 0 20px;
    border-bottom: 1px solid var(--color-line);
  }

  .forming-decision__num {
    color: var(--color-gold-dark);
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.5;
  }

  .forming-decision h3 {
    margin: 0 0 8px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: -0.018em;
  }

  .forming-decision p {
    margin: 0 0 10px;
    color: var(--color-muted);
    font-size: 14px;
    line-height: 1.72;
  }

  .forming-decision__effect {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin: 0 !important;
    color: var(--color-ink);
    font-size: 13px;
  }

  .forming-decision__effect span {
    color: var(--color-gold-dark);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  /* =========================================================
     TIMELINE
  ========================================================== */

  .forming-timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 34px 0 26px;
  }

  .forming-timeline::before {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-line);
    content: "";
  }

  .forming-timeline__step {
    position: relative;
    padding: 24px 26px 0 0;
  }

  .forming-timeline__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-gold);
  }

  .forming-timeline h3 {
    margin: 0 0 8px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .forming-timeline p {
    margin: 0;
    color: var(--color-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  /* =========================================================
     QUESTIONS
  ========================================================== */

  .forming-questions {
    margin: 20px 0 26px;
    padding: 0;
    list-style: none;
    counter-reset: forming-q;
  }

  .forming-questions li {
    position: relative;
    padding: 0 0 14px 40px;
    color: var(--color-ink);
    font-size: 15px;
    line-height: 1.7;
    counter-increment: forming-q;
  }

  .forming-questions li::before {
    position: absolute;
    left: 0;
    top: 1px;
    color: var(--color-gold-dark);
    font-family: var(--font-serif);
    font-size: 15px;
    content: counter(forming-q, decimal-leading-zero);
  }

  /* =========================================================
     CONCLUSION
  ========================================================== */

  .forming-conclusion {
    margin-top: 78px;
  }

  .forming-conclusion__rule {
    width: 48px;
    height: 2px;
    margin-bottom: 22px;
    background: var(--color-gold);
  }

  .forming-conclusion__label {
    margin-bottom: 16px;
    color: var(--color-gold-dark);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .forming-rule {
    margin-bottom: 30px;
    padding-left: 22px;
    border-left: 2px solid var(--color-gold);
  }

  .forming-rule p {
    margin: 0 0 12px;
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.6;
  }

  .forming-rule p:last-child {
    margin-bottom: 0;
  }

  .forming-rule strong {
    color: var(--color-ink);
    font-weight: 400;
  }

  .forming-conclusion__text {
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.85;
  }

  .forming-conclusion__signature {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted-2);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  /* =========================================================
     CLUSTER NAV
  ========================================================== */

  .forming-cluster {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 34px;
  }

  .forming-cluster__link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--ease-out), background var(--ease-out);
  }

  .forming-cluster__link:hover {
    border-color: var(--color-gold);
    background: var(--color-paper-2);
  }

  .forming-cluster__link--next {
    text-align: right;
    align-items: flex-end;
  }

  .forming-cluster__label {
    color: var(--color-muted-2);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .forming-cluster__title {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .forming-cluster__title span {
    color: var(--color-gold);
  }

  /* =========================================================
     RESPONSIVE — TABLET
  ========================================================== */

  @media (max-width: 1100px) {
    .forming-reading {
      grid-template-columns: minmax(165px, 195px) minmax(0, 1fr);
      gap: 38px;
    }

    .forming-content {
      font-size: 15px;
    }

    .forming-thesis {
      padding: 30px 30px 28px 60px;
    }

    .forming-timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 26px;
    }

    .forming-timeline::before {
      display: none;
    }
  }

  /* =========================================================
     RESPONSIVE — SMALL TABLET
  ========================================================== */

  @media (max-width: 820px) {
    .forming-hero {
      padding-top: calc(var(--forming-nav-height, 72px) + 26px);
    }

    .forming-hero__grid {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 26px 30px;
    }

    .forming-hero__copy {
      max-width: 680px;
    }

    .forming-hero__title {
      font-size: clamp(46px, 8.2vw, 68px);
    }

    .forming-hero__desc {
      max-width: 600px;
    }

    .forming-hero__frame img {
      aspect-ratio: 1.6 / 1;
    }

    .forming-article {
      padding-block: 46px 76px;
    }

    .forming-reading {
      display: block;
    }

    .forming-sidebar {
      display: none;
    }

    .forming-content {
      max-width: 760px;
      margin-inline: auto;
      font-size: 16px;
    }

    .forming-mobile-toc {
      display: block;
      margin-bottom: 40px;
      border: 1px solid var(--color-line);
      background: var(--color-paper-2);
    }

    .forming-mobile-toc summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      padding: 16px 18px;
      color: var(--color-ink);
      cursor: pointer;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.1em;
      list-style: none;
      text-transform: uppercase;
    }

    .forming-mobile-toc summary::-webkit-details-marker {
      display: none;
    }

    .forming-mobile-toc__icon {
      color: var(--color-gold-dark);
      font-size: 19px;
      font-weight: 400;
      transition: transform 180ms ease;
    }

    .forming-mobile-toc[open] .forming-mobile-toc__icon {
      transform: rotate(45deg);
    }

    .forming-mobile-toc nav {
      display: grid;
      padding: 0 18px 12px;
    }

    .forming-mobile-toc nav a {
      display: flex;
      gap: 14px;
      align-items: baseline;
      padding: 10px 0;
      border-top: 1px solid var(--color-line);
      color: var(--color-muted);
      font-family: var(--font-serif);
      font-size: 15px;
      text-decoration: none;
    }

    .forming-mobile-toc nav a span {
      color: var(--color-gold-dark);
      font-size: 9px;
      font-weight: 800;
    }

    .forming-thesis {
      margin-bottom: 52px;
    }

    .forming-section {
      margin-top: 64px;
    }

    .forming-cluster {
      grid-template-columns: 1fr;
    }

