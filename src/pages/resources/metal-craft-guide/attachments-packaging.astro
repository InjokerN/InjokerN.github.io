            </section>

            <!-- ---------- 07 ---------- -->
            <section
              id="pack-working"
              class="attach-section"
              data-article-section="pack-working"
            >
              <header class="attach-section__header">
                <span class="attach-section__index">07</span>
                <div>
                  <p class="attach-section__eyebrow">Packaging</p>
                  <h2>The working tiers</h2>
                </div>
              </header>

              <p>
                Packaging is usually discussed as a cost. It is really a
                sequence: each tier buys a different thing, and none of them is
                “better” without knowing what the piece has to survive between
                the factory and the hand.
              </p>

              <div class="attach-grid">
                {packWorking.map((item) => (
                  <div class="attach-item">
                    <div class="attach-item__media">
                      {item.src ? (
                        <Image
                          src={item.src}
                          alt={item.name}
                          width={192}
                          height={192}
                          loading="lazy"
                        />
                      ) : (
                        <span class="attach-item__empty" aria-hidden="true">
                          {item.name
                            .split(" ")
                            .map((word) => word[0])
                            .filter((char) => /[A-Za-z]/.test(char))
                            .join("")
                            .slice(0, 2)}
                        </span>
                      )}
                    </div>
                    <div class="attach-item__body">
