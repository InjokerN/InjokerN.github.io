import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatNewsDate, toNewsISO } from "../../../data/news-list";

import heroShot from "../../../assets/resources/guide/back-card.jpg";

const attachmentImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../../assets/resources/guide/attachments/*.{jpg,jpeg,png,webp}",
  { eager: true }
);

function findImage(file: string): ImageMetadata | undefined {
  const key = Object.keys(attachmentImages).find((k) => k.endsWith(`/${file}`));
  return key ? attachmentImages[key]!.default : undefined;
}

function withImage<T extends { file: string }>(items: T[]) {
  return items.map((item) => ({ ...item, src: findImage(item.file) }));
}

const meta = {
  date: "2026-10-21",
  title: "Pin Attachments & Packaging",
  subtitle: "Clutches, magnets, rings, boxes — matched to fabric, use and handover",
  excerpt:
    "The attachment decides whether a piece stays on; the packaging decides what it is worth when it changes hands. A reference for every product family we make.",
  ogImage: heroShot.src,
};

const sections = [
  { id: "decision", number: "01", title: "The attachment is a wear decision" },
