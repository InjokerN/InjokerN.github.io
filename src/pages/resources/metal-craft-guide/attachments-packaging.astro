  { id: "no-clutch", number: "03", title: "Pins: when there is no clutch" },
  { id: "magnets", number: "04", title: "Fridge magnets" },
  { id: "keychains", number: "05", title: "Keychains" },
  { id: "cufflinks", number: "06", title: "Cufflinks and tie hardware" },
  { id: "pack-working", number: "07", title: "Packaging: the working tiers" },
  { id: "pack-premium", number: "08", title: "Packaging: the presentation tier" },
  { id: "pack-detail", number: "09", title: "Details that decide quality" },
  { id: "compliance", number: "10", title: "Nickel, lead, and what to ask for" },
];

