const packDetails = [
  {
    label: "Card stock",
    text: "Around 300–400 gsm for a backing card. Lighter stock curls once the pin is mounted, and a curled card does not stand on a peg.",
  },
  {
    label: "Hole diameter",
    text: "The stem plus a fraction of a millimetre. A generous hole lets the pin rotate on the card, so the face is never straight on the shelf — and no amount of printing fixes that.",
  },
  {
    label: "Insert",
    text: "Cut to the part, not to a generic cavity. A loose fit lets the piece move in transit, which is where most scratches happen.",
  },
  {
    label: "Carton ratio",
    text: "How many inner boxes fit a master carton. An odd ratio leaves air in the carton and raises freight per unit — invisible on the quote, visible on the invoice.",
  },
  {
    label: "Print placement",
    text: "Barcodes and QR codes go on a flat area, away from the hole and away from any fold. A code across a crease does not scan.",
  },
];

const compliance = [
  {
    label: "Nickel release",
    market: "European Union",
    test: "REACH Annex XVII; EN 1811 screening, EN 12472 for wear before test",
    ask: "A report on the specific part, because the attachment is what touches skin.",
  },
  {
    label: "Lead and cadmium",
    market: "United States, European Union",
    test: "CPSIA limits for children's products; REACH restrictions for jewellery",
    ask: "Which part was tested — the plated surface, the solder, or the base metal.",
  },
  {
    label: "Packaging metals",
    market: "European Union",
    test: "Packaging directive limits on lead, cadmium, mercury and chromium VI",
    ask: "Whether the printed card and the ink were included in the test scope.",
