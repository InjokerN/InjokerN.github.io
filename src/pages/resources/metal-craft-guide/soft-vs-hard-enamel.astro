                    <span aria-hidden="true">←</span> Manufacturing guide
                  </span>
                </a>

                <a
                  href="/resources/metal-craft-guide/metal-forming-mold-fees"
                  class="enamel-cluster__link enamel-cluster__link--next"
                >
                  <span class="enamel-cluster__label">Next deep dive</span>
                  <span class="enamel-cluster__title">
                    Metal forming &amp; mold fees <span aria-hidden="true">→</span>
                  </span>
                </a>
              </nav>
            </footer>
          </article>
