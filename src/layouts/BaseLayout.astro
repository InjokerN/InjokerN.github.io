---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: string;
}

const {
  title = "CM Crafts & Gifts — Custom Metal Crafts Manufacturer",
  description = "Over 10 years of precision metal crafts manufacturing for custom badges, pins, medals, keychains and promotional metal products.",
  ogImage = "/image/og-default.jpg",
  lang = "en",
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;
const ogImageURL = new URL(ogImage, Astro.url).href;

const isHome = currentPath === "/";
const isProducts = currentPath.startsWith("/products");
const isAbout = currentPath.startsWith("/about");
const isResources = currentPath.startsWith("/resources");
const isNews = currentPath.startsWith("/news");
const isContact = currentPath === "/contact";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Icons -->
    <link rel="icon" href="/icon/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icon/favicon-16x16.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icon/apple-touch-icon.png"
    />

    <!-- Font preload -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-v22-latin-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />
    <slot name="structured-data" />
  </head>

  <body>
    <!-- NAVIGATION -->
    <nav class="nav">
      <a href="/" class="nav__brand">
        <span class="brand-mark">CM</span><span class="brand-cat">Crafts &amp; Gifts</span>
      </a>

      <ul class="nav__links" id="navLinks">
        <li>
          <a
            href="/"
            class:list={["nav__link", { active: isHome }]}
            aria-current={isHome ? "page" : undefined}
          >
            Home
          </a>
        </li>
        <li>
          <a
            href="/products"
            class:list={["nav__link", { active: isProducts }]}
            aria-current={isProducts ? "page" : undefined}
          >
            Products
          </a>
        </li>
        <li>
          <a
            href="/about"
            class:list={["nav__link", { active: isAbout }]}
            aria-current={isAbout ? "page" : undefined}
          >
            About Us
          </a>
        </li>
        <li>
          <a
            href="/resources"
            class:list={["nav__link", { active: isResources }]}
            aria-current={isResources ? "page" : undefined}
          >
            Resources
          </a>
        </li>
        <li>
          <a
            href="/news"
            class:list={["nav__link", { active: isNews }]}
            aria-current={isNews ? "page" : undefined}
          >
            News
          </a>
        </li>
        <li>
          <a
            href="/contact"
            class:list={["nav__link", { active: isContact }]}
            aria-current={isContact ? "page" : undefined}
          >
            Contact
          </a>
        </li>
      </ul>

      <div class="nav__actions">
        <button
          type="button"
          class="btn btn--primary nav__quote"
          id="inquireBtn"
          aria-controls="customModal"
          aria-haspopup="dialog"
        >
          <span class="nav__quote-long">Get a Free Quote</span>
          <span class="nav__quote-short">Quote</span>
        </button>

        <button
          type="button"
          class="nav__toggle"
          id="navToggle"
          aria-label="Open menu"
          aria-controls="navLinks"
          aria-expanded="false"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </nav>

    <!-- PAGE CONTENT -->
    <slot />

    <!-- CONTACT CTA -->
    <section id="contact" class="contact">
      <h2 class="contact__title">CONTACT US</h2>
      <p class="contact__subtitle">
        Have a project in mind? We usually reply within 1 hour on working days.
      </p>

      <div class="contact__methods">
        <a href="mailto:daniel.imaginef@gmail.com" class="contact-method">
          <span class="contact-method__icon">✉</span>
          <span class="contact-method__label">Email</span>
          <span class="contact-method__value">daniel.imaginef@gmail.com</span>
        </a>

        <a
          href="https://wa.me/8615343215723"
          class="contact-method"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-method__icon">☏</span>
          <span class="contact-method__label">WhatsApp</span>
          <span class="contact-method__value">+86 153 4321 5723</span>
        </a>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <p>&copy; 2026 CM Crafts &amp; Gifts.</p>
      <p class="footer__legal">
        All Rights Reserved. All symbols, logos and slogans depicted are
        registered trademarks of their respective owners. By submitting designs
        to CM Crafts &amp; Gifts, the purchasing party warrants that it holds the
        legal right to reproduce any logos or other images associated with the
        order. Samples shown on this site are for illustrative purposes only
        and are not for sale.
      </p>
    </footer>

    <!-- CUSTOM ORDER MODAL -->
    <div
      class="modal"
      id="customModal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="customModalTitle"
      aria-hidden="true"
    >
      <div class="modal__overlay" id="modalOverlay"></div>

      <div class="modal__content">
        <button
          type="button"
          class="modal__close"
          id="closeModal"
          aria-label="Close dialog"
        >
          &times;
        </button>

        <h3
          class="modal__title"
          id="customModalTitle"
          data-default-title="Get Your Free Quote"
        >
          Get Your Free Quote
        </h3>

        <form
          id="customForm"
          class="modal__form"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input
            type="hidden"
            name="access_key"
            value="1f0abf29-56b7-4847-a1d4-f5f2f54598fb"
          />
          <input
            type="hidden"
            name="subject"
            value="New Quote Request — CM Crafts & Gifts"
          />
          <input
            type="hidden"
            name="from_name"
            value="CM Crafts & Gifts Quote Request"
          />
          <input type="hidden" id="modalProduct" name="product" value="" />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none;"
          />

          <div class="modal__field">
            <label for="nickname">Your Name *</label>
            <input
              type="text"
              id="nickname"
              name="nickname"
              autocomplete="name"
              placeholder="Your name or company"
              required
            />
          </div>

          <div class="modal__field">
            <label for="email">Email Address *</label>
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              placeholder="you@company.com"
              required
            />
          </div>

          <div class="modal__field">
            <label for="details">Project Details *</label>
            <textarea
              id="details"
              name="details"
              rows="5"
              placeholder="Tell us about your project — product type, quantity, size, material, finish, colors, deadline, occasion, budget, artwork status, packaging, or anything else you have in mind."
              required
            ></textarea>
          </div>

          <p
            class="modal__status"
            data-modal-status
            role="status"
            aria-live="polite"
          ></p>

          <button type="submit" class="modal__submit">
            Send Request
          </button>
        </form>

        <div
          class="modal__success"
          data-modal-success
          role="status"
          aria-live="polite"
          tabindex="-1"
        >
          <div class="modal__success-mark" aria-hidden="true">✓</div>

          <p>
            Our team will review the details. We usually respond within one
            business hour.
          </p>

          <button type="button" class="modal__submit" data-modal-success-close>
            Back
          </button>
        </div>
      </div>
    </div>

    <!-- GLOBAL CLIENT INTERACTIONS -->
    <script>
      function initGlobal() {
        const navToggle = document.getElementById("navToggle");
        const navLinks = document.getElementById("navLinks");

        if (navToggle && navLinks && navToggle.dataset.bound !== "1") {
          navToggle.dataset.bound = "1";

          const setMenu = (open) => {
            navLinks.classList.toggle("active", open);
            navToggle.classList.toggle("is-open", open);
            navToggle.setAttribute("aria-expanded", String(open));
            navToggle.setAttribute(
              "aria-label",
              open ? "Close menu" : "Open menu",
            );
          };

          navToggle.addEventListener("click", (event) => {
            event.stopPropagation();
            setMenu(!navLinks.classList.contains("active"));
          });

          navLinks.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => setMenu(false));
          });

          document.addEventListener("click", (event) => {
            if (!navLinks.classList.contains("active")) return;

            const target = event.target;
            if (
              target instanceof Node &&
              (navLinks.contains(target) || navToggle.contains(target))
            ) {
              return;
            }

            setMenu(false);
          });

          document.addEventListener("keydown", (event) => {
            if (
              event.key === "Escape" &&
              navLinks.classList.contains("active")
            ) {
              setMenu(false);
              navToggle.focus();
            }
          });
        }

        const modal = document.getElementById("customModal");
        if (!modal || modal.dataset.bound === "1") return;
        modal.dataset.bound = "1";

        const closeModalButton = document.getElementById("closeModal");
        const modalOverlay = document.getElementById("modalOverlay");
        const modalProduct = document.getElementById(
          "modalProduct",
        ) as HTMLInputElement | null;
        const customForm =
          document.querySelector<HTMLFormElement>("#customForm");
        const inquireBtn = document.getElementById("inquireBtn");

        const FOCUSABLE_SELECTOR =
          'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';

        let lastFocusedElement: HTMLElement | null = null;
        let originalPaddingRight = "";

        function getFocusable(): HTMLElement[] {
          return Array.from(
            modal!.querySelectorAll<HTMLElement>(FOCUSABLE_SELECTOR),
          ).filter((el) => el.offsetParent !== null);
        }

        function openModal(productName?: string) {
          lastFocusedElement =
            document.activeElement instanceof HTMLElement
              ? document.activeElement
              : null;
          originalPaddingRight = document.body.style.paddingRight;

          const scrollbarWidth =
            window.innerWidth - document.documentElement.clientWidth;
          document.body.style.paddingRight = `${scrollbarWidth}px`;
          document.body.style.overflow = "hidden";

          modal!.classList.add("active");
          modal!.setAttribute("aria-hidden", "false");

          if (modalProduct && productName) {
            modalProduct.value = productName;
          }

          const modalStatus = customForm?.querySelector<HTMLElement>(
            "[data-modal-status]",
          );
          if (modalStatus) {
            modalStatus.textContent = "";
            modalStatus.dataset.state = "";
          }

          customForm?.classList.remove("is-hidden");

          const modalSuccess = modal?.querySelector<HTMLElement>(
            "[data-modal-success]",
          );
          modalSuccess?.classList.remove("is-visible");

          const modalTitle = modal?.querySelector<HTMLElement>(
            "#customModalTitle",
          );
          if (modalTitle) {
            modalTitle.textContent =
              modalTitle.dataset.defaultTitle ?? "Get Your Free Quote";
          }

          const focusable = getFocusable();
          (focusable[0] ?? closeModalButton)?.focus();
        }

        function closeModal() {
          modal!.classList.remove("active");
          modal!.setAttribute("aria-hidden", "true");

          document.body.style.overflow = "";
          document.body.style.paddingRight = originalPaddingRight;
          originalPaddingRight = "";

          if (modalProduct) modalProduct.value = "";

          lastFocusedElement?.focus();
        }

        inquireBtn?.addEventListener("click", () => openModal());

        document
          .querySelectorAll<HTMLElement>("[data-modal-open]")
          .forEach((element) => {
            if (element.dataset.modalBound === "1") return;
            element.dataset.modalBound = "1";

            element.addEventListener("click", (event) => {
              event.preventDefault();
              openModal(element.dataset.modalProduct);
            });
          });

        closeModalButton?.addEventListener("click", closeModal);
        modalOverlay?.addEventListener("click", closeModal);

        document
          .querySelectorAll<HTMLElement>("[data-modal-success-close]")
          .forEach((btn) => {
            btn.addEventListener("click", () => closeModal());
          });

        document.addEventListener("keydown", (event) => {
          if (!modal.classList.contains("active")) return;

          if (event.key === "Escape") {
            closeModal();
            return;
          }

          if (event.key === "Tab") {
            const focusable = getFocusable();
            if (focusable.length === 0) return;

            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          }
        });

        customForm?.addEventListener("submit", async (event) => {
          event.preventDefault();

          const statusEl = customForm.querySelector<HTMLElement>(
            "[data-modal-status]",
          );
          const submitBtn = customForm.querySelector<HTMLButtonElement>(
            "button[type='submit']",
          );

          if (submitBtn) submitBtn.disabled = true;

          if (statusEl) {
            statusEl.textContent = "Sending…";
            statusEl.dataset.state = "loading";
          }

          try {
            const response = await fetch(customForm.action, {
              method: "POST",
              body: new FormData(customForm),
              headers: { Accept: "application/json" },
            });

            const result = await response.json();

            if (response.ok && result.success) {
              if (statusEl) {
                statusEl.textContent = "";
                statusEl.dataset.state = "";
              }

              customForm.reset();
              customForm.classList.add("is-hidden");

              const successEl = modal?.querySelector<HTMLElement>(
                "[data-modal-success]",
              );

              if (successEl) {
                successEl.classList.add("is-visible");
                successEl.focus();
              }

              const titleEl = modal?.querySelector<HTMLElement>(
                "#customModalTitle",
              );

              if (titleEl) {
                titleEl.textContent = "Thank you.";
              }
            } else {
              if (statusEl) {
                statusEl.textContent =
                  "Something went wrong. Please email us at daniel.imaginef@gmail.com.";
                statusEl.dataset.state = "error";
              }
            }
          } catch {
            if (statusEl) {
              statusEl.textContent =
                "Network error. Please email us at daniel.imaginef@gmail.com.";
              statusEl.dataset.state = "error";
            }
          } finally {
            if (submitBtn) submitBtn.disabled = false;
          }
        });
      }

      initGlobal();
      document.addEventListener("astro:page-load", initGlobal);
    </script>
    <!-- FRAMEWORK UI STYLES -->
    <style is:global>
      /* ---------- BUTTONS ---------- */
      .btn {
        display: inline-block;
        padding: 12px 28px;
        font-weight: 600;
        font-size: 14px;
        letter-spacing: 0.5px;
        text-decoration: none;
        border-radius: 2px;
        cursor: pointer;
        transition: all var(--ease-out);
        text-transform: uppercase;
      }

      .btn--primary {
        background-color: var(--color-ink-deep);
        color: var(--color-white);
        border: 2px solid var(--color-ink-deep);
        border-radius: 999px;
      }

      .btn--outline {
        background: transparent;
        color: var(--color-ink-deep);
        border: 2px solid var(--color-ink-deep);
      }

      .btn--primary:hover {
        background-color: #000;
        border-color: #000;
      }

      .btn--outline:hover {
        background-color: var(--color-ink-deep);
        color: var(--color-white);
      }

      .btn--hero-gold {
        background-color: var(--color-gold);
        border: 2px solid var(--color-gold);
        color: var(--color-ink-deep);
        box-shadow: 0 4px 12px rgba(174, 141, 90, 0.3);
        transition: all var(--ease-out);
      }

      .btn--hero-gold:hover {
        background-color: var(--color-gold-hover);
        border-color: var(--color-gold-hover);
        color: var(--color-ink-deep);
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(174, 141, 90, 0.5);
      }

      .btn--hero-gold:active {
        transform: translateY(-1px);
        box-shadow: 0 4px 10px rgba(174, 141, 90, 0.4);
      }

      /* ---------- NAVIGATION ---------- */
      .nav {
        background-color: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        height: var(--nav-h);
        padding: 0 6%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        z-index: 1000;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
      }

      .nav__brand {
        font-family: var(--font-display);
        font-size: 22px;
        font-weight: 700;
        color: var(--color-ink-deep);
        text-transform: uppercase;
        letter-spacing: 0.02em;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .nav__brand .brand-mark {
        color: var(--color-gold);
        font-size: 1.28em;
        margin-right: 0.42em;
      }

      .nav__brand .brand-cat {
        font-size: 1em;
        letter-spacing: -0.02em;
      }

      .nav__actions {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-shrink: 0;
        margin-left: auto;
      }

      .nav__quote-short {
        display: none;
      }

      .nav__links {
        display: flex;
        gap: 4px;
        list-style: none;
      }

      .nav__link {
        display: block;
        padding: 12px 22px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: var(--color-ink);
        text-decoration: none;
        border-radius: 2px;
        transition: all var(--ease-out);
      }

      .nav__link:hover {
        background-color: var(--color-ink-deep);
        color: var(--color-white);
      }

      .nav__link.active {
        color: var(--color-gold);
        border-bottom: 2px solid var(--color-gold);
      }

      .nav__toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
        width: 44px;
        height: 44px;
        padding: 0;
        background: none;
        border: none;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
      }

      .nav__toggle span {
        width: 22px;
        height: 2px;
        background: var(--color-ink-deep);
        transition:
          transform 0.25s ease,
          opacity 0.2s ease;
      }

      .nav__toggle.is-open span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }

      .nav__toggle.is-open span:nth-child(2) {
        opacity: 0;
      }

      .nav__toggle.is-open span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }

      @media (max-width: 768px) {
        .nav {
          padding: 0 16px;
          gap: 10px;
        }

        .nav__brand {
          font-size: clamp(13px, 3.4vw, 17px);
          letter-spacing: 0;
        }

        .nav__actions {
          gap: 12px;
        }

        .nav__quote {
          padding: 9px 16px;
          font-size: 12px;
          letter-spacing: 0.3px;
        }

        .nav__quote-long {
          display: none;
        }

        .nav__quote-short {
          display: inline;
        }

        .nav__toggle {
          display: flex;
        }

        .nav__links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: var(--color-white);
          flex-direction: column;
          gap: 0;
          padding: 4px 16px 8px;
          border-bottom: 1px solid var(--color-line);
          box-shadow: var(--shadow-sm);
          text-align: left;
        }

        .nav__links.active {
          display: flex;
        }

        .nav__link {
          width: 100%;
          text-align: left;
          padding: 15px 2px;
          border-radius: 0;
          border-bottom: 1px solid var(--color-line);
        }

        .nav__links li:last-child .nav__link {
          border-bottom: none;
        }

        .nav__link.active {
          border-bottom: 1px solid var(--color-gold);
        }
      }

      @media (max-width: 380px) {
        .nav__brand {
          font-size: 12.5px;
        }

        .nav__quote {
          padding: 8px 13px;
          font-size: 11px;
        }

        .nav__actions {
          gap: 10px;
        }
      }

      /* ---------- MODAL ---------- */
      .modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1000;
        align-items: center;
        justify-content: center;
      }

      .modal.active {
        display: flex;
      }

      .modal__overlay {
        position: absolute;
        inset: 0;
        background-color: rgba(27, 26, 24, 0.5);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
      }

      .modal__content {
        position: relative;
        z-index: 2;
        width: min(560px, 92%);
        max-height: calc(100vh - 60px);
        overflow-y: auto;
        padding: 44px 42px 38px;
        background: var(--color-paper-2);
        border: 1px solid var(--color-line);
        border-radius: var(--radius-lg);
        box-shadow: 0 30px 80px rgba(43, 35, 25, 0.25);
        animation: modalFadeIn 0.3s ease;
      }

      @keyframes modalFadeIn {
        from {
          opacity: 0;
          transform: translateY(-12px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .modal__close {
        position: absolute;
        top: 12px;
        right: 16px;
        padding: 4px 8px;
        font-size: 26px;
        line-height: 1;
        color: var(--color-muted);
        background: none;
        border: none;
        cursor: pointer;
        transition: color 0.2s ease;
      }

      .modal__close:hover {
        color: var(--color-ink);
      }

      .modal__title {
        margin: 0 0 22px;
        font-family: var(--font-display);
        font-size: 32px;
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: -0.025em;
        color: var(--color-ink);
      }

      .modal__form {
        display: grid;
        gap: 16px;
      }

      .modal__field {
        display: grid;
        gap: 6px;
      }

      .modal__field label {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-gold-dark);
      }

      .modal__field input,
      .modal__field textarea {
        width: 100%;
        padding: 12px 14px;
        font-family: inherit;
        font-size: 14px;
        color: var(--color-ink);
        background: var(--color-white);
        border: 1px solid var(--color-line);
        border-radius: 8px;
        outline: none;
        resize: vertical;
        transition: border-color 0.2s ease;
      }

      .modal__field input:focus,
      .modal__field textarea:focus {
        border-color: var(--color-gold);
      }

      .modal__field input::placeholder,
      .modal__field textarea::placeholder {
        color: #b0a89b;
        font-size: 13px;
        letter-spacing: 0;
      }

      .modal__status {
        margin: 0;
        font-size: 12px;
        line-height: 1.5;
        color: var(--color-muted);
      }

      .modal__status[data-state="error"] {
        color: #a13d2d;
      }

      .modal__form.is-hidden {
        display: none;
      }

      .modal__success {
        display: none;
        padding: 4px 0 8px;
        text-align: center;
      }

      .modal__success.is-visible {
        display: block;
      }

      .modal__success-mark {
        width: 52px;
        height: 52px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: var(--color-gold);
        color: var(--color-white);
        font-size: 24px;
        line-height: 52px;
        text-align: center;
      }

      .modal__success h4 {
        margin: 0 0 10px;
        color: var(--color-ink-deep);
        font-family: var(--font-display);
        font-size: 22px;
        font-weight: 600;
      }

      .modal__success p {
        margin: 0 0 22px;
        color: var(--color-muted);
        font-size: 13px;
        line-height: 1.6;
      }

      .modal__submit {
        width: 100%;
        margin-top: 6px;
        padding: 14px 22px;
        font-family: inherit;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-white);
        background: var(--color-gold);
        border: 1px solid var(--color-gold);
        border-radius: 999px;
        cursor: pointer;
        transition:
          background var(--ease-out),
          transform var(--ease-out);
      }

      .modal__submit:hover {
        background: var(--color-gold-hover);
        border-color: var(--color-gold-hover);
        transform: translateY(-2px);
      }

      @media (max-width: 640px) {
        .modal__content {
          padding: 34px 24px 28px;
          border-radius: var(--radius-md);
        }

        .modal__title {
          font-size: 26px;
        }
      }

      /* ---------- CONTACT ---------- */
      .contact {
        background-color: var(--color-ink-deep);
        text-align: center;
        padding: 30px 6%;
      }

      .contact__title {
        font-family: var(--font-display);
        font-size: 36px;
        font-weight: 600;
        color: var(--color-white);
        margin-bottom: 12px;
        letter-spacing: -0.02em;
      }

      .contact__subtitle {
        font-size: 18px;
        color: var(--color-cream-muted);
        max-width: 500px;
        margin: 0 auto 40px;
        line-height: 1.5;
      }

      .contact__methods {
        display: flex;
        justify-content: center;
        gap: 60px;
        flex-wrap: wrap;
      }

      .contact-method {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--color-white);
        transition: transform var(--ease-out);
      }

      .contact-method:hover {
        transform: translateY(-4px);
      }

      .contact-method__icon {
        font-size: 28px;
        line-height: 1;
        color: var(--color-white);
        transition: color 0.2s;
      }

      .contact-method__label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: var(--color-cream-muted);
      }

      .contact-method__value {
        font-size: 16px;
        font-weight: 500;
        color: var(--color-white);
        border-bottom: 1px solid transparent;
        transition:
          border-color 0.2s,
          color 0.2s;
      }

      .contact-method:hover .contact-method__value {
        border-bottom-color: var(--color-white);
      }

      @media (max-width: 768px) {
        .contact__methods {
          flex-direction: column;
          gap: 36px;
          align-items: center;
        }

        .contact-method__value {
          font-size: 15px;
        }
      }

      /* ---------- FOOTER ---------- */
      .footer {
        background-color: var(--color-ink-deep);
        color: var(--color-cream-muted);
        text-align: center;
        padding: 20px 6%;
        font-size: 13px;
        letter-spacing: 0.5px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
      }

      .footer p {
        margin-bottom: 12px;
      }

      .footer__legal {
        font-size: 12px;
        line-height: 1.6;
        max-width: 800px;
        margin: 0 auto;
        color: #555555;
      }
    </style>
  </body>
</html>
